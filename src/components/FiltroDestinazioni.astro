---
interface Regione {
  nome: string
  slug: string
  figlie: { nome: string; slug: string }[]
}

interface Props {
  regioni: Regione[]
  regioneSlugAttuale: string
  destinazioneSlugAttuale: string | null
}

const { regioni, regioneSlugAttuale, destinazioneSlugAttuale } = Astro.props
const regioneAttuale = regioni.find(r => r.slug === regioneSlugAttuale) ?? null
---

<aside class="filtro-destinazioni" aria-label="Filtra per destinazione">
  <h2 class="filtro-destinazioni__titolo">Filtra per destinazione</h2>

  <label class="filtro-destinazioni__campo">
    <span>Regione</span>
    <select data-filtro-regione data-prefisso="/destinazioni/">
      {regioni.map(r => (
        <option value={r.slug} selected={r.slug === regioneSlugAttuale}>{r.nome}</option>
      ))}
    </select>
  </label>

  {regioneAttuale && (
    <label class="filtro-destinazioni__campo">
      <span>Destinazione</span>
      <select data-filtro-destinazione data-prefisso="/destinazioni/">
        <option value={regioneAttuale.slug} selected={!destinazioneSlugAttuale}>Tutte le strutture — {regioneAttuale.nome}</option>
        {regioneAttuale.figlie.map(f => (
          <option value={f.slug} selected={f.slug === destinazioneSlugAttuale}>{f.nome}</option>
        ))}
      </select>
    </label>
  )}
</aside>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-filtro-regione], [data-filtro-destinazione]').forEach(select => {
    select.addEventListener('change', () => {
      const prefisso = select.dataset.prefisso ?? '/destinazioni/'
      window.location.href = `${prefisso}${select.value}/`
    })
  })
</script>

<style>
  .filtro-destinazioni {
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .filtro-destinazioni__titolo {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--inchiostro);
    margin: 0;
  }

  .filtro-destinazioni__campo {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--inchiostro);
  }

  .filtro-destinazioni__campo select {
    cursor: pointer;
  }
</style>
