---
import { getAzienda, getDestinazioniPerCategoria, getTipologieStruttura } from '../lib/queries'
import { soloNumeri } from '../lib/formato'

const azienda = await getAzienda()
const telefono = azienda?.telefono ?? null
const numeroWhatsapp = azienda?.numero_whatsapp ?? null
const linkWhatsapp = numeroWhatsapp ? `https://wa.me/39${soloNumeri(numeroWhatsapp)}` : null
const linkTelefono = telefono ? `tel:+39${soloNumeri(telefono)}` : null
const numeroMostrato = (() => {
  const n = telefono ?? numeroWhatsapp
  if (!n) return null
  return String(n).trim().startsWith('+') ? String(n).trim() : `+39 ${String(n).trim()}`
})()
const tipologieStruttura = await getTipologieStruttura()
const categorieDestinazioni = await getDestinazioniPerCategoria()
---

<header class="testata-sito">
  <div class="contenitore testata-sito__interno">
    <a href="/" class="testata-sito__logo" aria-label="Hotellando, torna alla home">
      <img src="/brand/hotellando-logo.jpg" alt="Hotellando easy booking" width="196" height="75" />
    </a>

    <nav class="testata-sito__nav" aria-label="Principale">
      <a href="/">Home</a>

      <details class="menu-tendina">
        <summary>Strutture</summary>
        <div class="menu-tendina__pannello">
          <a href="/strutture/" class="menu-tendina__intestazione">Tutte le strutture</a>
          {tipologieStruttura.map(t => <a href={`/strutture/${t.slug}/`}>{t.nome}</a>)}
        </div>
      </details>

      <details class="menu-tendina">
        <summary>Destinazioni</summary>
        <div class="menu-tendina__pannello menu-tendina__pannello--colonne">
          <div class="menu-tendina__gruppo"><a href="/destinazioni/" class="menu-tendina__intestazione">Tutte le destinazioni</a></div>
          {categorieDestinazioni.map(cat => (
            <div class="menu-tendina__gruppo">
              <a href={`/categoria/${cat.slug}/`} class="menu-tendina__intestazione">{cat.nome}</a>
              {cat.destinazioni.map(d => <a href={`/destinazioni/${d.slug}/`}>{d.nome}</a>)}
            </div>
          ))}
        </div>
      </details>

      <a href="/offerte/">Offerte</a>
      <a href="/tour/">Tour</a>
    </nav>

    <div class="testata-sito__contatti">
      {(linkWhatsapp || linkTelefono) && (
        <div class="contatto-verde">
          {linkWhatsapp && (
            <a class="contatto-verde__icona" href={linkWhatsapp} target="_blank" rel="noopener" aria-label="Scrivici su WhatsApp">
              <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path fill="currentColor" d="M16.04 3C9.4 3 4 8.38 4 15.01c0 2.12.56 4.19 1.62 6.01L4 28l7.16-1.88a12.02 12.02 0 0 0 4.88 1.03h.01C22.7 27.15 28 21.77 28 15.14 28 8.5 22.68 3 16.04 3Zm0 21.98h-.01a9.99 9.99 0 0 1-5.1-1.4l-.37-.22-3.8 1 1.02-3.7-.24-.38a9.94 9.94 0 0 1-1.53-5.3c0-5.5 4.5-9.97 10.04-9.97 2.68 0 5.2 1.04 7.09 2.93a9.9 9.9 0 0 1 2.93 7.05c0 5.5-4.5 9.99-10.03 9.99Zm5.5-7.48c-.3-.15-1.78-.88-2.05-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.95 1.18-.18.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.67-2.08-.18-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.25-.58-.5-.5-.68-.51h-.58c-.2 0-.53.08-.8.38-.28.3-1.05 1.03-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.24 5.14 4.54.72.31 1.28.5 1.72.64.72.23 1.37.2 1.89.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35Z"/></svg>
            </a>
          )}
          {linkTelefono && (
            <a class="contatto-verde__icona" href={linkTelefono} aria-label="Chiama">
              <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
            </a>
          )}
          {numeroMostrato && <a class="contatto-verde__numero" href={linkTelefono ?? linkWhatsapp ?? '#'}>{numeroMostrato}</a>}
        </div>
      )}
    </div>

    <button type="button" class="testata-sito__hamburger" aria-expanded="false" aria-controls="menu-mobile" aria-label="Apri il menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="testata-sito__mobile" id="menu-mobile" hidden>
    <nav aria-label="Principale (mobile)">
      <a href="/">Home</a>

      <details>
        <summary>Strutture</summary>
        <div class="testata-sito__mobile-pannello">
          <a href="/strutture/" class="menu-tendina__intestazione">Tutte le strutture</a>
          {tipologieStruttura.map(t => <a href={`/strutture/${t.slug}/`}>{t.nome}</a>)}
        </div>
      </details>

      <details>
        <summary>Destinazioni</summary>
        <div class="testata-sito__mobile-pannello">
          <a href="/destinazioni/" class="menu-tendina__intestazione">Tutte le destinazioni</a>
          {categorieDestinazioni.map(cat => (
            <>
              <a href={`/categoria/${cat.slug}/`} class="menu-tendina__intestazione">{cat.nome}</a>
              {cat.destinazioni.map(d => <a href={`/destinazioni/${d.slug}/`}>{d.nome}</a>)}
            </>
          ))}
        </div>
      </details>

      <a href="/offerte/">Offerte</a>
      <a href="/tour/">Tour</a>
    </nav>
    {(linkWhatsapp || linkTelefono) && (
      <div class="contatto-verde">
        {linkWhatsapp && (
          <a class="contatto-verde__icona" href={linkWhatsapp} target="_blank" rel="noopener" aria-label="Scrivici su WhatsApp">
            <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path fill="currentColor" d="M16.04 3C9.4 3 4 8.38 4 15.01c0 2.12.56 4.19 1.62 6.01L4 28l7.16-1.88a12.02 12.02 0 0 0 4.88 1.03h.01C22.7 27.15 28 21.77 28 15.14 28 8.5 22.68 3 16.04 3Zm0 21.98h-.01a9.99 9.99 0 0 1-5.1-1.4l-.37-.22-3.8 1 1.02-3.7-.24-.38a9.94 9.94 0 0 1-1.53-5.3c0-5.5 4.5-9.97 10.04-9.97 2.68 0 5.2 1.04 7.09 2.93a9.9 9.9 0 0 1 2.93 7.05c0 5.5-4.5 9.99-10.03 9.99Zm5.5-7.48c-.3-.15-1.78-.88-2.05-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.95 1.18-.18.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.67-2.08-.18-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.25-.58-.5-.5-.68-.51h-.58c-.2 0-.53.08-.8.38-.28.3-1.05 1.03-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.24 5.14 4.54.72.31 1.28.5 1.72.64.72.23 1.37.2 1.89.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35Z"/></svg>
          </a>
        )}
        {linkTelefono && (
          <a class="contatto-verde__icona" href={linkTelefono} aria-label="Chiama">
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
          </a>
        )}
        {numeroMostrato && <a class="contatto-verde__numero" href={linkTelefono ?? linkWhatsapp ?? '#'}>{numeroMostrato}</a>}
      </div>
    )}
  </div>
</header>

<script>
  const bottone = document.querySelector('.testata-sito__hamburger')
  const menu = document.getElementById('menu-mobile')
  bottone?.addEventListener('click', () => {
    const aperto = bottone.getAttribute('aria-expanded') === 'true'
    bottone.setAttribute('aria-expanded', String(!aperto))
    bottone.classList.toggle('è-aperto', !aperto)
    if (menu) menu.hidden = aperto
  })

  // Chiude i menu a tendina aperti quando se ne apre un altro o si clicca fuori.
  const tendine = document.querySelectorAll<HTMLDetailsElement>('.menu-tendina')
  tendine.forEach(dettaglio => {
    dettaglio.addEventListener('toggle', () => {
      if (dettaglio.open) {
        tendine.forEach(altro => { if (altro !== dettaglio) altro.open = false })
      }
    })
  })
  document.addEventListener('click', evento => {
    tendine.forEach(dettaglio => {
      if (dettaglio.open && !dettaglio.contains(evento.target as Node)) dettaglio.open = false
    })
  })
</script>

<style>
  .testata-sito {
    background: var(--superficie);
    border-bottom: 1px solid var(--bordo);
  }

  .testata-sito__interno {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 1.35rem 1.5rem;
  }

  .testata-sito__logo img {
    height: 56px;
    width: auto;
  }

  .testata-sito__nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-right: auto;
  }

  .testata-sito__nav > a {
    color: var(--inchiostro);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
  }

  .testata-sito__nav > a:hover {
    color: var(--colore-primario-scuro);
  }

  .menu-tendina {
    position: relative;
  }

  .menu-tendina summary {
    color: var(--inchiostro);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    list-style: none;
  }

  .menu-tendina summary::-webkit-details-marker {
    display: none;
  }

  .menu-tendina summary::after {
    content: '▾';
    margin-left: 0.35em;
    font-size: 0.75em;
    color: var(--testo-tenue);
  }

  .menu-tendina[open] summary,
  .menu-tendina summary:hover {
    color: var(--colore-primario-scuro);
  }

  .menu-tendina__pannello {
    position: absolute;
    top: calc(100% + 0.9rem);
    left: 0;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    box-shadow: var(--ombra);
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 13rem;
    max-height: 24rem;
    overflow-y: auto;
    z-index: 20;
  }

  .menu-tendina__pannello--colonne {
    flex-direction: row;
    gap: 1.75rem;
    min-width: 32rem;
    max-height: none;
  }

  .menu-tendina__gruppo {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 9rem;
  }

  .menu-tendina__intestazione {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--inchiostro);
    font-weight: 700;
    padding: 0.4rem 0.6rem 0.2rem;
    text-decoration: none;
    border-radius: var(--raggio-piccolo);
  }

  a.menu-tendina__intestazione:hover {
    color: var(--colore-primario-scuro);
    background: var(--superficie-tenue);
  }

  .menu-tendina__pannello a,
  .testata-sito__mobile-pannello a {
    color: var(--testo);
    text-decoration: none;
    font-size: 0.92rem;
    padding: 0.4rem 0.6rem;
    border-radius: var(--raggio-piccolo);
  }

  .menu-tendina__pannello a:hover {
    background: var(--superficie-tenue);
    color: var(--colore-primario-scuro-hover);
  }

  /* contatto in alto a destra: icona WhatsApp, icona telefono e numero, in verde */
  .contatto-verde {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: #16a34a;
  }

  .contatto-verde__icona {
    display: inline-flex;
    color: #16a34a;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .contatto-verde__icona:hover {
    color: #128a3e;
    transform: translateY(-1px);
  }

  .contatto-verde__numero {
    color: #16a34a;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .contatto-verde__numero:hover {
    color: #128a3e;
  }

  .testata-sito__mobile .contatto-verde {
    justify-content: center;
    padding: 0.75rem 0;
  }

  .testata-sito__contatti {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .testata-sito__contatto {
    display: inline-flex;
    align-items: center;
    background: var(--colore-primario-scuro);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    padding: 0.7em 1.4em;
    border-radius: 999px;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .testata-sito__contatto:hover,
  .testata-sito__contatto:active {
    background: var(--accento-scuro);
    color: #fff;
    transform: translateY(-1px);
  }

  .testata-sito__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
  }

  .testata-sito__hamburger span {
    display: block;
    height: 2px;
    background: var(--inchiostro);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .testata-sito__hamburger.è-aperto span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .testata-sito__hamburger.è-aperto span:nth-child(2) {
    opacity: 0;
  }

  .testata-sito__hamburger.è-aperto span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .testata-sito__mobile {
    display: none;
    flex-direction: column;
    gap: 1rem;
    padding: 0 1.5rem 1.5rem;
    border-top: 1px solid var(--bordo);
    padding-top: 1.25rem;
  }

  .testata-sito__mobile[hidden] {
    display: none;
  }

  .testata-sito__mobile nav {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .testata-sito__mobile nav > a,
  .testata-sito__mobile summary {
    color: var(--inchiostro);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .testata-sito__mobile summary::-webkit-details-marker {
    display: none;
  }

  .testata-sito__mobile-pannello {
    display: flex;
    flex-direction: column;
    padding-top: 0.6rem;
    gap: 0.1rem;
  }

  .testata-sito__mobile .testata-sito__contatto {
    display: block;
  }

  @media (max-width: 760px) {
    .testata-sito__logo img {
      height: 44px;
    }

    .testata-sito__nav,
    .testata-sito__contatti {
      display: none;
    }

    .testata-sito__hamburger {
      display: flex;
    }

    .testata-sito__mobile:not([hidden]) {
      display: flex;
    }
  }
</style>
