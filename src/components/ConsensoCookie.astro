---
// Banner dei cookie e Pixel di Meta. Il Pixel si carica SOLO dopo "Accetta" (GDPR): senza consenso
// non parte nessuna chiamata verso Meta. La scelta resta salvata nel browser e si puo' cambiare dal piede del sito.
const ID_PIXEL = '1431343939188844'
// l'API Conversions (invio degli stessi eventi dal server) passa dalla funzione meta-capi del gestionale
const URL_CAPI = `${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/meta-capi`
const CHIAVE_CAPI = import.meta.env.PUBLIC_SUPABASE_ANON_KEY
---

<script is:inline define:vars={{ ID_PIXEL, URL_CAPI, CHIAVE_CAPI }}>
  ;(function () {
    var CHIAVE = 'hotellando-consenso'
    var coda = []
    var caricato = false

    function leggi() {
      try { return localStorage.getItem(CHIAVE) } catch (e) { return null }
    }
    function salva(v) {
      try { localStorage.setItem(CHIAVE, v) } catch (e) {}
    }

    function caricaPixel() {
      if (caricato) return
      caricato = true
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js')
      window.fbq('init', ID_PIXEL)
      var idVisita = nuovoId()
      window.fbq('track', 'PageView', {}, { eventID: idVisita })
      inviaAlServer('PageView', idVisita, undefined, undefined)
      var inCoda = coda
      coda = []
      inCoda.forEach(function (ev) { emetti(ev[0], ev[1], ev[2]) })
    }

    function nuovoId() {
      return Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10)
    }
    function cookie(nome) {
      var m = document.cookie.match(new RegExp('(?:^|; )' + nome + '=([^;]*)'))
      return m ? decodeURIComponent(m[1]) : ''
    }

    // lo stesso evento va anche al server (API Conversions), con lo stesso id: Meta lo conta una volta sola
    function inviaAlServer(nome, idEvento, dati, contatto) {
      try {
        fetch(URL_CAPI, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: CHIAVE_CAPI, Authorization: 'Bearer ' + CHIAVE_CAPI },
          body: JSON.stringify({
            evento: nome,
            eventId: idEvento,
            url: location.href.split('#')[0],
            userAgent: navigator.userAgent,
            fbp: cookie('_fbp'),
            fbc: cookie('_fbc'),
            dati: dati,
            contatto: contatto,
          }),
          keepalive: true,
        }).catch(function () {})
      } catch (e) {}
    }

    function emetti(nome, dati, contatto) {
      var idEvento = nuovoId()
      window.fbq('track', nome, dati || {}, { eventID: idEvento })
      inviaAlServer(nome, idEvento, dati, contatto)
    }

    // eventi (ViewContent, Lead): partono solo con il consenso, altrimenti si scartano.
    // "contatto" (solo per Lead): e-mail, telefono, nome; il server li cifra prima di mandarli a Meta
    window.tracciaEvento = function (nome, dati, contatto) {
      var scelta = leggi()
      if (scelta === 'si') {
        if (caricato) emetti(nome, dati, contatto)
        else coda.push([nome, dati, contatto])
      } else if (scelta === null) {
        coda.push([nome, dati, contatto])
      }
    }

    function chiudi(v) {
      salva(v)
      var b = document.getElementById('banner-cookie')
      if (b) b.hidden = true
      if (v === 'si') caricaPixel()
      else { coda = [] }
    }

    function mostra() {
      var b = document.getElementById('banner-cookie')
      if (b) b.hidden = false
    }

    document.addEventListener('DOMContentLoaded', function () {
      var scelta = leggi()
      if (scelta === 'si') caricaPixel()
      else if (scelta === null) mostra()
      var si = document.getElementById('cookie-accetta')
      var no = document.getElementById('cookie-rifiuta')
      if (si) si.addEventListener('click', function () { chiudi('si') })
      if (no) no.addEventListener('click', function () { chiudi('no') })
      document.querySelectorAll('[data-preferenze-cookie]').forEach(function (el) {
        el.addEventListener('click', function (e) { e.preventDefault(); mostra() })
      })
    })
  })()
</script>

<div id="banner-cookie" class="cookie" role="dialog" aria-label="Cookie e privacy" hidden>
  <p class="cookie__testo">
    Usiamo un cookie di Meta (Facebook e Instagram) per misurare le visite e mostrarti le nostre proposte di viaggio.
    Parte solo se accetti. <a href="/privacy/">Maggiori informazioni</a>
  </p>
  <div class="cookie__azioni">
    <button type="button" id="cookie-accetta" class="cookie__tasto cookie__tasto--si">Accetta</button>
    <button type="button" id="cookie-rifiuta" class="cookie__tasto">Rifiuta</button>
  </div>
</div>

<style>
  .cookie {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 1000;
    max-width: 30rem;
    padding: 1rem 1.1rem;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    box-shadow: var(--ombra);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--testo);
  }
  .cookie[hidden] {
    display: none;
  }
  .cookie__testo {
    margin: 0;
    line-height: 1.45;
  }
  .cookie__testo a {
    color: var(--accento-scuro);
    text-decoration: underline;
  }
  .cookie__azioni {
    display: flex;
    gap: 0.5rem;
  }
  .cookie__tasto {
    padding: 0.45em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--bordo);
    background: var(--superficie);
    color: var(--inchiostro);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .cookie__tasto--si {
    background: var(--accento-scuro);
    border-color: var(--accento-scuro);
    color: #fff;
  }
  @media (max-width: 40rem) {
    .cookie {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      max-width: none;
    }
  }
</style>
