---
// Selettore piatto delle destinazioni di una categoria (usato solo dalla
// pagina /categoria/<slug>/, che mostra l'intera sezione): a differenza di
// FiltroDestinazioni (pensato per la gerarchia regione -> localita' di una
// singola destinazione Mare Italia) qui non c'e' nulla di gia' selezionato,
// e' solo un salto rapido verso /destinazioni/<slug>/.
interface Props {
  destinazioni: { nome: string; slug: string }[]
}

const { destinazioni } = Astro.props
// Stesso ordine del menu (impostato in Destinazioni nel gestionale: Corto, Medio, Lungo Raggio), non alfabetico
const ordinate = destinazioni
---

<label class="selettore-destinazione">
  <span>Destinazione</span>
  <select data-selettore-destinazione-categoria>
    <option value="">Tutte le destinazioni</option>
    {ordinate.map(d => <option value={d.slug}>{d.nome}</option>)}
  </select>
</label>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-selettore-destinazione-categoria]').forEach(select => {
    select.addEventListener('change', () => {
      if (select.value) window.location.href = `/destinazioni/${select.value}/`
    })
  })
</script>

<style>
  .selettore-destinazione {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--inchiostro);
  }

  .selettore-destinazione select {
    cursor: pointer;
  }
</style>
