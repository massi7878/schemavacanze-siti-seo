---
import { euro } from '../../lib/offerte'
import ModuloRichiestaOfferta from '../ModuloRichiestaOfferta.astro'
import type { DatiPaginaTour } from '../../lib/tourPagina'

interface Props {
  d: DatiPaginaTour
}

const { d } = Astro.props
const { t, partenze, periodi, numeroWa } = d

// dati per il calendario (sono poche centinaia di righe: stanno nella pagina, niente richieste)
const datiCalendario = partenze.map(p => ({
  p: p.data_partenza,
  r: p.data_rientro,
  e: Number(p.prezzo_da),
  s: p.stato,
  sg: p.supplemento_singola != null ? Number(p.supplemento_singola) : null,
  tr: p.riduzione_tripla != null ? Number(p.riduzione_tripla) : null,
  bb: p.riduzione_bambino != null ? Number(p.riduzione_bambino) : null,
}))
const haBambini = partenze.some(p => p.riduzione_bambino != null)
// supplementi facoltativi che si possono aggiungere al preventivo
const extraScelta = t.tappe.flatMap(tp => (tp.escursioni ?? []).map(x => ({ n: x.nome, e: Number(x.prezzo), p: x.a_persona, g: tp.giorno_da })))
const primaData = partenze[0]?.data_partenza ?? null
---

<section class="partenze-tour" id="partenze">
  <h2>Scegli data e viaggiatori</h2>

  {periodi.length > 0 && (
    <details class="partenze-tour__periodi-box">
      <summary>
        <span>Periodi e prezzi ({periodi.length})</span>
        <span class="partenze-tour__periodi-da">da {euro(Math.min(...periodi.map(p => p.prezzo)))}</span>
      </summary>
      <ul class="partenze-tour__periodi">
        {periodi.map(p => (
          <li>
            <span>{p.descrizione}</span>
            <strong>{euro(p.prezzo)}</strong>
          </li>
        ))}
      </ul>
    </details>
  )}

  <div
    class="cal"
    data-partenze={JSON.stringify(datiCalendario)}
    data-iniziale={primaData}
    data-notti={t.notti}
    data-wa={numeroWa}
    data-tour={t.nome}
    data-extra={JSON.stringify(extraScelta)}
  >
    <div class="cal__date">
      <button type="button" class="cal__campo cal__campo--bottone" data-apri-cal aria-expanded="false" aria-controls="cal-popup">
        <span>Check-in</span>
        <strong data-txt-dal>Scegli la data</strong>
      </button>
      <div class="cal__campo">
        <span>Check-out</span>
        <strong data-txt-al>Automatico · {t.notti} {t.notti === 1 ? 'notte' : 'notti'}</strong>
      </div>
    </div>
    <div class="cal__popup" id="cal-popup" data-popup hidden>
      <div class="cal__testata">
        <button type="button" class="cal__nav" data-prec aria-label="Mese precedente">‹</button>
        <strong class="cal__mese" aria-live="polite"></strong>
        <button type="button" class="cal__nav" data-succ aria-label="Mese successivo">›</button>
      </div>
      <div class="cal__griglia" data-griglia></div>
    </div>
    <div class="cal__scelta" data-scelta aria-live="polite">Scegli la data di check-in: il check-out si calcola da solo.</div>
    <fieldset class="cal__ospiti">
      <legend>Viaggiatori e camere</legend>
      <div class="cal__ospiti-riga">
        <label>Adulti<input type="number" name="adulti" min="1" max="12" value="2" inputmode="numeric" /></label>
        {haBambini && <label>Bambini<input type="number" name="bambini" min="0" max="6" value="0" inputmode="numeric" /></label>}
        <label>Camere singole<input type="number" name="singole" min="0" max="12" value="0" inputmode="numeric" /></label>
        <label>Doppie / twin<input type="number" name="doppie" min="0" max="12" value="1" inputmode="numeric" /></label>
        <label>Triple<input type="number" name="triple" min="0" max="6" value="0" inputmode="numeric" /></label>
        <label>Quadruple<input type="number" name="quadruple" min="0" max="4" value="0" inputmode="numeric" /></label>
      </div>
      <p class="cal__ospiti-esito" data-ospiti-esito role="status"></p>
      {extraScelta.length > 0 && (
        <details class="cal__extra">
          <summary>Aggiungi supplementi facoltativi ({extraScelta.length})</summary>
          <ul>
            {extraScelta.map((x, i) => (
              <li>
                <label>
                  <input type="checkbox" name="extra" value={i} />
                  <span>Giorno {x.g} · {x.n}</span>
                  <b>{euro(x.e)} <small>{x.p ? 'a persona' : 'a gruppo'}</small></b>
                </label>
              </li>
            ))}
          </ul>
        </details>
      )}
    </fieldset>
    <button type="button" class="cal__richiedi" data-richiedi-tour disabled>Richiedi questo preventivo</button>
  </div>
</section>

<ModuloRichiestaOfferta tourId={t.id} titolo={t.nome} numeroWa={numeroWa || null} urlPagina={d.urlCanonica} />

<script>
  const MESI = ['Gennaio', 'Febbraio', 'Marzo', 'Aprile', 'Maggio', 'Giugno', 'Luglio', 'Agosto', 'Settembre', 'Ottobre', 'Novembre', 'Dicembre']
  const GIORNI = ['L', 'M', 'M', 'G', 'V', 'S', 'D']
  const box = document.querySelector<HTMLElement>('.cal')
  if (box) {
    type Partenza = { p: string; r: string; e: number; s: string; sg: number | null; tr: number | null; bb: number | null }
    const partenze: Partenza[] = JSON.parse(box.dataset.partenze ?? '[]')
    const perData = new Map(partenze.map(x => [x.p, x]))
    const griglia = box.querySelector<HTMLElement>('[data-griglia]')!
    const scelta = box.querySelector<HTMLElement>('[data-scelta]')!
    const popup = box.querySelector<HTMLElement>('[data-popup]')!
    const apriCal = box.querySelector<HTMLButtonElement>('[data-apri-cal]')!
    const txtDal = box.querySelector<HTMLElement>('[data-txt-dal]')!
    const txtAl = box.querySelector<HTMLElement>('[data-txt-al]')!
    const tastoRichiedi = box.querySelector<HTMLButtonElement>('[data-richiedi-tour]')!
    const breve = (iso: string) => {
      const [a, m, g] = iso.split('-').map(Number)
      return new Intl.DateTimeFormat('it-IT', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(a, m - 1, g)))
    }
    const apriChiudi = (apri: boolean) => {
      popup.hidden = !apri
      apriCal.setAttribute('aria-expanded', String(apri))
    }
    apriCal.addEventListener('click', () => apriChiudi(popup.hidden))
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') apriChiudi(false)
    })
    const titoloMese = box.querySelector<HTMLElement>('.cal__mese')!
    const euro = (n: number) => new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n)
    const lunga = (iso: string) => {
      const [a, m, g] = iso.split('-').map(Number)
      return new Intl.DateTimeFormat('it-IT', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(a, m - 1, g)))
    }
    const due = (n: number) => String(n).padStart(2, '0')
    const iniziale = box.dataset.iniziale || new Date().toISOString().slice(0, 10)
    let [anno, mese] = iniziale.split('-').map(Number)
    const primo = partenze[0]?.p ?? iniziale
    const ultimo = partenze[partenze.length - 1]?.p ?? iniziale
    let selezionata: string | null = null
    let ultimaRichiesta: { dal: string; al: string; adulti: number; bambini: number; riepilogo: string } | null = null

    function disegna() {
      titoloMese.textContent = `${MESI[mese - 1]} ${anno}`
      const giorniMese = new Date(anno, mese, 0).getDate()
      // lunedi' = 0
      const offset = (new Date(anno, mese - 1, 1).getDay() + 6) % 7
      let html = GIORNI.map(g => `<span class="cal__giorno-nome">${g}</span>`).join('')
      html += '<span></span>'.repeat(offset)
      for (let g = 1; g <= giorniMese; g++) {
        const iso = `${anno}-${due(mese)}-${due(g)}`
        const x = perData.get(iso)
        if (x) {
          html += `<button type="button" class="cal__giorno cal__giorno--si${iso === selezionata ? ' cal__giorno--scelto' : ''}" data-data="${iso}" aria-label="${lunga(iso)}, ${euro(x.e)}"><span>${g}</span><small>${euro(x.e)}</small></button>`
        } else {
          html += `<span class="cal__giorno cal__giorno--no"><span>${g}</span></span>`
        }
      }
      griglia.innerHTML = html
      const prec = box!.querySelector<HTMLButtonElement>('[data-prec]')!
      const succ = box!.querySelector<HTMLButtonElement>('[data-succ]')!
      prec.disabled = `${anno}-${due(mese)}` <= primo.slice(0, 7)
      succ.disabled = `${anno}-${due(mese)}` >= ultimo.slice(0, 7)
    }

    // ---- adulti, bambini e camere (stesse regole di Travelexchange) ----
    const campo = (nome: string) => Number((box!.querySelector<HTMLInputElement>(`[name="${nome}"]`)?.value ?? '0') || 0)
    const imposta = (nome: string, v: number) => {
      const el = box!.querySelector<HTMLInputElement>(`[name="${nome}"]`)
      if (el) el.value = String(Math.max(0, v))
    }
    const ospitiEsito = box.querySelector<HTMLElement>('[data-ospiti-esito]')!
    const ospiti = () => ({
      adulti: campo('adulti'),
      bambini: campo('bambini'),
      singole: campo('singole'),
      doppie: campo('doppie'),
      triple: campo('triple'),
      quadruple: campo('quadruple'),
    })
    const viaggiatori = () => ospiti().adulti + ospiti().bambini
    const posti = () => ospiti().singole + ospiti().doppie * 2 + ospiti().triple * 3 + ospiti().quadruple * 4

    // propone le camere in base ai viaggiatori: tutte doppie, con una singola se sono dispari
    function proponiCamere() {
      const n = viaggiatori()
      imposta('triple', 0)
      imposta('quadruple', 0)
      imposta('singole', n % 2)
      imposta('doppie', Math.floor(n / 2))
    }

    function descriviOspiti() {
      const o = ospiti()
      const parti = [`${o.adulti} ${o.adulti === 1 ? 'adulto' : 'adulti'}`]
      if (o.bambini) parti.push(`${o.bambini} ${o.bambini === 1 ? 'bambino' : 'bambini'}`)
      const camere: string[] = []
      if (o.singole) camere.push(`${o.singole} singol${o.singole === 1 ? 'a' : 'e'}`)
      if (o.doppie) camere.push(`${o.doppie} doppi${o.doppie === 1 ? 'a' : 'e'}/twin`)
      if (o.triple) camere.push(`${o.triple} tripl${o.triple === 1 ? 'a' : 'e'}`)
      if (o.quadruple) camere.push(`${o.quadruple} quadrupl${o.quadruple === 1 ? 'a' : 'e'}`)
      return `${parti.join(' e ')} in ${camere.join(' + ') || 'nessuna camera'}`
    }

    // totale: viaggiatori x prezzo a persona + singole x supplemento - riduzioni delle triple
    const extraLista: Array<{ n: string; e: number; p: boolean; g: number }> = JSON.parse(box.dataset.extra ?? '[]')
    const extraScelti = () => [...box!.querySelectorAll<HTMLInputElement>('input[name="extra"]:checked')].map(i => extraLista[Number(i.value)]).filter(Boolean)
    function calcolo(x: Partenza) {
      const o = ospiti()
      const n = viaggiatori()
      const righe: Array<[string, number]> = [[`${n} ${n === 1 ? 'viaggiatore' : 'viaggiatori'} × ${euro(x.e)}`, n * x.e]]
      if (o.singole > 0 && x.sg != null) righe.push([`${o.singole} ${o.singole === 1 ? 'camera singola' : 'camere singole'} (supplemento ${euro(x.sg)})`, o.singole * x.sg])
      if (o.triple > 0) {
        // un bambino in una tripla usa la riduzione bambino al posto di quella normale
        const triple = o.triple
        const conBambino = Math.min(o.bambini, triple)
        let riduzione = 0
        if (x.bb != null) riduzione += conBambino * x.bb
        else if (x.tr != null) riduzione += conBambino * 3 * x.tr
        if (x.tr != null) riduzione += (triple - conBambino) * 3 * x.tr
        if (riduzione > 0) righe.push([`${triple} ${triple === 1 ? 'camera tripla' : 'camere triple'} (riduzione)`, -riduzione])
      }
      for (const xs of extraScelti()) {
        const quanti = xs.p ? n : 1
        righe.push([`${xs.n}${xs.p ? ` (${quanti} × ${euro(xs.e)})` : ' (a gruppo)'}`, xs.e * quanti])
      }
      return { righe, totale: righe.reduce((s, r) => s + r[1], 0) }
    }

    function verificaCamere() {
      const mancanti = viaggiatori() - posti()
      if (viaggiatori() < 1) {
        ospitiEsito.textContent = 'Indica almeno un adulto.'
        return false
      }
      if (mancanti > 0) {
        ospitiEsito.textContent = `Mancano ${mancanti} posti letto: aggiungi camere o riduci i viaggiatori.`
        return false
      }
      if (mancanti < 0) {
        ospitiEsito.textContent = `Ci sono ${-mancanti} posti letto in più dei viaggiatori: togli una camera.`
        return false
      }
      ospitiEsito.textContent = 'Camere a posto ✓'
      return true
    }

    function mostra(iso: string) {
      const x = perData.get(iso)
      if (!x) return
      selezionata = iso
      const nottiN = Math.round((Date.parse(x.r) - Date.parse(x.p)) / 86400000)
      const valide = verificaCamere()
      const c = calcolo(x)
      // dati per il modulo di richiesta: date, persone e totale indicativo
      const o = ospiti()
      ultimaRichiesta = {
        dal: x.p,
        al: x.r,
        adulti: Math.max(o.adulti, 1),
        bambini: o.bambini,
        riepilogo: `Partenza: ${lunga(x.p)}\nRientro: ${lunga(x.r)} (${nottiN} ${nottiN === 1 ? 'notte' : 'notti'})\nCamere: ${descriviOspiti()}\nTotale indicativo: ${euro(c.totale)}`,
      }
      const stato = x.s === 'ultimi_posti' ? '<span class="cal__badge">Ultimi posti</span>' : ''
      const dettaglio = c.righe.map(r => `<li><span>${r[0]}</span><b>${r[1] < 0 ? '−' + euro(-r[1]) : euro(r[1])}</b></li>`).join('')
      txtDal.textContent = breve(x.p)
      txtAl.textContent = `${breve(x.r)} · ${nottiN} ${nottiN === 1 ? 'notte' : 'notti'}`
      tastoRichiedi.disabled = false
      scelta.innerHTML = `<div class="cal__riepilogo">
        <div class="cal__conto">
          <span>Il tuo preventivo · ${descriviOspiti()}</span>
          <ul>${dettaglio}</ul>
          <p class="cal__totale">Totale <strong>${euro(c.totale)}</strong></p>
          ${stato}
          ${valide ? '' : '<p class="cal__avviso">Completa le camere per avere il totale corretto.</p>'}
        </div>
      </div>`
      apriChiudi(false)
      disegna()
    }

    tastoRichiedi.addEventListener('click', () => {
      if (ultimaRichiesta) document.dispatchEvent(new CustomEvent('apri-richiesta-tour', { detail: ultimaRichiesta }))
    })

    // cambiando i viaggiatori si propongono di nuovo le camere; cambiando le camere si ricalcola il totale
    box.querySelector('.cal__ospiti')?.addEventListener('change', e => {
      if ((e.target as HTMLInputElement).name === 'extra' && selezionata) mostra(selezionata)
    })
    box.querySelector('.cal__ospiti')?.addEventListener('input', e => {
      const nome = (e.target as HTMLInputElement).name
      if (nome === 'adulti' || nome === 'bambini') proponiCamere()
      verificaCamere()
      if (selezionata) mostra(selezionata)
    })
    proponiCamere()
    verificaCamere()

    box.addEventListener('click', e => {
      const t = e.target as HTMLElement
      const giorno = t.closest<HTMLElement>('[data-data]')
      if (giorno?.dataset.data) return mostra(giorno.dataset.data)
      if (t.closest('[data-prec]')) {
        mese--
        if (mese < 1) {
          mese = 12
          anno--
        }
        disegna()
      }
      if (t.closest('[data-succ]')) {
        mese++
        if (mese > 12) {
          mese = 1
          anno++
        }
        disegna()
      }
    })

    // si parte dal mese della prima partenza disponibile
    ;[anno, mese] = primo.split('-').map(Number)
    disegna()
  }
</script>

<style is:global>
  .partenze-tour {
    margin: 0 0 2rem;
  }

  .partenze-tour h2 {
    font-size: 1.05rem;
    margin: 0 0 0.6rem;
  }

  .partenze-tour__nota {
    margin: 0 0 1rem;
    color: var(--testo-tenue);
    line-height: 1.5;
  }

  .partenze-tour__periodi-box {
    margin: 0 0 1.25rem;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio-piccolo);
  }

  .partenze-tour__periodi-box > summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    padding: 0.7rem 1rem;
    cursor: pointer;
    font-weight: 700;
    color: var(--inchiostro);
    list-style: none;
  }

  .partenze-tour__periodi-box > summary::-webkit-details-marker {
    display: none;
  }

  .partenze-tour__periodi-box > summary::before {
    content: '▸';
    color: var(--colore-primario-scuro);
    transition: transform 0.15s ease;
  }

  .partenze-tour__periodi-box[open] > summary::before {
    transform: rotate(90deg);
  }

  .partenze-tour__periodi-da {
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--colore-primario-scuro);
  }

  .partenze-tour__periodi {
    list-style: none;
    margin: 0;
    padding: 0 1rem 0.8rem;
    display: grid;
    gap: 0.4rem;
  }

  .partenze-tour__periodi li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.65rem 1rem;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio-piccolo);
    color: var(--testo);
  }

  .partenze-tour__periodi strong {
    color: var(--colore-primario-scuro);
  }

  .cal {
    display: grid;
    gap: 0.7rem;
    max-width: 34rem;
  }

  /* check-in (si clicca e si apre il calendario) e check-out (si compila da solo), affiancati */
  .cal__date {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .cal__campo {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
    font: inherit;
    padding: 0.35rem 0.55rem;
    background: var(--superficie-tenue);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio-piccolo);
    color: var(--inchiostro);
    min-width: 0;
  }

  .cal__campo span {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--testo-tenue);
  }

  .cal__campo strong {
    font-size: 0.78rem;
    line-height: 1.25;
    text-transform: capitalize;
  }

  .cal__campo--bottone {
    background: var(--superficie);
    border: 2px solid var(--colore-primario-scuro);
    cursor: pointer;
  }

  .cal__campo--bottone strong {
    color: var(--colore-primario-scuro);
  }

  .cal__popup {
    padding: 0.6rem;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio-piccolo);
  }

  .cal__popup[hidden] {
    display: none;
  }

  .cal__testata {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .cal__mese {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--inchiostro);
  }

  .cal__nav {
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--bordo);
    border-radius: 50%;
    background: var(--superficie);
    color: var(--colore-primario-scuro);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }

  .cal__nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .cal__griglia {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .cal__giorno-nome {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--testo-tenue);
    padding-bottom: 0.2rem;
  }

  .cal__giorno {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 2.3rem;
    border-radius: var(--raggio-piccolo);
    font: inherit;
    font-size: 0.78rem;
    border: 1px solid transparent;
    padding: 0.15rem;
  }

  .cal__giorno small {
    font-size: 0.62rem;
    line-height: 1.1;
    color: var(--colore-primario-scuro);
    font-weight: 700;
  }

  .cal__giorno--no {
    color: var(--testo-tenue);
    opacity: 0.45;
  }

  .cal__giorno--si {
    background: var(--superficie-tenue);
    border-color: var(--bordo);
    color: var(--inchiostro);
    font-weight: 700;
    cursor: pointer;
  }

  .cal__giorno--si:hover {
    border-color: var(--colore-primario-scuro);
  }

  .cal__giorno--scelto {
    background: var(--colore-primario-scuro);
    border-color: var(--colore-primario-scuro);
    color: #fff;
  }

  .cal__giorno--scelto small {
    color: #fff;
  }

  .cal__scelta {
    color: var(--testo-tenue);
    font-size: 0.85rem;
  }

  .cal__riepilogo {
    display: grid;
    gap: 0.6rem;
    color: var(--testo);
  }

  .cal__riepilogo > div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
