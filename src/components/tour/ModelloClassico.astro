---
import BarraCondividi from '../BarraCondividi.astro'
import CalendarioPartenze from './CalendarioPartenze.astro'
import SupplementiFacoltativi from './SupplementiFacoltativi.astro'
import MiniatureGalleria from './MiniatureGalleria.astro'
import { euro } from '../../lib/offerte'
import { PASTI, etichettaGiorni, type DatiPaginaTour } from '../../lib/tourPagina'

interface Props {
  d: DatiPaginaTour
}

const { d } = Astro.props
const { t, immagini, partenze, prezzoMin, incluso, nonIncluso, paesi, cancellazione, linkTel, telefono } = d
---

<section class="apertura">
  <div class="contenitore">
    <nav class="briciole" aria-label="Percorso">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/tour/">Tour</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{t.nome}</span>
    </nav>
    <h1>{t.nome}</h1>
    {t.sottotitolo && <p class="sottotitolo">{t.sottotitolo}</p>}
    <ul class="pillole">
      {paesi.map(p => <li>{p}</li>)}
      <li>{t.notti} {t.notti === 1 ? 'notte' : 'notti'} · {t.durata_giorni} giorni</li>
      <li>{t.tipo_viaggio === 'self' ? 'Self made: viaggio libero, senza guida' : 'Viaggio guidato'}</li>
      {t.guida_italiano === 'si' ? <li>Guida in italiano</li> : t.guida_italiano === 'su_richiesta' ? <li>Guida in italiano su richiesta (o in altre lingue)</li> : t.lingue?.length > 0 && <li>Assistenza in italiano</li>}
      {t.partenza_da && t.arrivo_a && <li>{t.partenza_da} → {t.arrivo_a}</li>}
      {t.gruppo_max && <li>Max {t.gruppo_max} persone</li>}
    </ul>
  </div>
</section>

<main class="contenitore pagina-tour">
  <div class="colonne">
    <div class="colonna-principale">
      {immagini.length > 0 && <img class="galleria__grande" data-foto-principale src={immagini[0]} alt={t.nome} />}
      <MiniatureGalleria immagini={immagini} nome={t.nome} />

      <BarraCondividi url={d.urlCanonica} titolo={t.nome} testo={d.testoCondivisione} slug={t.slug} immagine={d.copertina} />

      {t.introduzione && (
        <section class="blocco">
          <h2>Il viaggio</h2>
          {t.introduzione.split(/\n{2,}/).map(par => <p>{par}</p>)}
        </section>
      )}

      {t.highlights?.length > 0 && (
        <section class="blocco">
          <h2>Da non perdere</h2>
          <ul class="elenco-check elenco-check--fila">
            {t.highlights.map(h => <li>{h}</li>)}
          </ul>
        </section>
      )}

      <SupplementiFacoltativi d={d} />

      {t.tappe.length > 0 && (
        <section class="blocco">
          <h2>Programma giorno per giorno</h2>
          <ol class="programma">
            {t.tappe.map(tp => (
              <li class="giorno">
                <details open={tp.giorno_da === 1}>
                  <summary>
                    <span class="giorno__quando">{etichettaGiorni(tp.giorno_da, tp.giorno_a)}</span>
                    <span class="giorno__nome">{tp.nome}{tp.sottonome ? ` · ${tp.sottonome}` : ''}</span>
                  </summary>
                  <div class="giorno__corpo">
                    {tp.foto_url && <img class="giorno__foto" src={tp.foto_url} alt={tp.nome} loading="lazy" />}
                    {tp.descrizione && tp.descrizione.split(/\n{2,}/).map(par => <p>{par}</p>)}
                    {tp.hotel && <p class="giorno__hotel"><strong>Pernottamento:</strong> {tp.hotel}</p>}
                    {tp.pasti?.length > 0 && <p class="giorno__hotel"><strong>Pasti inclusi:</strong> {tp.pasti.map(p => PASTI[p] ?? p).join(', ')}</p>}
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </section>
      )}

      {(incluso.length > 0 || nonIncluso.length > 0) && (
        <section class="blocco due-liste">
          {incluso.length > 0 && (
            <div>
              <h2>Cosa è incluso</h2>
              <ul class="elenco-check">{incluso.map(r => <li>{r}</li>)}</ul>
            </div>
          )}
          {nonIncluso.length > 0 && (
            <div>
              <h2>Cosa non è incluso</h2>
              <ul class="elenco-croce">{nonIncluso.map(r => <li>{r}</li>)}</ul>
            </div>
          )}
        </section>
      )}

      {cancellazione.length > 0 && (
        <section class="blocco">
          <h2>Condizioni di cancellazione</h2>
          <ul class="elenco-semplice">
            {cancellazione.map(c => (
              <li>
                Da {c.da_giorni} a {c.a_giorni} giorni prima della partenza: <strong>penale del {c.percentuale}%</strong>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <aside class="colonna-lato">
      <div class="riquadro">
        {prezzoMin != null && (
          <p class="riquadro__prezzo">
            da <strong>{euro(prezzoMin)}</strong> <span>a persona in camera doppia</span>
          </p>
        )}
        {partenze.length > 0 && <CalendarioPartenze d={d} />}
        <p class="riquadro__nota">Il prezzo cambia con la data di partenza. Scrivici: ti confermiamo disponibilità e quota esatta, senza impegno.</p>
        <div class="riquadro__azioni">
          {d.numeroWa && <button type="button" class="pulsante pulsante--secondario" data-apri-richiesta-tour>Scrivici su WhatsApp</button>}
          {linkTel && <a class="pulsante pulsante--secondario" href={linkTel}>Chiama {telefono}</a>}
        </div>
      </div>
    </aside>
  </div>
</main>

<style>
  .apertura {
    padding: 1.25rem 0 1rem;
  }

  .briciole {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--testo-tenue);
    margin-bottom: 1.25rem;
  }

  .briciole a {
    color: var(--testo-tenue);
    text-decoration: none;
  }

  .briciole a:hover {
    color: var(--colore-primario-scuro);
  }

  h1 {
    font-size: clamp(1.8rem, 1.4rem + 1.8vw, 2.8rem);
    margin: 0 0 0.4rem;
  }

  .sottotitolo {
    margin: 0 0 0.9rem;
    color: var(--testo-tenue);
  }

  .pillole {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pillole li {
    border: 1px solid var(--bordo);
    background: var(--superficie);
    border-radius: 999px;
    padding: 0.3em 0.9em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--testo);
  }

  /* solo margine sopra/sotto: i lati li da' .contenitore (altrimenti il contenuto resta attaccato al bordo) */
  .pagina-tour {
    padding-block: 0.5rem 4rem;
  }

  .colonne {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(14.5rem, 26vw, 19rem);
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: start;
  }

  @media (max-width: 700px) {
    .colonne {
      grid-template-columns: minmax(0, 1fr);
    }

    .colonna-lato {
      order: -1;
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  .galleria {
    display: grid;
    gap: 0.5rem;
  }

  .galleria__grande {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--raggio);
  }

  .galleria__miniature {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.5rem;
  }

  .galleria__miniature img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--raggio-piccolo);
  }

  .blocco {
    margin: 0 0 1.4rem;
  }

  .blocco h2 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }

  .blocco p {
    line-height: 1.55;
    color: var(--testo);
  }

  .elenco-check,
  .elenco-croce,
  .elenco-semplice {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  .elenco-check li,
  .elenco-croce li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--testo);
    line-height: 1.5;
  }

  /* "Da non perdere": voci una di seguito all'altra con la spunta, piu' compatte */
  .elenco-check--fila {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
  }

  .elenco-check--fila li {
    padding-left: 1.15rem;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .elenco-check li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--colore-primario-scuro);
    font-weight: 700;
  }

  .elenco-croce li::before {
    content: '✕';
    position: absolute;
    left: 0;
    color: #b0413e;
    font-weight: 700;
  }

  .elenco-semplice li {
    color: var(--testo);
  }

  .due-liste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2rem;
  }

  .programma {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .giorno {
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    background: var(--superficie);
    overflow: hidden;
  }

  .giorno summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding: 0.85rem 1.1rem;
    cursor: pointer;
    list-style: none;
  }

  .giorno summary::-webkit-details-marker {
    display: none;
  }

  .giorno__quando {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--colore-primario-scuro);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .giorno__nome {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--inchiostro);
  }

  .giorno__corpo {
    padding: 0 1.1rem 1.1rem;
  }

  .giorno__foto {
    width: 100%;
    max-height: 22rem;
    object-fit: cover;
    border-radius: var(--raggio-piccolo);
    margin-bottom: 0.75rem;
  }

  .giorno__hotel {
    font-size: 0.92rem;
    margin: 0.4rem 0 0;
  }

  .colonna-lato {
    position: sticky;
    top: 1rem;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }

  /* il calendario sta dentro il riquadro: niente cornice propria */
  :global(.colonna-lato .cal) {
    max-width: none;
  }

  :global(.colonna-lato .partenze-tour) {
    margin: 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--bordo-tenue);
  }

  .riquadro {
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    box-shadow: var(--ombra);
    padding: 0.8rem;
    display: grid;
    gap: 0.5rem;
  }

  .riquadro__prezzo {
    margin: 0;
    color: var(--testo);
  }

  .riquadro__prezzo strong {
    font-size: 1.9rem;
    color: var(--colore-primario-scuro);
  }

  .riquadro__prezzo span {
    display: block;
    font-size: 0.82rem;
    color: var(--testo-tenue);
  }

  .riquadro__nota {
    margin: 0;
    font-size: 0.88rem;
    color: var(--testo-tenue);
  }

  .riquadro__azioni {
    display: grid;
    gap: 0.5rem;
  }

  .pulsante {
    display: block;
    text-align: center;
    text-decoration: none;
    font-weight: 700;
    padding: 0.8em 1.2em;
    border-radius: 999px;
    background: var(--colore-primario-scuro);
    color: #fff;
  }

  .pulsante:hover {
    background: var(--colore-primario-scuro-hover);
  }

  .pulsante--secondario {
    background: var(--superficie);
    color: var(--colore-primario-scuro);
    border: 2px solid var(--colore-primario-scuro);
  }

  .pulsante--secondario:hover {
    background: var(--superficie-tenue);
  }
</style>
