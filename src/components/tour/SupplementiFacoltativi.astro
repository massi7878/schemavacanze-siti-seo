---
import { euro } from '../../lib/offerte'
import { etichettaGiorni, type DatiPaginaTour } from '../../lib/tourPagina'

interface Props {
  d: DatiPaginaTour
}

const { d } = Astro.props
// tutti i supplementi facoltativi del tour, con il giorno a cui appartengono
const extra = d.t.tappe.flatMap(tp =>
  (tp.escursioni ?? []).map(e => ({ ...e, quando: etichettaGiorni(tp.giorno_da, tp.giorno_a), luogo: tp.nome }))
)
---

{extra.length > 0 && (
  <section class="extra-tour" id="extra">
    <h2>Supplementi facoltativi</h2>
    <p class="extra-tour__nota">
      Servizi e visite che puoi aggiungere al viaggio. Il prezzo è indicativo e lo confermiamo nel preventivo. Con "Aggiungi al preventivo" li inserisci nel totale del pacchetto base: sono indicati a persona o a gruppo.
    </p>
    <ul class="extra-tour__lista">
      {extra.map((e, i) => (
        <li>
          <div class="extra-tour__testa">
            <strong>{e.nome}</strong>
            <span class="extra-tour__prezzo">{euro(Number(e.prezzo))} <small>{e.a_persona ? 'a persona' : 'a gruppo'}</small></span>
          </div>
          <span class="extra-tour__quando">{e.quando} · {e.luogo}{e.durata ? ` · ${e.durata}` : ''}</span>
          {e.descrizione && <p>{e.descrizione}</p>}
          <button type="button" class="extra-tour__aggiungi" data-aggiungi-extra={i} aria-pressed="false">+ Aggiungi al preventivo</button>
        </li>
      ))}
    </ul>
  </section>
)}

<script>
  // i pulsanti della scheda spuntano lo stesso supplemento nel riquadro del preventivo e viceversa
  const casella = (i: string) => document.querySelector<HTMLInputElement>(`input[name="extra"][value="${i}"]`)
  function allinea() {
    document.querySelectorAll<HTMLButtonElement>('[data-aggiungi-extra]').forEach(b => {
      const c = casella(b.dataset.aggiungiExtra ?? '')
      const on = !!c?.checked
      b.setAttribute('aria-pressed', String(on))
      b.textContent = on ? '✓ Aggiunto · togli' : '+ Aggiungi al preventivo'
      b.classList.toggle('extra-tour__aggiungi--attivo', on)
    })
  }
  document.querySelectorAll<HTMLButtonElement>('[data-aggiungi-extra]').forEach(b =>
    b.addEventListener('click', () => {
      const c = casella(b.dataset.aggiungiExtra ?? '')
      if (!c) return
      c.checked = !c.checked
      c.dispatchEvent(new Event('change', { bubbles: true }))
    })
  )
  document.addEventListener('change', e => {
    if ((e.target as HTMLInputElement)?.name === 'extra') allinea()
  })
  allinea()
</script>

<style is:global>
  .extra-tour__aggiungi {
    align-self: flex-start;
    margin-top: 0.3rem;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.3em 0.9em;
    border-radius: 999px;
    border: 1.5px solid var(--colore-primario-scuro);
    background: var(--superficie);
    color: var(--colore-primario-scuro);
    cursor: pointer;
  }

  .extra-tour__aggiungi--attivo {
    background: var(--colore-primario-scuro);
    color: #fff;
  }

  .extra-tour {
    margin: 0 0 1.5rem;
  }

  .extra-tour h2 {
    font-size: 1.25rem;
    margin: 0 0 0.4rem;
  }

  .extra-tour__nota {
    margin: 0 0 0.8rem;
    color: var(--testo-tenue);
    font-size: 0.9rem;
  }

  .extra-tour__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 0.6rem;
  }

  .extra-tour__lista li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.8rem 1rem;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio-piccolo);
  }

  .extra-tour__testa {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--inchiostro);
  }

  .extra-tour__prezzo {
    flex: 0 0 auto;
    font-weight: 800;
    color: var(--colore-primario-scuro);
  }

  .extra-tour__prezzo small {
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--testo-tenue);
  }

  .extra-tour__quando {
    font-size: 0.78rem;
    color: var(--testo-tenue);
  }

  .extra-tour__lista p {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--testo);
  }
</style>
