---
import CardTour from '../CardTour.astro'
import CopertinaSezione from '../CopertinaSezione.astro'
import { getSlideshow } from '../../lib/queries'
import { getToursPubblici, paesiDi, periodiProposti } from '../../lib/tour'

// Elenco dei tour con i filtri. soloGuida = sezione "Tour con guida in italiano" (la guida e' sempre attiva).
interface Props {
  soloGuida?: boolean
}
const { soloGuida = false } = Astro.props

const tour = await getToursPubblici(soloGuida)
const slide = await getSlideshow('tour')
const paesi = [...new Set(tour.flatMap(t => paesiDi(t.paese)))].sort((a, b) => a.localeCompare(b, 'it'))
const nottiMax = tour.length ? Math.max(...tour.map(t => t.notti)) : 0
const nottiMin = tour.length ? Math.min(...tour.map(t => t.notti)) : 0
const prezzoMax = Math.ceil(Math.max(0, ...tour.map(t => Number(t.prezzo_min ?? 0))) / 100) * 100
const periodi = periodiProposti()
const INIZIALI = 48

const urlSupabase = import.meta.env.PUBLIC_SUPABASE_URL
const chiaveAnon = import.meta.env.PUBLIC_SUPABASE_ANON_KEY
---
  <CopertinaSezione slide={slide} titolo={soloGuida ? 'Tour con guida in italiano' : 'Tour nel mondo'} sottotitolo={tour.length > 0 ? (soloGuida ? `${tour.length} tour con guida o assistenza in italiano, date di partenza e prezzi reali.` : `${tour.length} tour con assistenza in italiano, date di partenza e prezzi reali.`) : 'Nessun tour disponibile al momento: torna a trovarci presto.'}>
    <nav slot="alto" class="briciole" aria-label="Percorso">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Tour</span>
    </nav>
      {tour.length > 0 && (
        <form class="filtri" id="filtri-tour" aria-label="Filtra i tour">
          <div class="filtri__riga filtri__riga--principale">
            <label>
              Nazione
              <select name="paese">
                <option value="">Tutte</option>
                {paesi.map(p => <option value={p}>{p}</option>)}
              </select>
            </label>
            <label>
              Periodo di partenza
              <select name="periodo">
                <option value="">Qualsiasi</option>
                {periodi.map(p => <option value={p.valore} data-dal={p.dal} data-al={p.al}>{p.etichetta}</option>)}
              </select>
            </label>
            <label>
              Tipo di viaggio
              <select name="tipo">
                <option value="">Tutti</option>
                <option value="guidato">Guidato (con guida)</option>
                <option value="self">Self made (viaggio libero)</option>
              </select>
            </label>
            <label class="filtri__ricerca">
              Cerca per testo
              <span class="filtri__ricercariga">
                <input type="search" name="testo" placeholder="Destinazione o nome del tour..." autocomplete="off" />
                <button type="submit" class="filtri__cerca">Cerca</button>
              </span>
            </label>
          </div>
  
          <details class="filtri__altri">
            <summary>Altri filtri: date, prezzo, durata, ordine</summary>
            <div class="filtri__riga">
              <label>
                Partenza dal
                <input type="date" name="dal" />
              </label>
              <label>
                al
                <input type="date" name="al" />
              </label>
              {!soloGuida && (
                <label class="filtri__spunta">
                  <input type="checkbox" name="guida" value="1" />
                  Solo con guida in italiano
                </label>
              )}
              <label>
                Prezzo massimo (€)
                <input type="number" name="prezzo" min="0" step="50" inputmode="numeric" placeholder={prezzoMax ? `fino a ${prezzoMax}` : ''} />
              </label>
              <label>
                Ordina per
                <select name="ordine">
                  <option value="data">Prima partenza</option>
                  <option value="prezzo">Prezzo</option>
                  <option value="durata">Durata</option>
                  <option value="recenti">Più recenti</option>
                </select>
              </label>
            </div>
  
            <div class="durata">
              <strong id="durata-testo" class="durata__testo">Durata: qualsiasi</strong>
              <div class="range-doppio">
                <div class="range-doppio__traccia"></div>
                <div class="range-doppio__selezione" id="durata-selezione"></div>
                <input type="range" name="notti_min" min={nottiMin} max={nottiMax} step="1" value={nottiMin} aria-label="Numero minimo di notti" />
                <input type="range" name="notti_max" min={nottiMin} max={nottiMax} step="1" value={nottiMax} aria-label="Numero massimo di notti" />
              </div>
              <div class="range-doppio__estremi"><span id="durata-estremo-min">{nottiMin} notti</span><span id="durata-estremo-max">{nottiMax} notti</span></div>
            </div>
          </details>
  
          <div class="filtri__azioni">
            <button type="reset" class="filtri__azzera" id="azzera-filtri">Azzera i filtri</button>
            <span class="filtri__esito" id="esito-filtri" role="status" aria-live="polite"></span>
            {soloGuida ? <a class="filtri__link" href="/tour/">Vedi tutti i tour</a> : <a class="filtri__link" href="/tour/guida-in-italiano/">Solo i tour con guida in italiano</a>}
          </div>
        </form>
      )}
  </CopertinaSezione>

  <main
    class="contenitore pagina-tour"
    data-url-supabase={urlSupabase}
    data-chiave={chiaveAnon}
    data-iniziali={INIZIALI}
    data-notti-max={nottiMax}
    data-notti-min={nottiMin}
    data-guida={soloGuida ? '1' : '0'}
  >

    {tour.length > 0 ? (
      <>
        <ul class="griglia-tour" id="griglia-tour">
          {tour.slice(0, INIZIALI).map(t => (
            <li>
              <CardTour tour={t} />
            </li>
          ))}
        </ul>
        <p class="altri" id="altri" hidden={tour.length <= INIZIALI}>
          <button type="button" class="pulsante-altri" id="mostra-altri">Mostra altri tour</button>
        </p>
      </>
    ) : (
      <p class="vuoto">Non ci sono ancora tour pubblicati. <a href="/">Vedi tutti i villaggi</a>.</p>
    )}
    <p class="vuoto" id="nessun-tour" hidden>Nessun tour corrisponde ai filtri scelti. Prova ad allargare il periodo o il numero di notti.</p>
  </main>


<script>
  import { intervalloDate } from '../../lib/dateTour'

  // I filtri usano la stessa funzione del database (tour_ricerca_pubblica) che alimenta l'elenco.
  // La barra della durata NON viene mandata al database: i risultati degli altri filtri si tengono qui
  // e la barra si restringe (a cascata) al minimo e massimo di notti dei tour rimasti; la durata scelta
  // filtra poi questi risultati senza altre richieste.
  const principale = document.querySelector<HTMLElement>('.pagina-tour')
  const modulo = document.querySelector<HTMLFormElement>('#filtri-tour')
  const griglia = document.querySelector<HTMLElement>('#griglia-tour')
  const esito = document.querySelector<HTMLElement>('#esito-filtri')
  const nessuno = document.querySelector<HTMLElement>('#nessun-tour')
  const altri = document.querySelector<HTMLElement>('#altri')
  const bottoneAltri = document.querySelector<HTMLButtonElement>('#mostra-altri')
  const testoDurata = document.querySelector<HTMLElement>('#durata-testo')
  const selezione = document.querySelector<HTMLElement>('#durata-selezione')
  const estremoMin = document.querySelector<HTMLElement>('#durata-estremo-min')
  const estremoMax = document.querySelector<HTMLElement>('#durata-estremo-max')
  const barraMin = modulo?.elements.namedItem('notti_min') as HTMLInputElement | null
  const barraMax = modulo?.elements.namedItem('notti_max') as HTMLInputElement | null
  const urlSupabase = principale?.dataset.urlSupabase
  const chiave = principale?.dataset.chiave
  const PER_VOLTA = Number(principale?.dataset.iniziali ?? 48)
  const SOLO_GUIDA = principale?.dataset.guida === '1'
  const guidaAttiva = () => SOLO_GUIDA || (modulo?.elements.namedItem('guida') as HTMLInputElement | null)?.checked === true

  type Tour = {
    slug: string
    nome: string
    sottotitolo: string | null
    immagine_url: string | null
    paese: string | null
    notti: number
    prezzo_min: number | null
    prossima: string | null
    n_partenze: number
    guida_italiano?: string
    tipo_viaggio?: string
  }

  let base: Tour[] = [] // risultati degli altri filtri (senza la durata)
  let baseCaricata = false
  let risultati: Tour[] = []
  let mostrati = 0
  let numeroRichiesta = 0
  let attesa: number | undefined
  let nMin = Number(principale?.dataset.nottiMin ?? 0)
  let nMax = Number(principale?.dataset.nottiMax ?? 30)
  let scelteDa: number | null = null // durata scelta dall'utente (null = tutto l'intervallo)
  let scelteA: number | null = null

  // Nazione e Periodo si restringono a cascata: restano solo le scelte che hanno tour con gli altri filtri applicati.
  const selPaese = modulo?.elements.namedItem('paese') as HTMLSelectElement | null
  const selPeriodo = modulo?.elements.namedItem('periodo') as HTMLSelectElement | null
  const opzioniPaese = Array.from(selPaese?.options ?? []).map(o => ({ valore: o.value, testo: o.textContent ?? '' }))
  const opzioniPeriodo = Array.from(selPeriodo?.options ?? []).map(o => ({ valore: o.value, testo: o.textContent ?? '', dal: o.dataset.dal ?? '', al: o.dataset.al ?? '' }))
  let numeroFiltri = 0
  let attesaFiltri: number | undefined

  const esc = (s: string | null | undefined) =>
    String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string)
  const euro = (n: number) => new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n)
  const dataBreve = (iso: string) => {
    const [a, m, g] = iso.split('-').map(Number)
    return new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(Date.UTC(a, m - 1, g)))
  }

  function scheda(t: Tour) {
    const guida = t.guida_italiano === 'si' ? 'Guida in italiano' : t.guida_italiano === 'su_richiesta' ? 'Italiano su richiesta' : ''
    const quando = intervalloDate(t.prossima, t.notti)
    return `<li><a class="card-tour" href="/tour/${esc(t.slug)}/">
      <div class="card-tour__immagine">${
        t.immagine_url
          ? `<img src="${esc(t.immagine_url)}" alt="${esc(t.nome)}" loading="lazy" />`
          : `<span class="card-tour__segnaposto" aria-hidden="true">${esc(t.nome.charAt(0))}</span>`
      }<span class="card-tour__tipo">${t.notti} ${t.notti === 1 ? 'notte' : 'notti'}</span>${guida ? `<span class="card-tour__guida">${guida}</span>` : ''}
        <div class="card-tour__sopra">
          <span class="card-tour__luogo">${t.paese ? `${esc(t.paese)} · ` : ''}${t.tipo_viaggio === 'self' ? 'Self made' : 'Guidato'}</span>
          <span class="card-tour__titolo">${esc(t.nome)}</span>
        </div>
      </div>
      <div class="card-tour__corpo">
        <div class="card-tour__riga">
          <div class="card-tour__sinistra">
            ${t.sottotitolo ? `<span class="card-tour__sottotitolo">${esc(t.sottotitolo)}</span>` : ''}
            ${quando ? `<span class="card-tour__quando">${esc(quando)}${t.n_partenze > 1 ? `<small>${t.n_partenze} date</small>` : ''}</span>` : ''}
          </div>
          ${t.prezzo_min != null ? `<span class="card-tour__prezzo"><span class="card-tour__importo">da <strong>${euro(Number(t.prezzo_min))}</strong></span><small>a persona</small></span>` : ''}
        </div>
      </div></a></li>`
  }

  function campo(nome: string) {
    return (modulo?.elements.namedItem(nome) as HTMLInputElement | HTMLSelectElement | null)?.value ?? ''
  }

  // durata effettiva scelta, dentro l'intervallo attuale della barra
  function durataScelta() {
    const da = Math.min(Math.max(scelteDa ?? nMin, nMin), nMax)
    const a = Math.max(Math.min(scelteA ?? nMax, nMax), da)
    return { da, a, filtrata: da > nMin || a < nMax }
  }

  function disegnaBarra() {
    if (!barraMin || !barraMax) return
    const { da, a, filtrata } = durataScelta()
    const unico = nMin === nMax
    for (const el of [barraMin, barraMax]) {
      el.min = String(nMin)
      el.max = String(nMax)
      el.disabled = unico
    }
    barraMin.value = String(da)
    barraMax.value = String(a)
    const span = Math.max(nMax - nMin, 1)
    if (testoDurata) {
      testoDurata.textContent = unico
        ? `Durata: ${nMin} ${nMin === 1 ? 'notte' : 'notti'} (tutti i tour scelti hanno questa durata)`
        : filtrata
          ? `Durata: da ${da} a ${a} ${a === 1 ? 'notte' : 'notti'}`
          : 'Durata: qualsiasi'
    }
    if (selezione) {
      selezione.style.left = `${((da - nMin) / span) * 100}%`
      selezione.style.right = `${100 - ((a - nMin) / span) * 100}%`
    }
    if (estremoMin) estremoMin.textContent = `${nMin} ${nMin === 1 ? 'notte' : 'notti'}`
    if (estremoMax) estremoMax.textContent = `${nMax} ${nMax === 1 ? 'notte' : 'notti'}`
  }

  function riempi(sel: HTMLSelectElement | null, voci: Array<{ valore: string; testo: string; dal?: string; al?: string }>, ammessi: Set<string>) {
    if (!sel) return
    const scelto = sel.value
    sel.innerHTML = ''
    for (const v of voci) {
      if (v.valore !== '' && !ammessi.has(v.valore) && v.valore !== scelto) continue
      const o = document.createElement('option')
      o.value = v.valore
      o.textContent = v.testo
      if (v.dal) o.dataset.dal = v.dal
      if (v.al) o.dataset.al = v.al
      sel.appendChild(o)
    }
    sel.value = scelto
  }

  async function aggiornaFiltri() {
    if (!urlSupabase || !chiave) return
    const numero = ++numeroFiltri
    const { da, a, filtrata } = durataScelta()
    const corpo: Record<string, unknown> = {}
    if (campo('paese')) corpo.p_paese = campo('paese')
    if (campo('dal')) corpo.p_dal = campo('dal')
    if (campo('al')) corpo.p_al = campo('al')
    if (campo('prezzo')) corpo.p_prezzo_max = Number(campo('prezzo'))
    if (guidaAttiva()) corpo.p_guida = true
    if (campo('tipo')) corpo.p_tipo = campo('tipo')
    if (filtrata) {
      corpo.p_notti_min = da
      corpo.p_notti_max = a
    }
    try {
      const risposta = await fetch(`${urlSupabase}/rest/v1/rpc/tour_filtri_pubblici`, {
        method: 'POST',
        headers: { apikey: chiave, Authorization: `Bearer ${chiave}`, 'Content-Type': 'application/json' },
        body: JSON.stringify(corpo),
      })
      if (!risposta.ok || numero !== numeroFiltri) return
      const d: { paesi: string[]; mesi: string[] } = await risposta.json()
      riempi(selPaese, opzioniPaese, new Set(d.paesi))
      riempi(selPeriodo, opzioniPeriodo, new Set(d.mesi))
    } catch {
      /* le scelte restano quelle di prima */
    }
  }

  function programmaFiltri() {
    window.clearTimeout(attesaFiltri)
    attesaFiltri = window.setTimeout(aggiornaFiltri, 250)
  }

  const normalizza = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')

  // la ricerca per testo guarda nome, sottotitolo e nazione dei risultati degli altri filtri
  function perTesto(lista: Tour[]) {
    const testo = normalizza(campo('testo')).trim()
    if (!testo) return lista
    return lista.filter(t => normalizza(`${t.nome} ${t.sottotitolo ?? ''} ${t.paese ?? ''}`).includes(testo))
  }

  function ricalcolaIntervallo() {
    const notti = perTesto(base).map(t => t.notti)
    nMin = notti.length ? Math.min(...notti) : 0
    nMax = notti.length ? Math.max(...notti) : 0
  }

  function parametri() {
    const p: Record<string, unknown> = { p_limit: 1000, p_ordine: campo('ordine') || 'data' }
    if (campo('paese')) p.p_paese = campo('paese')
    if (campo('dal')) p.p_dal = campo('dal')
    if (campo('al')) p.p_al = campo('al')
    if (campo('prezzo')) p.p_prezzo_max = Number(campo('prezzo'))
    if (guidaAttiva()) p.p_guida = true
    if (campo('tipo')) p.p_tipo = campo('tipo')
    return p // niente durata: la applica il browser sui risultati
  }

  function disegna(dall: number) {
    if (!griglia) return
    const fine = Math.min(dall + PER_VOLTA, risultati.length)
    const html = risultati.slice(dall, fine).map(scheda).join('')
    if (dall === 0) griglia.innerHTML = html
    else griglia.insertAdjacentHTML('beforeend', html)
    mostrati = fine
    if (altri) altri.hidden = mostrati >= risultati.length
    if (bottoneAltri) bottoneAltri.textContent = `Mostra altri tour (${risultati.length - mostrati} ancora)`
  }

  // applica la durata scelta ai risultati degli altri filtri e ridisegna l'elenco
  function rendi() {
    const { da, a, filtrata } = durataScelta()
    const perTesti = perTesto(base)
    risultati = filtrata ? perTesti.filter(t => t.notti >= da && t.notti <= a) : perTesti
    disegna(0)
    disegnaBarra()
    if (nessuno) nessuno.hidden = risultati.length > 0
    if (esito) esito.textContent = risultati.length === 1 ? '1 tour trovato' : `${risultati.length} tour trovati`
    scriviUrl()
  }

  async function applica() {
    if (!modulo || !urlSupabase || !chiave) return
    const numero = ++numeroRichiesta
    if (esito) esito.textContent = 'Ricerca in corso…'
    try {
      const risposta = await fetch(`${urlSupabase}/rest/v1/rpc/tour_ricerca_pubblica`, {
        method: 'POST',
        headers: { apikey: chiave, Authorization: `Bearer ${chiave}`, 'Content-Type': 'application/json' },
        body: JSON.stringify(parametri()),
      })
      if (!risposta.ok) throw new Error(String(risposta.status))
      const trovati: Tour[] = await risposta.json()
      if (numero !== numeroRichiesta) return
      base = trovati
      baseCaricata = true
      // la barra si restringe alla durata dei tour rimasti
      ricalcolaIntervallo()
      rendi()
      aggiornaFiltri()
    } catch {
      if (numero !== numeroRichiesta) return
      if (esito) esito.textContent = 'Non riesco a filtrare in questo momento: riprova tra poco.'
    }
  }

  // L'indirizzo della pagina segue i filtri (es. /tour/?paese=Kenya&periodo=2027-03&tipo=guidato): cosi' una ricerca
  // si puo' mandare a un cliente e, aprendola, la pagina si presenta gia' filtrata.
  const CAMPI_URL = ['paese', 'periodo', 'tipo', 'testo', 'dal', 'al', 'prezzo', 'ordine']

  function scriviUrl() {
    const p = new URLSearchParams()
    // le date del periodo scelto sono gia' comprese nel periodo: non si ripetono nell'indirizzo
    const opz = selPeriodo?.selectedOptions[0]
    const datePeriodo = !!selPeriodo?.value && campo('dal') === (opz?.dataset.dal ?? '') && campo('al') === (opz?.dataset.al ?? '')
    for (const nome of CAMPI_URL) {
      const v = campo(nome)
      if (datePeriodo && (nome === 'dal' || nome === 'al')) continue
      if (v && !(nome === 'ordine' && v === 'data')) p.set(nome, v)
    }
    if (!SOLO_GUIDA && guidaAttiva()) p.set('guida', '1')
    const { da, a, filtrata } = durataScelta()
    if (filtrata) {
      p.set('notti_min', String(da))
      p.set('notti_max', String(a))
    }
    const q = p.toString()
    window.history.replaceState(null, '', window.location.pathname + (q ? '?' + q : '') + window.location.hash)
  }

  // all'apertura: se l'indirizzo contiene dei filtri, li rimette nei campi e carica i risultati
  function leggiUrl() {
    if (!modulo) return false
    const p = new URLSearchParams(window.location.search)
    let trovato = false
    let avanzati = false
    for (const nome of CAMPI_URL) {
      const v = p.get(nome)
      const el = modulo.elements.namedItem(nome) as HTMLInputElement | HTMLSelectElement | null
      if (!v || !el) continue
      el.value = v
      if (el.value === '' && el.tagName === 'SELECT') continue // scelta non presente nell'elenco
      trovato = true
      if (['dal', 'al', 'prezzo', 'ordine'].includes(nome)) avanzati = true
    }
    // il periodo (mese) riempie le due date, come quando lo si sceglie a mano
    const periodo = modulo.elements.namedItem('periodo') as HTMLSelectElement | null
    const opzione = periodo?.selectedOptions[0]
    if (periodo?.value && opzione) {
      const dal = modulo.elements.namedItem('dal') as HTMLInputElement
      const al = modulo.elements.namedItem('al') as HTMLInputElement
      if (!p.get('dal')) dal.value = opzione.dataset.dal ?? ''
      if (!p.get('al')) al.value = opzione.dataset.al ?? ''
    }
    const guida = modulo.elements.namedItem('guida') as HTMLInputElement | null
    if (guida && p.get('guida') === '1') {
      guida.checked = true
      trovato = true
      avanzati = true
    }
    const nMinUrl = Number(p.get('notti_min'))
    const nMaxUrl = Number(p.get('notti_max'))
    if (p.get('notti_min') && p.get('notti_max') && Number.isFinite(nMinUrl) && Number.isFinite(nMaxUrl)) {
      scelteDa = nMinUrl
      scelteA = nMaxUrl
      trovato = true
      avanzati = true
    }
    if (avanzati) {
      const dettagli = modulo.querySelector<HTMLDetailsElement>('details.filtri__altri')
      if (dettagli) dettagli.open = true
    }
    return trovato
  }

  function programma() {
    window.clearTimeout(attesa)
    attesa = window.setTimeout(applica, 250)
  }

  // il periodo (mese) riempie le due date; scrivere una data a mano toglie il periodo
  modulo?.addEventListener('change', e => {
    const bersaglio = e.target as HTMLInputElement | HTMLSelectElement
    if (bersaglio.name === 'notti_min' || bersaglio.name === 'notti_max') return
    if (bersaglio.name === 'periodo') {
      const opzione = (bersaglio as HTMLSelectElement).selectedOptions[0]
      ;(modulo.elements.namedItem('dal') as HTMLInputElement).value = opzione?.dataset.dal ?? ''
      ;(modulo.elements.namedItem('al') as HTMLInputElement).value = opzione?.dataset.al ?? ''
    } else if (bersaglio.name === 'dal' || bersaglio.name === 'al') {
      ;(modulo.elements.namedItem('periodo') as HTMLSelectElement).value = ''
    }
    programma()
  })
  modulo?.addEventListener('input', e => {
    const nome = (e.target as HTMLInputElement).name
    if (nome === 'testo' && baseCaricata) {
      // la ricerca per testo filtra i risultati gia' caricati, senza altre richieste
      ricalcolaIntervallo()
      rendi()
      return
    }
    if (nome === 'notti_min' || nome === 'notti_max') {
      // spostare la barra non richiede altre richieste: filtra i risultati gia' presenti
      const da = Number(barraMin?.value)
      const a = Number(barraMax?.value)
      if (nome === 'notti_min') scelteDa = Math.min(da, a)
      else scelteA = Math.max(a, da)
      if (baseCaricata) {
        rendi()
        programmaFiltri()
      } else {
        // l'elenco iniziale e' solo parziale: carico prima i risultati completi
        disegnaBarra()
        programma()
      }
      return
    }
    programma()
  })
  modulo?.addEventListener('reset', () => {
    scelteDa = null
    scelteA = null
    window.setTimeout(applica, 0)
  })
  modulo?.addEventListener('submit', e => {
    e.preventDefault()
    if (baseCaricata) {
      ricalcolaIntervallo()
      rendi()
    } else applica()
    griglia?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  })
  bottoneAltri?.addEventListener('click', () => disegna(mostrati))
  disegnaBarra()
  if (leggiUrl()) applica()
  // l'elenco iniziale e' gia' nella pagina (48 schede per i motori di ricerca): conta quanti ce ne sono
  mostrati = griglia?.querySelectorAll('li').length ?? 0
</script>

