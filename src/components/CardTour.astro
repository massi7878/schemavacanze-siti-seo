---
import { euro } from '../lib/offerte'
import { intervalloDate } from '../lib/dateTour'
import { etichettaGuida, etichettaTipo, urlTour, type TourElenco } from '../lib/tour'

interface Props {
  tour: TourElenco
}

const { tour } = Astro.props
const guida = etichettaGuida(tour.guida_italiano)
const quando = intervalloDate(tour.prossima, tour.notti)
---

<a class="card-tour" href={urlTour(tour.slug)}>
  <div class="card-tour__immagine">
    {tour.immagine_url
      ? <img src={tour.immagine_url} alt={tour.nome} loading="lazy" />
      : <span class="card-tour__segnaposto" aria-hidden="true">{tour.nome.charAt(0)}</span>}
    <span class="card-tour__tipo">{tour.notti} {tour.notti === 1 ? 'notte' : 'notti'}</span>
    {guida && <span class="card-tour__guida">{guida}</span>}
    <div class="card-tour__sopra">
      <span class="card-tour__luogo">{tour.paese ? `${tour.paese} · ` : ''}{etichettaTipo(tour.tipo_viaggio)}</span>
      <span class="card-tour__titolo">{tour.nome}</span>
    </div>
  </div>
  <div class="card-tour__corpo">
    <div class="card-tour__riga">
      <div class="card-tour__sinistra">
        {tour.sottotitolo && <span class="card-tour__sottotitolo">{tour.sottotitolo}</span>}
        {quando && (
          <span class="card-tour__quando">{quando}{tour.n_partenze > 1 && <small>{tour.n_partenze} date</small>}</span>
        )}
      </div>
      {tour.prezzo_min != null && (
        <span class="card-tour__prezzo">
          <span class="card-tour__importo">da <strong>{euro(Number(tour.prezzo_min))}</strong></span>
          <small>a persona</small>
        </span>
      )}
    </div>
  </div>
</a>

<!-- stili globali: le stesse schede vengono ricreate dal browser quando si applicano i filtri -->
<style is:global>
  .card-tour {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    overflow: hidden;
    box-shadow: var(--ombra);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card-tour:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 8px rgba(52, 54, 58, 0.08), 0 16px 32px -16px rgba(52, 54, 58, 0.28);
  }

  .card-tour__immagine {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--superficie-tenue);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-tour__immagine img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-tour__segnaposto {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--colore-primario-scuro);
  }

  .card-tour__tipo {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--colore-primario-scuro);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3em 0.7em;
    border-radius: 999px;
  }

  .card-tour__guida {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: #fff;
    color: var(--colore-primario-scuro);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3em 0.7em;
    border-radius: 999px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }

  /* titolo e nazione in bianco sopra la foto, su una sfumatura scura in basso */
  .card-tour__immagine::after {
    content: '';
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(to top, rgba(10, 18, 28, 0.82), rgba(10, 18, 28, 0));
    pointer-events: none;
  }

  .card-tour__sopra {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0 1.1rem 0.9rem;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
  }

  .card-tour__tipo,
  .card-tour__guida {
    z-index: 1;
  }

  .card-tour__luogo {
    font-size: 0.82rem;
    font-weight: 600;
    color: #fff;
    opacity: 0.95;
  }

  .card-tour__titolo {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.2;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tour__corpo {
    padding: 0.85rem 1.1rem 1rem;
    flex: 1;
  }

  /* sotto la foto: a sinistra la tratta e le date, a destra il prezzo con "a persona" sotto */
  .card-tour__riga {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .card-tour__sinistra {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .card-tour__sottotitolo {
    font-size: 0.9rem;
    color: var(--testo-tenue);
  }

  .card-tour__quando {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--testo);
  }

  .card-tour__quando small {
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--testo-tenue);
    margin-left: 0.4rem;
  }

  .card-tour__prezzo {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    line-height: 1.15;
    white-space: nowrap;
  }

  .card-tour__importo {
    font-size: 0.88rem;
    color: var(--testo);
  }

  .card-tour__prezzo strong {
    font-size: 1.35rem;
    color: var(--colore-primario-scuro);
  }

  .card-tour__prezzo small {
    font-size: 0.78rem;
    color: var(--testo-tenue);
  }
</style>
