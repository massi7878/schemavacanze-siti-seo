---
import IconaContatto from './IconaContatto.astro'
import { NOME_TIPO_PUNTO, descriviPartenza, euro } from '../lib/offerte'

interface Props {
  // offerta (con le sue partenze) oppure tour (la partenza arriva dal calendario della pagina)
  offertaId?: string
  tourId?: string
  codice?: number
  titolo: string
  numeroWa?: string | null
  urlPagina: string
  canaleEmail?: boolean
  canaleWhatsapp?: boolean
  partenze?: Array<{
    id: string
    data_partenza: string
    data_rientro: string
    prezzo_da: number | null
    stato: string
    prezzi?: Array<{ prezzo_da: number; punto: { id: string; tipo: string; nome: string } | null }>
  }>
  punti?: Array<{ id: string; tipo: string; nome: string }>
  validaDal?: string | null
  validaAl?: string | null
}

const { offertaId, tourId, codice, titolo, numeroWa = null, urlPagina, canaleEmail = true, canaleWhatsapp = true, partenze = [], punti = [], validaDal = null, validaAl = null } = Astro.props
const eTour = Boolean(tourId)

function nomePunto(p: { tipo: string; nome: string }) {
  return `${NOME_TIPO_PUNTO[p.tipo] ?? ''} ${p.nome}`.trim()
}

// Per ogni data: da quali localita' si puo' partire e a che prezzo (il minimo se ce n'e' piu' di uno)
function puntiDellaPartenza(p: (typeof partenze)[number]) {
  const perPunto = new Map<string, { id: string; nome: string; prezzo: number }>()
  for (const z of p.prezzi ?? []) {
    if (!z.punto) continue
    const attuale = perPunto.get(z.punto.id)
    if (!attuale || Number(z.prezzo_da) < attuale.prezzo) perPunto.set(z.punto.id, { id: z.punto.id, nome: nomePunto(z.punto), prezzo: Number(z.prezzo_da) })
  }
  // un prezzo senza localita' vale per tutte: quelle dell'offerta restano scegliere
  const validoPerTutti = (p.prezzi ?? []).filter(z => !z.punto).map(z => Number(z.prezzo_da))
  if (validoPerTutti.length > 0) {
    const minimo = Math.min(...validoPerTutti)
    for (const o of punti) {
      const attuale = perPunto.get(o.id)
      if (!attuale) perPunto.set(o.id, { id: o.id, nome: nomePunto(o), prezzo: minimo })
      else if (minimo < attuale.prezzo) attuale.prezzo = minimo
    }
  }
  return [...perPunto.values()]
}

const puntiOfferta = punti.map(p => ({ id: p.id, nome: nomePunto(p), prezzo: null as number | null }))
const prenotabili = partenze.filter(p => p.stato !== 'esaurita')
const urlSupabase = import.meta.env.PUBLIC_SUPABASE_URL
const chiaveAnon = import.meta.env.PUBLIC_SUPABASE_ANON_KEY
---

<dialog id="dialog-richiesta" class="richiesta" data-offerta={offertaId} data-tour={tourId} data-titolo={titolo} data-codice={codice} data-wa={numeroWa} data-pagina={urlPagina} data-url={urlSupabase} data-chiave={chiaveAnon} data-punti-offerta={JSON.stringify(puntiOfferta)}>
  <form method="dialog" class="richiesta__modulo" id="modulo-richiesta" novalidate>
    <header class="richiesta__testata">
      <div>
        <h2>Richiedi disponibilità</h2>
        <p class="richiesta__rif">{eTour ? titolo : `${titolo} · Rif. OFF-${codice}`}</p>
      </div>
      <button type="button" class="richiesta__chiudi" data-chiudi aria-label="Chiudi">×</button>
    </header>

    <div class="richiesta__corpo" id="richiesta-campi">
      {eTour && <div class="richiesta__riepilogo" id="richiesta-riepilogo" hidden></div>}
      {!eTour && (prenotabili.length > 0 ? (
        <label class="campo">
          Partenza
          <select name="partenza" required>
            <option value="">Scegli la data…</option>
            {prenotabili.map(p => (
              <option value={p.id} data-dal={p.data_partenza} data-al={p.data_rientro} data-punti={JSON.stringify(puntiDellaPartenza(p))}>
                {descriviPartenza(p.data_partenza, p.data_rientro)}{p.prezzo_da != null ? ` — da ${euro(Number(p.prezzo_da))}` : ''}
              </option>
            ))}
            <option value="altra">Altra data (la indico nelle note)</option>
          </select>
        </label>
      ) : (
        <div class="riga-2">
          <label class="campo">
            Dal
            <input type="date" name="dal" min={validaDal ?? undefined} max={validaAl ?? undefined} />
          </label>
          <label class="campo">
            Al
            <input type="date" name="al" min={validaDal ?? undefined} max={validaAl ?? undefined} />
          </label>
        </div>
      ))}

      <label class="campo" id="campo-punto" hidden>
        Partenza da
        <select name="punto"></select>
      </label>

      <div class="riga-2">
        <label class="campo">
          Adulti
          <input type="number" name="adulti" min="1" max="20" value="2" required inputmode="numeric" />
        </label>
        <label class="campo">
          Bambini
          <input type="number" name="bambini" min="0" max="10" value="0" inputmode="numeric" />
        </label>
      </div>
      <div class="eta-bambini" id="eta-bambini" hidden></div>

      <div class="riga-2">
        <label class="campo">
          Nome
          <input type="text" name="nome" required autocomplete="given-name" maxlength="100" />
        </label>
        <label class="campo">
          Cognome
          <input type="text" name="cognome" required autocomplete="family-name" maxlength="100" />
        </label>
      </div>
      <div class="riga-2">
        <label class="campo">
          E-mail
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label class="campo">
          <span>Telefono <small>(serve solo per l'invio via e-mail)</small></span>
          <input type="tel" name="telefono" autocomplete="tel" inputmode="tel" pattern="[0-9+()\s.\-]{8,}" title="Almeno 8 cifre, ad esempio 333 1234567" />
        </label>
      </div>
      <label class="campo">
        Scrivi qui la tua richiesta o altre esigenze (facoltativo)
        <textarea name="note" rows="3" maxlength="1500" placeholder="Esigenze particolari, altra data, aeroporto di partenza preferito…"></textarea>
      </label>

      <label class="consenso">
        <input type="checkbox" name="privacy" required />
        <span>Acconsento al trattamento dei miei dati per essere ricontattato in merito a questa richiesta.</span>
      </label>
      <label class="consenso">
        <input type="checkbox" name="marketing" />
        <span>Desidero ricevere altre offerte via e-mail (facoltativo).</span>
      </label>

      <!-- trappola per i bot: i visitatori veri non la vedono -->
      <div class="trappola" aria-hidden="true">
        <label>Non compilare questo campo<input type="text" name="sito" tabindex="-1" autocomplete="off" /></label>
      </div>

      <p class="richiesta__errore" id="richiesta-errore" role="alert" hidden></p>
      <p class="richiesta__nota">Nessun pagamento online: ti rispondiamo con la disponibilità e il prezzo definitivo.</p>
      <p class="richiesta__scelta">Come vuoi inviarla?</p>
      <div class="richiesta__invii">
        {canaleWhatsapp && numeroWa && (
          <button type="button" class="pulsante richiesta__whatsapp" id="richiesta-whatsapp"><IconaContatto tipo="whatsapp" dimensione={16} /><span>Invia su WhatsApp</span></button>
        )}
        {canaleEmail && (
          <button type="submit" class="pulsante richiesta__invia" id="richiesta-invia"><IconaContatto tipo="email" dimensione={16} /><span id="richiesta-invia-testo">Invia via e-mail</span></button>
        )}
      </div>
    </div>

    <div class="richiesta__esito" id="richiesta-esito-wa" hidden>
      <h3>Ultimo passo su WhatsApp</h3>
      <p>Si è aperta la chat con il messaggio già scritto e il link a «{titolo}»: premi <strong>Invia</strong> su WhatsApp per completare la richiesta.</p>
      <button type="button" class="pulsante" data-chiudi>Chiudi</button>
    </div>

    <div class="richiesta__esito" id="richiesta-esito" hidden>
      <h3>Richiesta inviata</h3>
      <p>Grazie! Abbiamo ricevuto la tua richiesta per «{titolo}». Ti ricontatteremo al più presto con la disponibilità.</p>
      <button type="button" class="pulsante" data-chiudi>Chiudi</button>
    </div>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#dialog-richiesta')
  const modulo = document.querySelector<HTMLFormElement>('#modulo-richiesta')
  const campi = document.querySelector<HTMLElement>('#richiesta-campi')
  const esito = document.querySelector<HTMLElement>('#richiesta-esito')
  const errore = document.querySelector<HTMLElement>('#richiesta-errore')
  const invia = document.querySelector<HTMLButtonElement>('#richiesta-invia')
  const etaBox = document.querySelector<HTMLElement>('#eta-bambini')
  const esitoWa = document.querySelector<HTMLElement>('#richiesta-esito-wa')
  const bottoneWa = document.querySelector<HTMLButtonElement>('#richiesta-whatsapp')
  const riepilogoBox = document.querySelector<HTMLElement>('#richiesta-riepilogo')
  const eTour = Boolean(dialog?.dataset.tour)
  // dati della partenza scelta nel calendario del tour (testo del riepilogo, date, persone)
  let infoTour: { dal?: string; al?: string; adulti?: number; bambini?: number; riepilogo?: string } = {}

  // Provenienza del visitatore (UTM): si ricorda per la sessione, cosi' resta anche dopo aver cambiato pagina
  const utm: Record<string, string> = {}
  try {
    const params = new URLSearchParams(location.search)
    for (const k of ['utm_source', 'utm_medium', 'utm_campaign']) {
      const v = params.get(k)
      if (v) sessionStorage.setItem(k, v.slice(0, 120))
      const salvato = sessionStorage.getItem(k)
      if (salvato) utm[k] = salvato
    }
  } catch {
    /* storage non disponibile */
  }

  // "Partenza da": le localita' della data scelta (con il prezzo), altrimenti quelle dell'offerta
  const campoPunto = document.querySelector<HTMLElement>('#campo-punto')
  const selectPunto = campoPunto?.querySelector<HTMLSelectElement>('select')
  const puntiOfferta: Array<{ id: string; nome: string; prezzo: number | null }> = JSON.parse(dialog?.dataset.puntiOfferta ?? '[]')
  const euroFmt = new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 })

  function aggiornaPunti() {
    // "Altra data": senza partenza scelta le note servono per capire quando vuole partire
    const scelta = (modulo?.elements.namedItem('partenza') as HTMLSelectElement | null)?.value
    const campoNote = modulo?.elements.namedItem('note') as HTMLTextAreaElement | null
    if (campoNote) campoNote.required = scelta === 'altra'
    if (!campoPunto || !selectPunto) return
    const sel = modulo?.elements.namedItem('partenza') as HTMLSelectElement | null
    let elenco: Array<{ id: string; nome: string; prezzo: number | null }> = []
    try {
      elenco = JSON.parse(sel?.selectedOptions[0]?.dataset.punti ?? '[]')
    } catch {
      elenco = []
    }
    if (elenco.length === 0) elenco = puntiOfferta
    selectPunto.innerHTML = ''
    if (elenco.length === 0) {
      campoPunto.hidden = true
      selectPunto.required = false
      return
    }
    const vuota = document.createElement('option')
    vuota.value = ''
    vuota.textContent = elenco.length > 1 ? 'Scegli da dove partire…' : 'Indifferente'
    selectPunto.appendChild(vuota)
    for (const p of elenco) {
      const o = document.createElement('option')
      o.value = p.id
      o.textContent = p.prezzo != null ? `${p.nome} — ${euroFmt.format(p.prezzo)}` : p.nome
      selectPunto.appendChild(o)
    }
    if (elenco.length === 1) selectPunto.value = elenco[0].id
    selectPunto.required = elenco.length > 1
    campoPunto.hidden = false
  }

  function apri(partenzaId?: string, tour?: typeof infoTour) {
    if (!dialog || !modulo) return
    if (esito) esito.hidden = true
    if (esitoWa) esitoWa.hidden = true
    if (campi) campi.hidden = false
    if (errore) errore.hidden = true
    const sel = modulo.elements.namedItem('partenza') as HTMLSelectElement | null
    if (sel && partenzaId) sel.value = partenzaId
    if (eTour) {
      infoTour = tour ?? {}
      if (riepilogoBox) {
        riepilogoBox.textContent = infoTour.riepilogo ?? ''
        riepilogoBox.hidden = !infoTour.riepilogo
      }
      const ad = modulo.elements.namedItem('adulti') as HTMLInputElement | null
      const bb = modulo.elements.namedItem('bambini') as HTMLInputElement | null
      if (ad && infoTour.adulti) ad.value = String(infoTour.adulti)
      if (bb && infoTour.bambini != null) {
        bb.value = String(infoTour.bambini)
        bb.dispatchEvent(new Event('input'))
      }
    }
    aggiornaPunti()
    dialog.showModal()
  }

  document.querySelectorAll<HTMLElement>('[data-apri-richiesta]').forEach(el =>
    el.addEventListener('click', () => apri(el.dataset.partenza))
  )
  // tour: il calendario manda i dati della partenza scelta; i tasti "WhatsApp" della pagina aprono lo stesso modulo senza data
  document.addEventListener('apri-richiesta-tour', e => apri(undefined, (e as CustomEvent).detail))
  document.querySelectorAll<HTMLElement>('[data-apri-richiesta-tour]').forEach(el => el.addEventListener('click', () => apri(undefined, {})))
  document.querySelectorAll<HTMLElement>('[data-chiudi]').forEach(el => el.addEventListener('click', () => dialog?.close()))
  dialog?.addEventListener('click', e => {
    if (e.target === dialog) dialog.close()
  })

  const selezionePartenza = modulo?.elements.namedItem('partenza') as HTMLSelectElement | null
  selezionePartenza?.addEventListener('change', aggiornaPunti)
  aggiornaPunti()

  // un campo "eta'" per ogni bambino
  const campoBambini = modulo?.elements.namedItem('bambini') as HTMLInputElement | null
  campoBambini?.addEventListener('input', () => {
    if (!etaBox) return
    const n = Math.max(0, Math.min(10, Number(campoBambini.value) || 0))
    const esistenti = etaBox.querySelectorAll('input').length
    if (n > esistenti) {
      for (let i = esistenti; i < n; i++) {
        const l = document.createElement('label')
        l.className = 'campo'
        l.innerHTML = `Età bambino ${i + 1}<input type="number" min="0" max="17" required inputmode="numeric" />`
        etaBox.appendChild(l)
      }
    } else {
      while (etaBox.querySelectorAll('label').length > n) etaBox.lastElementChild?.remove()
    }
    etaBox.hidden = n === 0
  })

  function mostraErrore(testo: string) {
    if (!errore) return
    errore.textContent = testo
    errore.hidden = false
  }

  // dati comuni a WhatsApp ed e-mail
  function leggiDati() {
    if (!modulo || !dialog) return null
    const dati = new FormData(modulo)
    const sel = modulo.elements.namedItem('partenza') as HTMLSelectElement | null
    const opzione = sel?.selectedOptions[0]
    const partenzaId = sel && sel.value && sel.value !== 'altra' ? sel.value : null
    const dal = (dati.get('dal') as string) || opzione?.dataset.dal || infoTour.dal || null
    const al = (dati.get('al') as string) || opzione?.dataset.al || infoTour.al || null
    const eta = Array.from(etaBox?.querySelectorAll('input') ?? []).map(i => Number(i.value) || 0)
    return { dati, partenzaId, dal, al, eta, partenzaTesto: opzione && partenzaId ? opzione.textContent?.trim() ?? '' : '' }
  }

  const dataIt = (iso: string | null) => (iso ? iso.split('-').reverse().join('/') : '')

  // la richiesta viene registrata nel gestionale (cliente + richiesta) con il canale scelto
  function creaRichiesta(d: NonNullable<ReturnType<typeof leggiDati>>, canale: 'email' | 'whatsapp', riepilogo: string) {
    const url = dialog!.dataset.url
    const chiave = dialog!.dataset.chiave
    const intestazioni = { apikey: chiave ?? '', Authorization: `Bearer ${chiave}`, 'Content-Type': 'application/json' }
    const comuni = {
      p_nome: d.dati.get('nome'),
      p_cognome: d.dati.get('cognome'),
      p_email: d.dati.get('email'),
      p_telefono: canale === 'email' ? d.dati.get('telefono') : null,
      p_data_dal: d.dal || null,
      p_data_al: d.al || null,
      p_adulti: Number(d.dati.get('adulti')) || 1,
      p_bambini: Number(d.dati.get('bambini')) || 0,
      p_eta_bambini: d.eta,
      p_note: (d.dati.get('note') as string) || null,
      p_canale: canale,
      p_utm_source: utm.utm_source ?? null,
      p_utm_medium: utm.utm_medium ?? null,
      p_utm_campaign: utm.utm_campaign ?? null,
      p_consenso_marketing: d.dati.get('marketing') === 'on',
    }
    const corpo = eTour
      ? { p_tour_id: dialog!.dataset.tour, p_riepilogo: riepilogo, p_link: dialog!.dataset.pagina, ...comuni }
      : { p_offerta_id: dialog!.dataset.offerta, p_partenza_id: d.partenzaId, p_punto_id: (d.dati.get('punto') as string) || null, ...comuni }
    return { url, intestazioni, corpo, funzione: eTour ? 'crea_richiesta_tour' : 'crea_richiesta_offerta' }
  }

  function personeTesto(d: NonNullable<ReturnType<typeof leggiDati>>) {
    const ad = Number(d.dati.get('adulti')) || 1
    const bb = Number(d.dati.get('bambini')) || 0
    return `${ad} ${ad === 1 ? 'adulto' : 'adulti'}${bb > 0 ? `, ${bb} ${bb === 1 ? 'bambino' : 'bambini'} (età: ${d.eta.join(', ')})` : ''}`
  }

  // messaggio WhatsApp: richiesta, dettagli, dati del cliente e link alla pagina dell'offerta o del tour
  function testoWhatsApp(d: NonNullable<ReturnType<typeof leggiDati>>) {
    const titolo = dialog!.dataset.titolo ?? ''
    const righe: string[] = [
      eTour ? `Buongiorno, vorrei un preventivo per il tour "${titolo}".` : `Buongiorno, vorrei informazioni sull'offerta "${titolo}" (Rif. OFF-${dialog!.dataset.codice}).`,
      '',
    ]
    if (eTour && infoTour.riepilogo) righe.push(infoTour.riepilogo)
    else if (d.partenzaTesto) righe.push(`Partenza: ${d.partenzaTesto}`)
    else if (d.dal || d.al) righe.push(`Periodo: ${[dataIt(d.dal), dataIt(d.al)].filter(Boolean).join(' - ')}`)
    righe.push(`Persone: ${personeTesto(d)}`)
    const note = (d.dati.get('note') as string) || ''
    if (note.trim()) righe.push(`Richiesta: ${note.trim()}`)
    righe.push('', `Nome: ${d.dati.get('nome')} ${d.dati.get('cognome')}`, `E-mail: ${d.dati.get('email')}`, '', `Pagina: ${dialog!.dataset.pagina}`)
    return righe.join('\n')
  }

  bottoneWa?.addEventListener('click', () => {
    if (!modulo || !dialog) return
    errore && (errore.hidden = true)
    // su WhatsApp il telefono non serve
    const tel = modulo.elements.namedItem('telefono') as HTMLInputElement | null
    if (tel) tel.required = false
    if (!modulo.checkValidity()) {
      modulo.reportValidity()
      return
    }
    const d = leggiDati()
    if (!d) return
    if (d.dati.get('sito')) {
      if (campi) campi.hidden = true
      if (esitoWa) esitoWa.hidden = false
      return
    }
    const numero = dialog.dataset.wa
    if (!numero) return
    const link = `https://wa.me/39${numero}?text=${encodeURIComponent(testoWhatsApp(d))}`
    // si registra la richiesta senza aspettarla: la chat si apre subito
    const r = creaRichiesta(d, 'whatsapp', infoTour.riepilogo ?? '')
    fetch(`${r.url}/rest/v1/rpc/${r.funzione}`, { method: 'POST', headers: r.intestazioni, body: JSON.stringify(r.corpo), keepalive: true }).catch(() => {})
    ;(window as any).tracciaEvento?.('Lead', undefined, { email: d.dati.get('email'), telefono: d.dati.get('telefono'), nome: d.dati.get('nome'), cognome: d.dati.get('cognome') })
    window.open(link, '_blank', 'noopener')
    if (campi) campi.hidden = true
    if (esitoWa) esitoWa.hidden = false
  })

  modulo?.addEventListener('submit', async e => {
    e.preventDefault()
    if (!modulo || !dialog || !invia) return
    errore && (errore.hidden = true)
    // via e-mail il telefono e' obbligatorio
    const tel = modulo.elements.namedItem('telefono') as HTMLInputElement | null
    if (tel) tel.required = true
    if (!modulo.checkValidity()) {
      modulo.reportValidity()
      return
    }
    const d = leggiDati()
    if (!d) return
    // bot: finge di aver inviato senza fare nulla
    if (d.dati.get('sito')) {
      if (campi) campi.hidden = true
      if (esito) esito.hidden = false
      return
    }

    const r = creaRichiesta(d, 'email', infoTour.riepilogo ?? '')
    invia.disabled = true
    const testoInvia = invia.querySelector<HTMLElement>('#richiesta-invia-testo')
    if (testoInvia) testoInvia.textContent = 'Invio in corso…'
    try {
      const risposta = await fetch(`${r.url}/rest/v1/rpc/${r.funzione}`, { method: 'POST', headers: r.intestazioni, body: JSON.stringify(r.corpo) })
      if (!risposta.ok) {
        const corpo = await risposta.json().catch(() => null)
        throw new Error(corpo?.message ?? `Errore ${risposta.status}`)
      }
      const leadId = await risposta.json()
      // la richiesta e' gia' salvata: se l'invio delle e-mail dovesse fallire non lo mostriamo
      // al cliente (lo staff la vede comunque nel gestionale)
      fetch(`${r.url}/functions/v1/invia-richiesta-offerta`, {
        method: 'POST',
        headers: r.intestazioni,
        body: JSON.stringify({ leadId }),
      }).catch(() => {})
      ;(window as any).tracciaEvento?.('Lead', undefined, { email: d.dati.get('email'), telefono: d.dati.get('telefono'), nome: d.dati.get('nome'), cognome: d.dati.get('cognome') })
      modulo.reset()
      aggiornaPunti()
      if (etaBox) {
        etaBox.innerHTML = ''
        etaBox.hidden = true
      }
      if (campi) campi.hidden = true
      if (esito) esito.hidden = false
    } catch (err) {
      const msg = err instanceof Error ? err.message : ''
      mostraErrore(
        /e-mail non valida|almeno un|telefono non valido|troppe richieste/i.test(msg)
          ? msg
          : 'Non siamo riusciti a inviare la richiesta. Riprova tra poco oppure scrivici su WhatsApp.'
      )
    } finally {
      invia.disabled = false
      if (testoInvia) testoInvia.textContent = 'Invia via e-mail'
    }
  })
</script>

<style>
  /* l'attributo "hidden" deve nascondere davvero: i riquadri con display:grid lo ignoravano e la richiesta appariva gia' inviata */
  .richiesta :global([hidden]) {
    display: none !important;
  }

  .richiesta {
    border: none;
    border-radius: var(--raggio);
    padding: 0;
    width: min(26rem, calc(100vw - 1.5rem));
    max-height: calc(100vh - 2rem);
