---
// Filtri delle pagine con un elenco di strutture: "Cerca per testo" (con il tasto Cerca) e stelle.
// Filtrano la griglia gia' a schermo (data-griglia-strutture): la ricerca guarda nome, localita' e regione.
// `colonna` = nella colonna a sinistra (pagine di dettaglio); altrimenti in riga dentro la copertina.
interface Props {
  colonna?: boolean
  conStelle?: boolean
  collegamento?: { href: string; testo: string } | null
}
const { colonna = false, conStelle = true, collegamento = null } = Astro.props
---

<form class="filtri-elenco" class:list={{ 'filtri-elenco--colonna': colonna }} data-filtri-elenco role="search" aria-label="Cerca nell'elenco">
  <slot />
  {conStelle && (
    <label class="filtri-elenco__campo">
      <span>Stelle</span>
      <select name="stelle">
        <option value="">Tutte</option>
        <option value="3">3 stelle</option>
        <option value="4">4 stelle</option>
        <option value="5">5 stelle</option>
        <option value="6">6 stelle</option>
      </select>
    </label>
  )}
  <label class="filtri-elenco__online" data-filtro-online hidden>
    <input type="checkbox" name="online" />
    <span>Prenotabili online</span>
  </label>
  <label class="filtri-elenco__campo filtri-elenco__ricerca">
    <span>Cerca per testo</span>
    <span class="filtri-elenco__riga">
      <input type="search" name="testo" placeholder="Nome, località, regione..." autocomplete="off" />
      <button type="submit" class="filtri-elenco__cerca">Cerca</button>
    </span>
  </label>
  {!colonna ? (
    <div class="riga-azioni">
      <button type="reset">Azzera i filtri</button>
      <span class="esito" data-esito-elenco role="status" aria-live="polite"></span>
      {collegamento ? <a href={collegamento.href}>{collegamento.testo}</a> : <span></span>}
    </div>
  ) : (
    <p class="filtri-elenco__esito" data-esito-elenco role="status" aria-live="polite"></p>
  )}
</form>

<script>
  import { struttureConPrezzi } from '../lib/prenotaOnline'

  document.querySelectorAll<HTMLFormElement>('[data-filtri-elenco]').forEach(modulo => {
    const griglia = document.querySelector<HTMLElement>('[data-griglia-strutture]')
    const vuoto = document.querySelector<HTMLElement>('[data-griglia-vuoto]')
    const esito = modulo.querySelector<HTMLElement>('[data-esito-elenco]')
    if (!griglia) return
    const righe = [...griglia.querySelectorAll<HTMLLIElement>('li')]
    const normalizza = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')

    // selezioni che filtrano le strutture sul posto: <select data-filtra="sezione"> legge data-sezione di ogni scheda
    const selezioni = [...modulo.querySelectorAll<HTMLSelectElement>('select[data-filtra]')]
    const elencoOpzioni = new Map(selezioni.map(sel => [sel, [...sel.options].map(o => ({ valore: o.value, testo: o.textContent ?? '' }))]))
    const valoriDi = (riga: HTMLElement, campo: string) => (riga.dataset[campo] ?? '').split(' ').filter(Boolean)

    function passa(riga: HTMLLIElement, salta?: HTMLSelectElement) {
      const testo = normalizza(String((modulo.elements.namedItem('testo') as HTMLInputElement)?.value ?? '')).trim()
      const stelle = String((modulo.elements.namedItem('stelle') as HTMLSelectElement | null)?.value ?? '')
      if (stelle && riga.dataset.stelle !== stelle) return false
      // solo le strutture con prezzi di partenza (quelle con il nastro "Prenota online")
      if ((modulo.elements.namedItem('online') as HTMLInputElement | null)?.checked && riga.dataset.online !== '1') return false
      if (testo && !normalizza(riga.dataset.testo ?? '').includes(testo)) return false
      for (const sel of selezioni) {
        if (sel === salta || !sel.value) continue
        if (!valoriDi(riga, sel.dataset.filtra ?? '').includes(sel.value)) return false
      }
      return true
    }

    // a cascata: ogni selezione offre solo i valori che hanno ancora strutture con le altre scelte
    function aggiornaOpzioni() {
      for (const sel of selezioni) {
        const campo = sel.dataset.filtra ?? ''
        const ammessi = new Set(righe.filter(r => passa(r, sel)).flatMap(r => valoriDi(r, campo)))
        const scelto = sel.value
        sel.innerHTML = ''
        for (const o of elencoOpzioni.get(sel) ?? []) {
          if (o.valore !== '' && !ammessi.has(o.valore) && o.valore !== scelto) continue
          const opzione = document.createElement('option')
          opzione.value = o.valore
          opzione.textContent = o.testo
          sel.appendChild(opzione)
        }
        sel.value = scelto
      }
    }

    function applica() {
      let visibili = 0
      for (const riga of righe) {
        const ok = passa(riga)
        riga.hidden = !ok
        if (ok) visibili++
      }
      aggiornaOpzioni()
      const filtrato = righe.some(r => r.hidden)
      if (vuoto) vuoto.hidden = visibili > 0
      if (esito) esito.textContent = filtrato ? `${visibili} ${visibili === 1 ? 'struttura trovata' : 'strutture trovate'}` : ''
    }

    // il filtro compare solo se almeno una struttura dell'elenco ha i prezzi caricati
    const filtroOnline = modulo.querySelector<HTMLElement>('[data-filtro-online]')
    if (filtroOnline) {
      struttureConPrezzi().then(conPrezzi => {
        let n = 0
        for (const riga of righe) {
          const slug = riga.querySelector('a.scheda-struttura')?.getAttribute('href')?.split('/').filter(Boolean).pop()
          if (slug && conPrezzi.has(slug)) {
            riga.dataset.online = '1'
            n++
          }
        }
        if (n > 0) filtroOnline.hidden = false
      })
    }

    modulo.addEventListener('submit', e => {
      e.preventDefault()
      applica()
      griglia.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })
    modulo.addEventListener('input', applica)
    modulo.addEventListener('change', applica)
    modulo.addEventListener('reset', () => setTimeout(applica, 0))
  })
</script>

<style is:global>
  .filtri-elenco {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: center;
    gap: 0.75rem 1rem;
  }

  .filtri-elenco__campo {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--testo);
    min-width: 0;
  }

  .filtri-elenco__online {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--colore-primario-scuro);
    border-radius: 999px;
    background: var(--superficie);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--colore-primario-scuro);
    cursor: pointer;
    white-space: nowrap;
  }

  .filtri-elenco__online[hidden] {
    display: none;
  }

  .filtri-elenco__online input {
    accent-color: var(--colore-primario-scuro);
  }

  .filtri-elenco__ricerca {
    flex: 1 1 18rem;
    max-width: 28rem;
  }

  .filtri-elenco__riga {
    display: flex;
    gap: 0.5rem;
  }

  .filtri-elenco input[type='search'],
  .filtri-elenco select {
    font: inherit;
    font-size: 0.92rem;
    padding: 0.55em 0.75em;
    border: 1px solid var(--bordo);
    border-radius: var(--raggio-piccolo);
    background: var(--superficie);
    color: var(--inchiostro);
    min-width: 0;
  }

  .filtri-elenco input[type='search'] {
    flex: 1;
  }

  .filtri-elenco__cerca {
    font: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    padding: 0.55em 1.3em;
    border: none;
    border-radius: var(--raggio-piccolo);
    background: var(--accento);
    color: #fff;
    cursor: pointer;
  }

  .filtri-elenco__cerca:hover {
    background: var(--accento-scuro);
  }

  .filtri-elenco__esito {
    flex-basis: 100%;
    text-align: center;
    margin: 0;
    font-size: 0.85rem;
    color: var(--testo-tenue);
  }

  .filtri-elenco__esito:empty {
    display: none;
  }

  /* dentro la copertina: tre colonne, la ricerca per testo sotto a tutta riga */
  .copertina__pannello .filtri-elenco:not(.filtri-elenco--colonna) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem 0.75rem;
    align-items: end;
  }

  .copertina__pannello .filtri-elenco:not(.filtri-elenco--colonna) .filtri-elenco__ricerca {
    grid-column: 1 / -1;
    max-width: none;
  }

  .copertina__pannello .filtri-elenco:not(.filtri-elenco--colonna) .filtri-elenco__esito {
    grid-column: 1 / -1;
  }

  /* nella colonna a sinistra: un campo sotto l'altro */
  .filtri-elenco--colonna {
    flex-direction: column;
    align-items: stretch;
  }

  .filtri-elenco--colonna .filtri-elenco__ricerca {
    flex: none;
    max-width: none;
  }
</style>
