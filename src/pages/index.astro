---
import BaseLayout from '../layouts/BaseLayout.astro'
import GrigliaStrutture from '../components/GrigliaStrutture.astro'
import FiltroSezioni from '../components/FiltroSezioni.astro'
import SlideshowHome from '../components/SlideshowHome.astro'
import { getSlideshow, getStruttureElenco, getDestinazioniPerCategoria, getTipologieStruttura } from '../lib/queries'

const strutture = await getStruttureElenco()
const slide = await getSlideshow('home')
const categorie = await getDestinazioniPerCategoria()
const tipologie = await getTipologieStruttura()
const urlCanonica = new URL('/', Astro.site).toString()
---

<BaseLayout
  titolo="Hotellando | Villaggi e strutture selezionate"
  descrizione="Villaggi turistici e strutture ricettive selezionate da Hotellando, con schede dettagliate su spiaggia, camere, formula e prezzi."
  urlCanonica={urlCanonica}
>
  <SlideshowHome slide={slide} />

  <main class="contenitore pagina-home">
    {categorie.length > 0 && (
      <section class="esplora">
        <h2 class="esplora__titolo">Esplora per sezione</h2>
        <FiltroSezioni categorie={categorie} />
      </section>
    )}

    {tipologie.length > 0 && (
      <section class="esplora">
        <h2 class="esplora__titolo">Esplora per tipologia</h2>
        <nav class="esplora__pillole" aria-label="Tipologie di struttura">
          {tipologie.map(t => <a class="pillola" href={`/strutture/${t.slug}/`}>{t.nome}</a>)}
        </nav>
      </section>
    )}

    <h2 class="pagina-home__titolo" id="strutture">Tutte le strutture</h2>
    <GrigliaStrutture strutture={strutture} />
  </main>
</BaseLayout>

<style>
  .apertura {
    position: relative;
    padding: 4.5rem 0;
    overflow: hidden;
  }

  .apertura__sfondo {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, color-mix(in srgb, var(--colore-primario-scuro-hover) 85%, transparent), color-mix(in srgb, var(--colore-primario-scuro) 55%, transparent));
  }

  .apertura__foto {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .apertura__interno {
    position: relative;
  }

  .apertura__interno h1 {
    font-size: clamp(2.25rem, 1.7rem + 2.5vw, 3.5rem);
    margin-bottom: 0.75rem;
    color: #fff;
  }

  .apertura__interno p {
    color: rgba(255, 255, 255, 0.92);
    max-width: 34rem;
    font-size: 1.1rem;
    margin: 0;
  }

  .pagina-home {
    padding-block: 2rem 4rem;
  }

  .esplora {
    margin-bottom: 2rem;
  }

  .esplora__titolo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--testo-tenue);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.75rem;
  }

  .esplora__pillole {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .esplora__pillole .pillola {
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .esplora__pillole .pillola:hover {
    background: var(--colore-primario-scuro);
    color: #fff;
  }

  .pagina-home__titolo {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    margin: 2.5rem 0 1.5rem;
  }
</style>
