---
import BaseLayout from '../layouts/BaseLayout.astro'
import GrigliaStrutture from '../components/GrigliaStrutture.astro'
import FiltroSezioni from '../components/FiltroSezioni.astro'
import { getAzienda, getCopertinaHomepage, getStruttureElenco, getDestinazioniPerCategoria, getTipologieStruttura } from '../lib/queries'

const strutture = await getStruttureElenco()
const azienda = await getAzienda()
const copertine = await getCopertinaHomepage()
const categorie = await getDestinazioniPerCategoria()
const tipologie = await getTipologieStruttura()
// Finche' nel gestionale non viene caricata almeno una foto di copertina,
// resta questa di riserva (una foto reale gia' in uso altrove sul sito).
const foto = copertine.length > 0 ? copertine : ['https://www.schemavacanze.it/gallery/17595.jpg']
const slideshow = Boolean(azienda?.slideshow_copertina_attivo) && foto.length > 1

const urlCanonica = new URL('/', Astro.site).toString()
---

<BaseLayout
  titolo="Hotellando | Villaggi e strutture selezionate"
  descrizione="Villaggi turistici e strutture ricettive selezionate da Hotellando, con schede dettagliate su spiaggia, camere, formula e prezzi."
  urlCanonica={urlCanonica}
>
  <section class="apertura" data-slideshow={slideshow ? 'true' : 'false'}>
    {foto.map((url, i) => (
      <div class="apertura__foto" style={`background-image: url('${url}'); opacity: ${i === 0 ? 1 : 0};`} />
    ))}
    <div class="apertura__sfondo"></div>
    <div class="contenitore apertura__interno">
      <h1>Villaggi selezionati, prenotazione facile.</h1>
      <p>Ogni scheda riporta solo dati verificati dalla nostra agenzia: spiaggia, camere, formula e prezzi, mai stimati.</p>
    </div>
  </section>

  <main class="contenitore pagina-home">
    {categorie.length > 0 && (
      <section class="esplora">
        <h2 class="esplora__titolo">Esplora per sezione</h2>
        <FiltroSezioni categorie={categorie} />
      </section>
    )}

    {tipologie.length > 0 && (
      <section class="esplora">
        <h2 class="esplora__titolo">Esplora per tipologia</h2>
        <nav class="esplora__pillole" aria-label="Tipologie di struttura">
          {tipologie.map(t => <a class="pillola" href={`/strutture/${t.slug}/`}>{t.nome}</a>)}
        </nav>
      </section>
    )}

    <h2 class="pagina-home__titolo" id="strutture">Tutte le strutture</h2>
    <GrigliaStrutture strutture={strutture} />
  </main>
</BaseLayout>

{slideshow && (
  <script>
    const apertura = document.querySelector('.apertura[data-slideshow="true"]')
    const foto = apertura?.querySelectorAll<HTMLElement>('.apertura__foto')
    if (foto && foto.length > 1) {
      let indice = 0
      setInterval(() => {
        foto[indice].style.opacity = '0'
        indice = (indice + 1) % foto.length
        foto[indice].style.opacity = '1'
      }, 5000)
    }
  </script>
)}

<style>
  .apertura {
    position: relative;
    padding: 4.5rem 0;
    overflow: hidden;
  }

  .apertura__sfondo {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, color-mix(in srgb, var(--colore-primario-scuro-hover) 85%, transparent), color-mix(in srgb, var(--colore-primario-scuro) 55%, transparent));
  }

  .apertura__foto {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .apertura__interno {
    position: relative;
  }

  .apertura__interno h1 {
    font-size: clamp(2.25rem, 1.7rem + 2.5vw, 3.5rem);
    margin-bottom: 0.75rem;
    color: #fff;
  }

  .apertura__interno p {
    color: rgba(255, 255, 255, 0.92);
    max-width: 34rem;
    font-size: 1.1rem;
    margin: 0;
  }

  .pagina-home {
    padding: 3rem 0 4rem;
  }

  .esplora {
    margin-bottom: 2rem;
  }

  .esplora__titolo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--testo-tenue);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.75rem;
  }

  .esplora__pillole {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .esplora__pillole .pillola {
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .esplora__pillole .pillola:hover {
    background: var(--colore-primario-scuro);
    color: #fff;
  }

  .pagina-home__titolo {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    margin: 2.5rem 0 1.5rem;
  }
</style>
