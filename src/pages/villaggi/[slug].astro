---
import BaseLayout from '../../layouts/BaseLayout.astro'
import JsonLd from '../../components/JsonLd.astro'
import IconaServizio from '../../components/IconaServizio.astro'
import { getAzienda, getOffertaStruttura, getSlugStruttureAttive, getStrutturaCompleta } from '../../lib/queries'
import {
  ETICHETTA_FORMULA,
  ETICHETTA_SPIAGGIA_TIPO,
  annoDaPrezzi,
  formattaPeriodo,
  prezzoMinimo,
  tabellaPrezzi,
  etichettaRiduzione,
  troncaConEllissi,
  righeDaTesto,
  soloNumeri,
  slugifica,
} from '../../lib/formato'
import { etichettaSezione, pluraleCamera } from '../../lib/etichette'

export async function getStaticPaths() {
  const slug = await getSlugStruttureAttive()
  return slug.map(s => ({ params: { slug: s } }))
}

const { slug } = Astro.params
const dati = await getStrutturaCompleta(slug as string)
if (!dati) return Astro.redirect('/404')
const { struttura, servizi, serviziPerCategoria, animaliAmmessi, animazione, spiaggiaPrivata, serviziBambini, camere, prezzi, riduzioni, galleria } = dati
const azienda = await getAzienda()
const offerta = await getOffertaStruttura(struttura.slug)

const anno = annoDaPrezzi(prezzi)
const prezzoDa = prezzoMinimo(prezzi.map(p => ({ prezzo_notte: p.prezzo_notte, prezzo_manuale: p.prezzo_manuale })))
const righeTabellaPrezzi = tabellaPrezzi(prezzi)

const etichetteExtra = struttura.tipologie_struttura?.etichette_extra as Record<string, string> | null | undefined
const etichettaCamera = struttura.tipologie_struttura?.etichetta_camera || 'Camera'
const etichettaCamerePlurale = pluraleCamera(etichettaCamera)

const localitaBreve = [struttura.localita, struttura.provincia].filter(Boolean).join(', ')
const localitaOTipologia = struttura.localita ?? struttura.regione ?? struttura.tipologie_struttura?.nome ?? ''
let titolo = localitaOTipologia ? `${struttura.nome} | ${localitaOTipologia}` : struttura.nome
if (anno) titolo += ` – Offerte ${anno}`
titolo = troncaConEllissi(titolo, 60)

const bimbiGratis = riduzioni.some(r => r.tipo_riduzione === 'gratuito')
let descrizione = struttura.seo_meta_description
if (!descrizione) {
  const pezzi = [struttura.nome]
  if (struttura.formula) pezzi.push(ETICHETTA_FORMULA[struttura.formula] ?? struttura.formula)
  if (struttura.localita) pezzi.push(`a ${struttura.localita}`)
  if (struttura.distanza_spiaggia_km != null) pezzi.push(`a ${struttura.distanza_spiaggia_km} km dal mare`)
  if (bimbiGratis) pezzi.push('bimbi gratis')
  descrizione = pezzi.join(', ') + '.'
}
descrizione = troncaConEllissi(descrizione, 155)

const urlCanonica = new URL(`/villaggi/${struttura.slug}/`, Astro.site).toString()
const urlDestinazione = struttura.destinazioni?.slug
  ? new URL(`/destinazioni/${struttura.destinazioni.slug}/`, Astro.site).toString()
  : null

const distanze = [
  struttura.distanza_spiaggia_km != null && `spiaggia a ${struttura.distanza_spiaggia_km} km`,
  struttura.distanza_centro_km != null && `centro a ${struttura.distanza_centro_km} km`,
  struttura.aeroporto_nome && `aeroporto di ${struttura.aeroporto_nome}${struttura.aeroporto_distanza_km != null ? ` a ${struttura.aeroporto_distanza_km} km` : ''}`,
].filter(Boolean) as string[]

const testoDescrizione = struttura.descrizione_seo || struttura.descrizione
const haDescrizione = Boolean(testoDescrizione)
// Link diretto (se incollato nel gestionale) oppure ricavato dalle coordinate:
// stessa logica di EditStrutturaForm ("Vedi su Google Maps").
const mapUrl =
  struttura.link_google_maps ||
  (struttura.latitudine != null && struttura.longitudine != null
    ? `https://www.google.com/maps?q=${struttura.latitudine},${struttura.longitudine}`
    : null)
const haPosizioneOSpiaggia = Boolean(
  struttura.indirizzo || struttura.descrizione_spiaggia || struttura.spiaggia_tipo || distanze.length > 0 || mapUrl
)
const haCamere = camere.length > 0 || Boolean(struttura.descrizione_camere)
const haServizi = serviziPerCategoria.length > 0
const haRistorazione = Boolean(
  struttura.formula || struttura.descrizione_ristorazione || struttura.incluso || struttura.non_incluso || struttura.tessera_club
)
const haCaratteristicheTecniche = Boolean(struttura.caratteristiche_tecniche)
const haIntrattenimento = Boolean(struttura.descrizione_intrattenimento)
const haAnimazioneBambini = Boolean(
  animazione || struttura.miniclub_eta_min != null || struttura.miniclub_eta_max != null || animaliAmmessi
)
const haPrezzi = righeTabellaPrezzi.length > 0 || riduzioni.length > 0
const haDaVisitare = Boolean(struttura.da_visitare)
const haInformazioniImportanti = Boolean(struttura.informazioni_importanti)
const haFaq = Array.isArray(struttura.faq) && struttura.faq.length > 0
const haVirtualTour = Boolean(struttura.link_virtual_tour)

const etichettaDaVisitare = etichettaSezione('da_visitare', etichetteExtra)

const sezioniTab = [
  offerta && { id: 'offerta', etichetta: 'Offerta' },
  haDescrizione && { id: 'descrizione', etichetta: 'Descrizione' },
  haCaratteristicheTecniche && { id: 'caratteristiche', etichetta: 'Caratteristiche' },
  haPosizioneOSpiaggia && { id: 'posizione', etichetta: 'Posizione' },
  haCamere && { id: 'camere', etichetta: etichettaCamerePlurale },
  haServizi && { id: 'servizi', etichetta: 'Servizi' },
  haRistorazione && { id: 'formula', etichetta: 'Formula' },
  haIntrattenimento && { id: 'intrattenimento', etichetta: 'Intrattenimento' },
  haAnimazioneBambini && { id: 'animazione', etichetta: 'Bambini' },
  haPrezzi && { id: 'prezzi', etichetta: 'Prezzi' },
  haDaVisitare && { id: 'dintorni', etichetta: etichettaDaVisitare },
  haInformazioniImportanti && { id: 'informazioni', etichetta: 'Informazioni utili' },
  haFaq && { id: 'faq', etichetta: 'FAQ' },
  haVirtualTour && { id: 'virtual-tour', etichetta: 'Virtual tour' },
].filter((s): s is { id: string; etichetta: string } => Boolean(s))
---

<BaseLayout titolo={titolo} descrizione={descrizione} urlCanonica={urlCanonica} immagine={galleria[0] ?? null}>
  <Fragment slot="head-extra">
    <JsonLd
      struttura={struttura}
      azienda={azienda}
      servizi={servizi}
      animaliAmmessi={animaliAmmessi}
      prezzoMinimo={prezzoDa}
      urlPagina={urlCanonica}
      urlDestinazione={urlDestinazione}
      galleria={galleria}
    />
  </Fragment>

  <header class="testata">
    <div class="contenitore testata__interno">
      <nav class="briciole" aria-label="Percorso">
        <a href="/">Home</a>
        {struttura.tipologie_struttura?.nome && (
          <>
            <span aria-hidden="true">/</span>
            <a href={`/strutture/${slugifica(struttura.tipologie_struttura.nome)}/`}>{struttura.tipologie_struttura.nome}</a>
          </>
        )}
        {struttura.destinazioni && (
          <>
            <span aria-hidden="true">/</span>
            <a href={`/destinazioni/${struttura.destinazioni.slug}/`}>{struttura.destinazioni.nome}</a>
          </>
        )}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{struttura.nome}</span>
      </nav>

      {struttura.catena && <span class="pillola testata__catena">{struttura.catena}</span>}

      <h1 class="testata__titolo">{struttura.nome}</h1>

      {(localitaBreve || struttura.stelle) && (
        <p class="testata__sottotitolo">
          {localitaBreve}
          {localitaBreve && struttura.stelle && <span aria-hidden="true"> · </span>}
          {struttura.stelle && <span class="testata__stelle">{'★'.repeat(struttura.stelle)}</span>}
        </p>
      )}

      {prezzoDa != null && (
        <p class="testata__prezzo">
          Da <strong>{prezzoDa}€</strong> <span>a notte</span>
        </p>
      )}
    </div>
  </header>

  {galleria.length > 0 && (
    <section class="galleria" aria-label="Galleria fotografica">
      <div class="contenitore">
        <div class="slideshow" data-slideshow>
          <button type="button" class="slideshow__immagine-link" data-apri-lightbox-corrente aria-label={`Apri la foto a schermo intero`}>
            <img class="slideshow__immagine" id="slideshow-immagine" src={galleria[0]} alt={struttura.nome} loading="eager" />
          </button>
          {galleria.length > 1 && (
            <>
              <button type="button" class="slideshow__freccia slideshow__freccia--sinistra" data-slideshow-prev aria-label="Foto precedente">‹</button>
              <button type="button" class="slideshow__freccia slideshow__freccia--destra" data-slideshow-next aria-label="Foto successiva">›</button>
              <p class="slideshow__contatore" id="slideshow-contatore" aria-hidden="true">1 / {galleria.length}</p>
            </>
          )}
        </div>

        {galleria.length > 1 && (
          <div class="galleria__striscia" role="tablist" aria-label="Miniature galleria">
            {galleria.map((url, i) => (
              <button
                type="button"
                class={`galleria__miniatura${i === 0 ? ' è-attiva' : ''}`}
                data-slideshow-vai={i}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`Vai alla foto ${i + 1}`}
              >
                <img src={url} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>
    </section>

    <div class="lightbox" id="lightbox" hidden>
      <script type="application/json" id="lightbox-dati" set:html={JSON.stringify(galleria)} />
      <button type="button" class="lightbox__chiudi" data-chiudi-lightbox aria-label="Chiudi galleria">✕</button>
      <button type="button" class="lightbox__freccia lightbox__freccia--sinistra" data-lightbox-prev aria-label="Foto precedente">‹</button>
      <img class="lightbox__immagine" id="lightbox-immagine" src="" alt={`Foto di ${struttura.nome}`} />
      <button type="button" class="lightbox__freccia lightbox__freccia--destra" data-lightbox-next aria-label="Foto successiva">›</button>
      <p class="lightbox__contatore" id="lightbox-contatore"></p>
    </div>
  )}

  {sezioniTab.length > 1 && (
    <nav class="tab-sezioni" aria-label="Sezioni della pagina">
      <div class="contenitore">
        <div class="tab-sezioni__interno" role="tablist">
          {sezioniTab.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${s.id}`}
              aria-controls={s.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              class={i === 0 ? 'è-attiva' : ''}
              data-tab-target={s.id}
            >
              {s.etichetta}
            </button>
          ))}
        </div>
      </div>
    </nav>
  )}

  <main class="contenitore">
    {offerta && (
      <section class="sezione offerta-struttura" id="offerta">
        <h2 class="sezione__titolo">{offerta.titolo}</h2>
        <div class="offerta-struttura__dettagli">
          {offerta.checkIn && offerta.checkOut && <span>{formattaPeriodo(offerta.checkIn, offerta.checkOut)}</span>}
          {offerta.notti && <span>{offerta.notti} notti</span>}
          {offerta.trattamento && <span>{offerta.trattamento}</span>}
        </div>
        {offerta.prezzoDa != null && (
          <p class="offerta-struttura__prezzo">
            da <strong>{offerta.prezzoDa}€</strong> <span>a persona</span>
          </p>
        )}
        {azienda?.numero_whatsapp && (
          <a class="pulsante" href={`https://wa.me/39${soloNumeri(azienda.numero_whatsapp)}?text=${encodeURIComponent(`Ciao, sono interessato all'offerta "${offerta.titolo}"`)}`} target="_blank" rel="noopener">
            Richiedi questa offerta
          </a>
        )}
      </section>
    )}

    {haDescrizione && (
      <section class="sezione" id="descrizione">
        <h2 class="sezione__titolo">Descrizione</h2>
        <p class="testo-descrizione">{testoDescrizione}</p>
      </section>
    )}

    {haCaratteristicheTecniche && (
      <section class="sezione" id="caratteristiche">
        <h2 class="sezione__titolo">{etichettaSezione('caratteristiche_tecniche', etichetteExtra)}</h2>
        <p class="testo-caratteristiche">{struttura.caratteristiche_tecniche}</p>
      </section>
    )}

    {haPosizioneOSpiaggia && (
      <section class="sezione" id="posizione">
        <h2 class="sezione__titolo">Posizione e spiaggia</h2>
        {struttura.indirizzo && <p>{struttura.indirizzo}{localitaBreve ? `, ${localitaBreve}` : ''}</p>}
        {distanze.length > 0 && (
          <ul class="lista-fatti">
            {distanze.map(d => <li>{d}</li>)}
          </ul>
        )}
        {struttura.spiaggia_tipo && (
          <p>
            Spiaggia di {ETICHETTA_SPIAGGIA_TIPO[struttura.spiaggia_tipo] ?? struttura.spiaggia_tipo}
            {spiaggiaPrivata ? ', privata.' : '.'}
          </p>
        )}
        {struttura.descrizione_spiaggia && <p>{struttura.descrizione_spiaggia}</p>}
        {mapUrl && (
          <a class="banner-mappa" href={mapUrl} target="_blank" rel="noopener noreferrer">
            <span class="banner-mappa__icona" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            </span>
            <span class="banner-mappa__testo">
              <strong>Clicca e guarda la mappa</strong>
              <span>Dove si trova {struttura.nome}{localitaBreve ? `, ${localitaBreve}` : ''}</span>
            </span>
            <span class="banner-mappa__freccia" aria-hidden="true">→</span>
          </a>
        )}
      </section>
    )}

    {haCamere && (
      <section class="sezione" id="camere">
        <h2 class="sezione__titolo">{etichettaCamerePlurale}</h2>
        {struttura.descrizione_camere && <p>{struttura.descrizione_camere}</p>}
        {camere.length > 0 && (
          <div class="griglia-camere">
            {camere.map(c => (
              <article class="scheda-camera">
                {c.foto.length > 0 && (
                  <div class="scheda-camera__foto" class:list={{ 'scheda-camera__foto--multipla': c.foto.length > 1 }}>
                    {c.foto.map((url, i) => (
                      <img src={url} alt={i === 0 ? c.nome : ''} loading="lazy" />
                    ))}
                    {c.foto.length > 1 && <span class="scheda-camera__conteggio">{c.foto.length} foto</span>}
                  </div>
                )}
                <div class="scheda-camera__corpo">
                  <h3>{c.nome}</h3>
                  {c.capienza_max && <p class="scheda-camera__capienza">Fino a {c.capienza_max} persone</p>}
                  {c.note && <p>{c.note}</p>}
                </div>
              </article>
            ))}
          </div>
        )}
      </section>
    )}

    {haServizi && (
      <section class="sezione" id="servizi">
        <h2 class="sezione__titolo">Servizi</h2>
        <div class="griglia-servizi">
          {serviziPerCategoria.map(gruppo => (
            <div class="gruppo-servizi">
              <h3>{gruppo.categoria}</h3>
              <ul class="elenco-servizi">
                {gruppo.nomi.map(nome => (
                  <li>
                    <IconaServizio nome={nome} />
                    <span>{nome}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    {haRistorazione && (
      <section class="sezione" id="formula">
        <h2 class="sezione__titolo">Formula e ristorazione</h2>
        {struttura.formula && (
          <p class="formula-nome">{ETICHETTA_FORMULA[struttura.formula] ?? struttura.formula}</p>
        )}
        {struttura.descrizione_ristorazione && <p>{struttura.descrizione_ristorazione}</p>}
        {struttura.incluso && (
          <div class="blocco-incluso">
            <h3>Incluso</h3>
            <ul class="lista-fatti">
              {righeDaTesto(struttura.incluso).map(riga => <li>{riga}</li>)}
            </ul>
          </div>
        )}
        {struttura.non_incluso && (
          <div class="blocco-incluso">
            <h3>Non incluso</h3>
            <ul class="lista-fatti lista-fatti--escluso">
              {righeDaTesto(struttura.non_incluso).map(riga => <li>{riga}</li>)}
            </ul>
          </div>
        )}
        {struttura.tessera_club && (
          <details class="tessera-club">
            <summary>{struttura.tessera_club_inclusa ? 'Tessera club inclusa' : 'Tessera club (a pagamento)'}</summary>
            <p>{struttura.tessera_club}</p>
          </details>
        )}
      </section>
    )}

    {haIntrattenimento && (
      <section class="sezione" id="intrattenimento">
        <h2 class="sezione__titolo">{etichettaSezione('intrattenimento', etichetteExtra)}</h2>
        <p>{struttura.descrizione_intrattenimento}</p>
      </section>
    )}

    {haAnimazioneBambini && (
      <section class="sezione" id="animazione">
        <h2 class="sezione__titolo">Animazione e bambini</h2>
        <div class="riga-pillole">
          {animazione && <span class="pillola">Animazione diurna e serale</span>}
          {(struttura.miniclub_eta_min != null || struttura.miniclub_eta_max != null) && (
            <span class="pillola">Miniclub {struttura.miniclub_eta_min ?? 0}-{struttura.miniclub_eta_max ?? '—'} anni</span>
          )}
          {animaliAmmessi && <span class="pillola">Animali ammessi</span>}
        </div>
        {serviziBambini.length > 0 && (
          <ul class="lista-fatti lista-fatti--compatta">
            {serviziBambini.map(s => <li>{s}</li>)}
          </ul>
        )}
      </section>
    )}

    {haPrezzi && (
      <section class="sezione" id="prezzi">
        <h2 class="sezione__titolo">Prezzi e periodi</h2>
        {righeTabellaPrezzi.length > 0 && (
          <div class="tabella-scroll">
            <table>
              <thead>
                <tr>
                  <th scope="col">Tipologia</th>
                  <th scope="col">Trattamento</th>
                  <th scope="col">Periodo</th>
                  <th scope="col">Prezzo</th>
                </tr>
              </thead>
              <tbody>
                {righeTabellaPrezzi.map(r => (
                  <tr>
                    <td>{r.tipologia}</td>
                    <td>{r.trattamento ?? '—'}</td>
                    <td>{r.periodo}</td>
                    <td>{r.prezzo}€</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {riduzioni.length > 0 && (
          <ul class="lista-fatti">
            {riduzioni.map(r => (
              <li>{etichettaRiduzione(r.posizione_letto, r.eta_da, r.eta_a, r.tipo_riduzione, r.valore)}</li>
            ))}
          </ul>
        )}
      </section>
    )}

    {haDaVisitare && (
      <section class="sezione" id="dintorni">
        <h2 class="sezione__titolo">{etichettaDaVisitare}</h2>
        <p>{struttura.da_visitare}</p>
      </section>
    )}

    {haVirtualTour && (
      <section class="sezione" id="virtual-tour">
        <h2 class="sezione__titolo">Virtual tour</h2>
        <a class="banner-mappa" href={struttura.link_virtual_tour} target="_blank" rel="noopener noreferrer">
          <span class="banner-mappa__icona" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
              <circle cx="12" cy="12" r="3.2" />
            </svg>
          </span>
          <span class="banner-mappa__testo">
            <strong>Esplora {struttura.nome} in 360°</strong>
            <span>Apri il tour virtuale interattivo</span>
          </span>
          <span class="banner-mappa__freccia" aria-hidden="true">→</span>
        </a>
      </section>
    )}

    {haInformazioniImportanti && (
      <section class="sezione" id="informazioni">
        <h2 class="sezione__titolo">Informazioni utili</h2>
        <p class="testo-informazioni">{struttura.informazioni_importanti}</p>
      </section>
    )}

    {haFaq && (
      <section class="sezione" id="faq">
        <h2 class="sezione__titolo">Domande frequenti</h2>
        <div class="elenco-faq">
          {struttura.faq.map((voce: { domanda: string; risposta: string }) => (
            <details class="voce-faq">
              <summary>{voce.domanda}</summary>
              <p>{voce.risposta}</p>
            </details>
          ))}
        </div>
      </section>
    )}
    {struttura.data_aggiornamento_contenuti && (
      <p class="nota-aggiornamento">
        Contenuti aggiornati il {new Date(struttura.data_aggiornamento_contenuti).toLocaleDateString('it-IT')}
      </p>
    )}
  </main>
</BaseLayout>

<script>
  // Vere tab (come gbviaggi.it): un click cambia pannello sul posto, niente
  // scroll. Tutte le sezioni restano nel markup (crawler e AEO le leggono
  // comunque), solo quella attiva e' visibile.
  const bottoni = document.querySelectorAll<HTMLButtonElement>('[data-tab-target]')
  const pannelli = document.querySelectorAll<HTMLElement>('main > .sezione')

  function mostra(idAttivo: string) {
    pannelli.forEach(pannello => {
      pannello.hidden = pannello.id !== idAttivo
    })
    bottoni.forEach(bottone => {
      const attivo = bottone.dataset.tabTarget === idAttivo
      bottone.classList.toggle('è-attiva', attivo)
      bottone.setAttribute('aria-selected', String(attivo))
    })
  }

  bottoni.forEach(bottone => {
    bottone.addEventListener('click', () => {
      const id = bottone.dataset.tabTarget
      if (id) mostra(id)
    })
  })

  if (bottoni.length > 0) mostra(bottoni[0].dataset.tabTarget ?? '')
</script>

<script>
  // Slideshow compatto in pagina + lightbox a schermo intero: condividono lo
  // stesso elenco foto e lo stesso indice corrente, cosi' aprire il
  // lightbox riparte esattamente dalla foto che si stava guardando invece
  // che sempre dalla prima.
  const datiEl = document.getElementById('lightbox-dati')
  const foto: string[] = datiEl ? JSON.parse(datiEl.textContent ?? '[]') : []
  let indiceCorrente = 0

  const slideshowImmagineEl = document.getElementById('slideshow-immagine') as HTMLImageElement | null
  const slideshowContatoreEl = document.getElementById('slideshow-contatore')
  const miniature = document.querySelectorAll<HTMLElement>('[data-slideshow-vai]')

  const lightbox = document.getElementById('lightbox') as HTMLElement | null
  const immagineEl = document.getElementById('lightbox-immagine') as HTMLImageElement | null
  const contatoreEl = document.getElementById('lightbox-contatore')

  function vaiA(indice: number) {
    if (foto.length === 0) return
    indiceCorrente = (indice + foto.length) % foto.length

    if (slideshowImmagineEl) slideshowImmagineEl.src = foto[indiceCorrente]
    if (slideshowContatoreEl) slideshowContatoreEl.textContent = `${indiceCorrente + 1} / ${foto.length}`
    miniature.forEach((m, i) => {
      const attiva = i === indiceCorrente
      m.classList.toggle('è-attiva', attiva)
      m.setAttribute('aria-selected', String(attiva))
      if (attiva) m.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' })
    })

    if (immagineEl && contatoreEl) {
      immagineEl.src = foto[indiceCorrente]
      contatoreEl.textContent = `${indiceCorrente + 1} / ${foto.length}`
    }
  }

  // Slideshow automatico: in pausa al passaggio del mouse/focus, e mai
  // avviato se l'utente preferisce meno animazioni o c'e' una sola foto.
  const preferisceMenoAnimazioni = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  let timerAutoplay: number | null = null

  function avviaAutoplay() {
    if (preferisceMenoAnimazioni || foto.length < 2 || timerAutoplay != null) return
    timerAutoplay = window.setInterval(() => vaiA(indiceCorrente + 1), 5000)
  }

  function fermaAutoplay() {
    if (timerAutoplay != null) {
      window.clearInterval(timerAutoplay)
      timerAutoplay = null
    }
  }

  const slideshowEl = document.querySelector<HTMLElement>('[data-slideshow]')
  slideshowEl?.addEventListener('mouseenter', fermaAutoplay)
  slideshowEl?.addEventListener('mouseleave', avviaAutoplay)
  slideshowEl?.addEventListener('focusin', fermaAutoplay)
  slideshowEl?.addEventListener('focusout', avviaAutoplay)
  avviaAutoplay()

  slideshowEl?.querySelector('[data-slideshow-prev]')?.addEventListener('click', () => vaiA(indiceCorrente - 1))
  slideshowEl?.querySelector('[data-slideshow-next]')?.addEventListener('click', () => vaiA(indiceCorrente + 1))
  miniature.forEach(m => {
    m.addEventListener('click', () => vaiA(Number(m.dataset.slideshowVai)))
  })

  // Scorrimento con lo swipe su mobile.
  let toccoX: number | null = null
  slideshowEl?.addEventListener('touchstart', evento => { toccoX = evento.touches[0]?.clientX ?? null }, { passive: true })
  slideshowEl?.addEventListener('touchend', evento => {
    if (toccoX == null) return
    const delta = (evento.changedTouches[0]?.clientX ?? toccoX) - toccoX
    if (Math.abs(delta) > 40) vaiA(indiceCorrente + (delta < 0 ? 1 : -1))
    toccoX = null
  })

  function apri(indice: number) {
    if (!lightbox) return
    fermaAutoplay()
    vaiA(indice)
    lightbox.hidden = false
    document.body.style.overflow = 'hidden'
  }

  function chiudi() {
    if (!lightbox) return
    lightbox.hidden = true
    document.body.style.overflow = ''
    avviaAutoplay()
  }

  document.querySelector('[data-apri-lightbox-corrente]')?.addEventListener('click', () => apri(indiceCorrente))
  lightbox?.querySelector('[data-chiudi-lightbox]')?.addEventListener('click', chiudi)
  lightbox?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => vaiA(indiceCorrente - 1))
  lightbox?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => vaiA(indiceCorrente + 1))
  lightbox?.addEventListener('click', evento => {
    if (evento.target === lightbox) chiudi()
  })
  document.addEventListener('keydown', evento => {
    if (!lightbox || lightbox.hidden) return
    if (evento.key === 'Escape') chiudi()
    if (evento.key === 'ArrowLeft') vaiA(indiceCorrente - 1)
    if (evento.key === 'ArrowRight') vaiA(indiceCorrente + 1)
  })
</script>

