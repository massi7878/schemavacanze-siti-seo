---
// Vecchio indirizzo delle schede struttura (/villaggi/<nome>/): ora sono /struttura/<nome>/.
// Il rimando e' permanente (301) e vale con e senza "/" finale, cosi' i link gia' condivisi
// e quelli indicizzati da Google continuano a funzionare.
export const prerender = false
const { slug } = Astro.params
return Astro.redirect(`/struttura/${slug}/`, 301)
---
