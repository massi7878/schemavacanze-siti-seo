---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ModelloClassico from '../../components/tour/ModelloClassico.astro'
import ModelloSofly from '../../components/tour/ModelloSofly.astro'
import { getAzienda } from '../../lib/queries'
import { descrizioneTour, grafoTour, titoloTour } from '../../lib/seoTour'
import { getTourPubblico } from '../../lib/tour'
import { getPaeseTour } from '../../lib/tourPaesi'
import PaginaPaese from '../../components/tour/PaginaPaese.astro'
import { MODELLI_VALIDI, datiPaginaTour } from '../../lib/tourPagina'

// Pagina generata al momento della richiesta e tenuta in cache da Vercel per poco: un tour o una
// partenza modificati nel gestionale compaiono entro ~1 minuto senza ripubblicare il sito.
export const prerender = false

const { slug } = Astro.params
const t = await getTourPubblico(slug as string)
// non e' un tour: puo' essere la pagina di un paese (es. /tour/kenya/); altrimenti (tour non piu' attivo o
// indirizzo sbagliato) si torna all'elenco
const paese = t ? null : await getPaeseTour(slug as string)
if (!t && !paese) return Astro.redirect('/tour/', 302)
if (paese) Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600')

let anteprima: string | null = null
let modello = 'classico'
let d: ReturnType<typeof datiPaginaTour> | null = null
let titolo = ''
let descrizione = ''
let urlCanonica = ''
let grafo: unknown = null

if (t) {
  // Modello di pagina: scelto nel gestionale (per tour o predefinito). Con ?modello=sofly si vede
  // l'anteprima di un altro modello (utile per confrontarli): in quel caso niente cache.
  const richiesto = Astro.url.searchParams.get('modello')
  anteprima = richiesto && (MODELLI_VALIDI as readonly string[]).includes(richiesto) ? richiesto : null
  modello = anteprima ?? (t as unknown as { modello?: string }).modello ?? 'classico'
  Astro.response.headers.set('Cache-Control', anteprima ? 'no-store' : 'public, s-maxage=60, stale-while-revalidate=600')

  const azienda = await getAzienda()
  urlCanonica = new URL(`/tour/${t.slug}/`, Astro.site).toString()
  d = datiPaginaTour(t, azienda, urlCanonica)

  // titolo, descrizione e dati strutturati nascono dai dati del tour (paese, durata, tipo, guida, tappe, prezzo, partenze);
  // un titolo o una descrizione scritti a mano nel gestionale hanno la precedenza
  titolo = titoloTour(t, d.prezzoMin)
  descrizione = descrizioneTour(t, d.prezzoMin, d.paesi)
  grafo = grafoTour({ t, url: urlCanonica, titolo, descrizione, immagini: d.immagini, prezzoMin: d.prezzoMin, paesi: d.paesi, azienda, sito: Astro.site })
}
---

{paese ? (
  <PaginaPaese paese={paese} />
) : t && d ? (
  <BaseLayout titolo={titolo} descrizione={descrizione} urlCanonica={urlCanonica} immagine={d.copertina}>
    <script type="application/ld+json" set:html={JSON.stringify(grafo)} />
    {!anteprima && <script is:inline define:vars={{ nome: t.nome, prezzo: d.prezzoMin }}>document.addEventListener('DOMContentLoaded', function () { window.tracciaEvento && window.tracciaEvento('ViewContent', { content_name: nome, content_type: 'product', value: prezzo || 0, currency: 'EUR' }) })</script>}
    {anteprima && <meta name="robots" content="noindex" />}
    {modello === 'sofly' ? <ModelloSofly d={d} /> : <ModelloClassico d={d} />}
  </BaseLayout>
) : null}
