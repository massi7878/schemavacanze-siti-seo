---
import BaseLayout from '../../layouts/BaseLayout.astro'
import GrigliaStrutture from '../../components/GrigliaStrutture.astro'
import FiltroDestinazioni from '../../components/FiltroDestinazioni.astro'
import { getGerarchiaRegioniDestinazioni, getRegioni, getStruttureRegione } from '../../lib/queries'

export async function getStaticPaths() {
  const regioni = await getRegioni()
  return regioni.map(r => ({ params: { regione: r.slug } }))
}

const { regione: regioneSlug } = Astro.params
const { regione, strutture } = await getStruttureRegione(regioneSlug as string)
if (!regione) return Astro.redirect('/404')

// Il filtro esiste solo se questa regione ha anche una gerarchia di
// destinazioni vere e proprie (solo "Mare Italia": Abruzzo, Lazio, Trentino
// ecc. sono regioni testuali senza destinazioni collegate). Lo slug usato
// nel filtro e' quello della tabella destinazioni, non quello testuale di
// /regione/ (generati separatamente, potrebbero non coincidere).
const gerarchiaRegioni = await getGerarchiaRegioniDestinazioni()
const regioneNellaGerarchia = gerarchiaRegioni.find(r => r.nome === regione.nome) ?? null

const urlCanonica = new URL(`/regione/${regione.slug}/`, Astro.site).toString()
const titolo = `Villaggi in ${regione.nome} | Hotellando`
const descrizione = `${strutture.length} strutture selezionate in ${regione.nome}: villaggi e resort con schede su spiaggia, camere, formula e prezzi.`
---

<BaseLayout titolo={titolo} descrizione={descrizione} urlCanonica={urlCanonica}>
  <section class="apertura">
    <div class="contenitore apertura__interno">
      <nav class="briciole" aria-label="Percorso">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{regione.nome}</span>
      </nav>
      <h1>Villaggi in {regione.nome}</h1>
      <p>{strutture.length} strutture selezionate, con schede su spiaggia, camere, formula e prezzi.</p>
    </div>
  </section>

  <main class="contenitore pagina-elenco" class:list={{ 'pagina-elenco--con-filtro': regioneNellaGerarchia }}>
    {regioneNellaGerarchia && (
      <FiltroDestinazioni
        regioni={gerarchiaRegioni}
        regioneSlugAttuale={regioneNellaGerarchia.slug}
        destinazioneSlugAttuale={null}
        prefissoRegione="/regione/"
      />
    )}
    <div class="pagina-elenco__risultati">
      <GrigliaStrutture strutture={strutture} />
    </div>
  </main>
</BaseLayout>

<style>
  .apertura {
    padding: 2rem 0 2.5rem;
  }

  .briciole {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--testo-tenue);
    margin-bottom: 1.25rem;
  }

  .briciole a {
    color: var(--testo-tenue);
    text-decoration: none;
  }

  .briciole a:hover {
    color: var(--colore-primario-scuro);
  }

  .apertura__interno h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .apertura__interno p {
    color: var(--testo);
    margin: 0;
  }

  .pagina-elenco {
    padding: 1rem 0 4rem;
  }

  .pagina-elenco--con-filtro {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .pagina-elenco__risultati {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .pagina-elenco--con-filtro {
      flex-direction: row;
      align-items: flex-start;
      gap: 2.5rem;
    }

    .pagina-elenco--con-filtro > :global(.filtro-destinazioni) {
      flex: 0 0 15rem;
      position: sticky;
      top: 1.5rem;
    }

    .pagina-elenco__risultati {
      flex: 1;
    }
  }
</style>
