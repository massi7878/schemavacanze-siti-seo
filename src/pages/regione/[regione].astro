---
import { getRegioni, getGerarchiaRegioniDestinazioni } from '../../lib/queries'

export async function getStaticPaths() {
  const regioni = await getRegioni()
  return regioni.map(r => ({ params: { regione: r.slug } }))
}

// /regione/ (derivata dal campo di testo strutture.regione) duplicava
// /destinazioni/ (derivata dalla tabella destinazioni relazionale): stesso
// contenuto raggiungibile da due indirizzi diversi, un sistema di geografia
// separato da tutto il resto del sito. Non era linkata da nessuna pagina
// (nemmeno dalla sitemap): un ramo morto, non un percorso in uso. Consolidata
// qui con un redirect verso la pagina /destinazioni/ corrispondente per nome
// (o verso la sezione Mare Italia se non se ne trova una — /regione/ era
// comunque solo Mare Italia), cosi' un vecchio link/preferito non trova un
// 404 ma arriva comunque a contenuto vero.
const { regione: regioneSlug } = Astro.params
const regioni = await getRegioni()
const regione = regioni.find(r => r.slug === regioneSlug) ?? null

const gerarchiaRegioni = await getGerarchiaRegioniDestinazioni('Mare Italia')
const destinazioneCorrispondente = regione ? gerarchiaRegioni.find(r => r.nome === regione.nome) : null
const urlDestinazione = destinazioneCorrispondente ? `/destinazioni/${destinazioneCorrispondente.slug}/` : '/categoria/mare-italia/'
const urlAssoluta = new URL(urlDestinazione, Astro.site).toString()
const nomeDestinazione = destinazioneCorrispondente?.nome ?? 'Mare Italia'
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${urlDestinazione}`} />
    <link rel="canonical" href={urlAssoluta} />
    <meta name="robots" content="noindex" />
    <title>Hotellando — Pagina spostata</title>
  </head>
  <body>
    <p>Questa pagina si è spostata. <a href={urlDestinazione}>Vai a {nomeDestinazione}</a>.</p>
  </body>
</html>
