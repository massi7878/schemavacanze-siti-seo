---
// Schermo vetrina in agenzia: slideshow fullscreen a rotazione automatica
// delle sole offerte marcate offerte.vetrina=true (scelte dall'operatore nel
// form offerta del gestionale, vedi EditOffertaForm/NewOffertaForm). Il sito
// e' statico (astro.config.mjs -> output: 'static'), quindi oltre ai dati
// pre-renderizzati al build per il primo caricamento veloce, uno script
// ricontrolla periodicamente Supabase via REST pubblica (stessa chiave anon
// gia' usata per il resto del sito) cosi' lo schermo si aggiorna da solo
// quando in negozio si aggiunge/rimuove un'offerta, senza dover ribuildare.
import TvLayout from '../../layouts/TvLayout.astro'
import { getAzienda, getOfferteVetrina } from '../../lib/queries'

const azienda = await getAzienda()
const offerteIniziali = await getOfferteVetrina()
const logo = azienda?.logo_orizzontale_url || azienda?.logo_png_url || '/brand/hotellando-logo.jpg'
const nomeAzienda = azienda?.nome_commerciale || azienda?.ragione_sociale || 'Offerte speciali'
const datiIniziali = JSON.stringify(offerteIniziali).replace(/</g, '\\u003c')
---

<TvLayout titolo={`Vetrina offerte · ${nomeAzienda}`}>
  <div class="vetrina">
    <header class="vetrina__top">
      <img class="vetrina__logo" src={logo} alt={nomeAzienda} />
      <time class="vetrina__orologio" id="orologio"></time>
    </header>

    <div class="vetrina__palco" id="palco"></div>

    <ul class="vetrina__dots" id="dots" aria-hidden="true"></ul>
  </div>

  <script type="application/json" id="dati-vetrina" set:html={datiIniziali} />

  <script>
    import { formattaPrezzo, formattaPeriodo, ETICHETTA_FORMULA, nomeRegioneNormalizzato } from '../../lib/formato'

    const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string
    const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string
    // Ogni offerta resta in vetrina il tempo di mostrare tutte le sue foto
    // (galleria offerta_immagini) a questo ritmo, non un tempo fisso uguale
    // per tutte: un'offerta con 3 foto resta piu' a lungo di una con 1 sola.
    const DURATA_PER_FOTO_MS = 5000
    const DURATA_MINIMA_MS = 6000
    const INTERVALLO_REFETCH_MS = 5 * 60 * 1000

    interface OffertaVetrina {
      id: string
      immagini: string[]
      prezzoDa: number | null
      checkIn: string | null
      checkOut: string | null
      notti: number | null
      trattamento: string | null
      strutturaNome: string
      localita: string | null
      regione: string | null
      formula: string | null
      stelle: number | null
    }

    const palco = document.getElementById('palco') as HTMLElement
    const dotsEl = document.getElementById('dots') as HTMLElement
    const orologioEl = document.getElementById('orologio') as HTMLElement
    const datiEl = document.getElementById('dati-vetrina') as HTMLScriptElement

    let offerte: OffertaVetrina[] = JSON.parse(datiEl.textContent || '[]')
    let indice = 0
    let timerAvanzamento: ReturnType<typeof setTimeout> | null = null
    let timerSottoFoto: ReturnType<typeof setInterval> | null = null

    function stelleTesto(n: number | null): string {
      return n && n > 0 ? '★'.repeat(n) : ''
    }

    // Ritorna l'elemento della slide e la sua durata totale (dipende da
    // quante foto ha questa offerta), cosi' chi chiama sa quando avanzare.
    function creaSlide(offerta: OffertaVetrina): { elemento: HTMLElement; durata: number } {
      const div = document.createElement('div')
      div.className = 'slide'

      const immagini = offerta.immagini.length > 0 ? offerta.immagini : [null]
      const durata = Math.max(immagini.length * DURATA_PER_FOTO_MS, DURATA_MINIMA_MS)

      const fotoWrap = document.createElement('div')
      fotoWrap.className = 'slide__foto-wrap'
      fotoWrap.style.animationDuration = `${durata}ms`
      const strati = immagini.map((url, i) => {
        const strato = document.createElement('div')
        strato.className = 'slide__foto' + (i === 0 ? ' slide__foto--visibile' : '') + (url ? '' : ' slide__foto--vuota')
        if (url) strato.style.backgroundImage = `url('${url}')`
        fotoWrap.appendChild(strato)
        return strato
      })
      div.appendChild(fotoWrap)

      if (strati.length > 1) {
        let sotto = 0
        timerSottoFoto = setInterval(() => {
          strati[sotto].classList.remove('slide__foto--visibile')
          sotto = (sotto + 1) % strati.length
          strati[sotto].classList.add('slide__foto--visibile')
        }, DURATA_PER_FOTO_MS)
      }

      const velo = document.createElement('div')
      velo.className = 'slide__velo'
      div.appendChild(velo)

      const contenuto = document.createElement('div')
      contenuto.className = 'slide__contenuto'

      const periodo = offerta.checkIn && offerta.checkOut ? formattaPeriodo(offerta.checkIn, offerta.checkOut) : null
      const formula = offerta.trattamento || (offerta.formula ? ETICHETTA_FORMULA[offerta.formula] : null)
      const luogo = [offerta.localita, offerta.regione].filter(Boolean).join(' · ')

      contenuto.innerHTML = `
        <p class="slide__eyebrow">Offerta speciale</p>
        <h1 class="slide__titolo">${offerta.strutturaNome}</h1>
        ${luogo || offerta.stelle ? `<p class="slide__luogo">${luogo}${offerta.stelle ? ` <span class="slide__stelle">${stelleTesto(offerta.stelle)}</span>` : ''}</p>` : ''}
        ${periodo || offerta.notti || formula ? `
          <div class="slide__dettagli">
            ${periodo ? `<span>${periodo}</span>` : ''}
            ${offerta.notti ? `<span>${offerta.notti} notti</span>` : ''}
            ${formula ? `<span>${formula}</span>` : ''}
          </div>` : ''}
        ${offerta.prezzoDa ? `<p class="slide__prezzo">da <strong>${formattaPrezzo(offerta.prezzoDa)}</strong> a persona</p>` : ''}
      `
      div.appendChild(contenuto)

      const barra = document.createElement('div')
      barra.className = 'slide__barra'
      barra.style.animationDuration = `${durata}ms`
      div.appendChild(barra)

      return { elemento: div, durata }
    }

    function aggiornaDots() {
      dotsEl.innerHTML = ''
      offerte.forEach((_, i) => {
        const dot = document.createElement('li')
        dot.className = i === indice ? 'vetrina__dot vetrina__dot--attivo' : 'vetrina__dot'
        dotsEl.appendChild(dot)
      })
    }

    function pulisciTimer() {
      if (timerAvanzamento) clearTimeout(timerAvanzamento)
      if (timerSottoFoto) clearInterval(timerSottoFoto)
      timerAvanzamento = null
      timerSottoFoto = null
    }

    function mostraSlideCorrente() {
      pulisciTimer()
      palco.innerHTML = ''
      if (offerte.length === 0) {
        const vuoto = document.createElement('div')
        vuoto.className = 'vetrina__vuoto'
        vuoto.innerHTML = '<p>Nessuna offerta in vetrina al momento.</p>'
        palco.appendChild(vuoto)
        dotsEl.innerHTML = ''
        return
      }
      if (indice >= offerte.length) indice = 0
      const { elemento, durata } = creaSlide(offerte[indice])
      palco.appendChild(elemento)
      aggiornaDots()
      if (offerte.length > 1) timerAvanzamento = setTimeout(avanza, durata)
    }

    function avanza() {
      if (offerte.length === 0) return
      indice = (indice + 1) % offerte.length
      mostraSlideCorrente()
    }

    async function ricarica() {
      try {
        const url =
          `${SUPABASE_URL}/rest/v1/offerte?select=id,immagine_url,prezzo_da,` +
          `dettaglio_offerta_struttura!inner(check_in,check_out,notti,trattamento,` +
          `strutture(nome,localita,regione,formula,stelle)),` +
          `offerta_immagini(url,ordine)` +
          `&vetrina=eq.true&attiva=eq.true&order=created_at.desc`
        const risposta = await fetch(url, {
          headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` },
        })
        if (!risposta.ok) return
        const righe = await risposta.json()
        const nuove: OffertaVetrina[] = righe
          .map((r: any) => {
            const dettaglio = r.dettaglio_offerta_struttura
            const struttura = dettaglio?.strutture
            if (!dettaglio || !struttura) return null
            const galleria = [...(r.offerta_immagini ?? [])]
              .sort((a, b) => (a.ordine ?? 0) - (b.ordine ?? 0))
              .map((img: { url: string }) => img.url)
            return {
              id: r.id,
              immagini: galleria.length > 0 ? galleria : r.immagine_url ? [r.immagine_url] : [],
              prezzoDa: r.prezzo_da,
              checkIn: dettaglio.check_in,
              checkOut: dettaglio.check_out,
              notti: dettaglio.notti,
              trattamento: dettaglio.trattamento,
              strutturaNome: struttura.nome,
              localita: struttura.localita,
              regione: struttura.regione ? nomeRegioneNormalizzato(struttura.regione) : null,
              formula: struttura.formula,
              stelle: struttura.stelle,
            }
          })
          .filter((o: OffertaVetrina | null): o is OffertaVetrina => o !== null)

        if (JSON.stringify(nuove) !== JSON.stringify(offerte)) {
          offerte = nuove
          indice = 0
          mostraSlideCorrente()
        }
      } catch {
        // rete assente o momentaneamente irraggiungibile: la vetrina resta
        // com'e' e riprova al giro successivo, senza rompere lo schermo
      }
    }

    function aggiornaOrologio() {
      orologioEl.textContent = new Date().toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' })
    }

    mostraSlideCorrente()
    aggiornaOrologio()
    setInterval(aggiornaOrologio, 15000)
    setInterval(ricarica, INTERVALLO_REFETCH_MS)
  </script>

  <style is:global>
    .vetrina {
      position: relative;
      width: 100vw;
      height: 100vh;
      color: #fdfdfb;
      font-family: var(--font-testo);
    }

    .vetrina__top {
      position: absolute;
      inset: 0 0 auto 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 2.4vh 3vw;
    }

    .vetrina__logo {
      height: 11vh;
      max-width: 30vw;
      object-fit: contain;
      filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.55));
    }

    .vetrina__orologio {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 2.4vh;
      letter-spacing: 0.04em;
      color: #fdfdfb;
      background: rgba(11, 12, 15, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 999px;
      padding: 0.6vh 1.6vw;
    }

    .vetrina__palco {
      position: relative;
      width: 100%;
      height: 100%;
    }

    .slide {
      position: absolute;
      inset: 0;
      animation: dissolvenza 0.9s ease;
    }

    @keyframes dissolvenza {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    .slide__foto-wrap {
      position: absolute;
      inset: 0;
      overflow: hidden;
      animation-name: zoom-lento;
      animation-timing-function: ease-out;
      animation-fill-mode: forwards;
    }

    .slide__foto {
      position: absolute;
      inset: 0;
      background-color: #14161b;
      background-size: cover;
      background-position: center;
      opacity: 0;
      transition: opacity 1s ease;
    }

    .slide__foto--visibile {
      opacity: 1;
    }

    .slide__foto--vuota {
      background: linear-gradient(135deg, var(--colore-primario), var(--colore-primario-scuro, #1c4a6e));
    }

    @keyframes zoom-lento {
      from {
        transform: scale(1);
      }
      to {
        transform: scale(1.08);
      }
    }

    .slide__velo {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(6, 7, 9, 0.15) 0%, rgba(6, 7, 9, 0.35) 45%, rgba(6, 7, 9, 0.92) 100%);
    }

    .slide__contenuto {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 6vh;
      padding: 0 4vw;
      max-width: 62vw;
    }

    .slide__eyebrow {
      margin: 0 0 1vh;
      font-family: var(--font-display);
      font-size: 2vh;
      font-weight: 600;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--accento);
    }

    .slide__titolo {
      margin: 0 0 1vh;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 6.4vh;
      line-height: 1.05;
      text-wrap: balance;
    }

    .slide__luogo {
      margin: 0 0 2vh;
      font-size: 2.6vh;
      color: #e7e7e2;
    }

    .slide__stelle {
      color: #f5c451;
      letter-spacing: 0.1em;
    }

    .slide__dettagli {
      display: flex;
      flex-wrap: wrap;
      gap: 1.2vh 1.6vw;
      margin-bottom: 2.4vh;
    }

    .slide__dettagli span {
      font-size: 2.2vh;
      padding: 0.7vh 1.4vw;
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
    }

    .slide__prezzo {
      margin: 0;
      font-size: 2.4vh;
      color: #f0f0ec;
    }

    .slide__prezzo strong {
      font-family: var(--font-display);
      font-size: 5vh;
      font-weight: 700;
      color: var(--accento);
      margin-left: 0.4vw;
    }

    .slide__barra {
      position: absolute;
      left: 0;
      bottom: 0;
      height: 6px;
      width: 100%;
      background: var(--accento);
      transform-origin: left;
      animation-name: avanzamento;
      animation-timing-function: linear;
      animation-fill-mode: forwards;
      opacity: 0.85;
    }

    @keyframes avanzamento {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }

    .vetrina__vuoto {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 50% 40%, #1a1d23, #0b0c0f 70%);
    }

    .vetrina__vuoto p {
      font-family: var(--font-display);
      font-size: 3vh;
      color: #9a9ca3;
      letter-spacing: 0.02em;
    }

    .vetrina__dots {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 2vh;
      z-index: 10;
      display: flex;
      justify-content: center;
      gap: 0.9vh;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .vetrina__dot {
      width: 1vh;
      height: 1vh;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.35);
      transition: background 0.3s ease, transform 0.3s ease;
    }

    .vetrina__dot--attivo {
      background: var(--accento);
      transform: scale(1.35);
    }
  </style>
</TvLayout>
