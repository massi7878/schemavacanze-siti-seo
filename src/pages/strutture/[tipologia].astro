---
import BaseLayout from '../../layouts/BaseLayout.astro'
import GrigliaStrutture from '../../components/GrigliaStrutture.astro'
import FiltroSezioni from '../../components/FiltroSezioni.astro'
import CopertinaSezione from '../../components/CopertinaSezione.astro'
import FiltriElenco from '../../components/FiltriElenco.astro'
import { getSlideshow, getTipologieStruttura, getStruttureTipologia, getDestinazioniPerCategoria } from '../../lib/queries'
import DatiStrutturati from '../../components/DatiStrutturati.astro'
import { grafoBriciole, grafoElenco } from '../../lib/seo'

export async function getStaticPaths() {
  const tipologie = await getTipologieStruttura()
  return tipologie.map(t => ({ params: { tipologia: t.slug } }))
}

const { tipologia: tipologiaSlug } = Astro.params
const { tipologia, strutture } = await getStruttureTipologia(tipologiaSlug as string)
if (!tipologia) return Astro.redirect('/404')

const categorie = await getDestinazioniPerCategoria()
const slide = await getSlideshow('strutture')

const urlCanonica = new URL(`/strutture/${tipologia.slug}/`, Astro.site).toString()
const titolo = `${tipologia.nome} | Hotellando`
const descrizione = `${strutture.length} strutture selezionate nella categoria ${tipologia.nome}, con schede su camere, formula e prezzi.`
---

<BaseLayout titolo={titolo} descrizione={descrizione} urlCanonica={urlCanonica}>
  <DatiStrutturati
    nodi={[
      grafoBriciole([{ nome: 'Home', href: '/' }, { nome: 'Strutture', href: '/strutture/' }, { nome: tipologia.nome, href: `/strutture/${tipologia.slug}/` }], Astro.site),
      grafoElenco(tipologia.nome, urlCanonica, strutture.slice(0, 24).map(s => ({ nome: s.nome, url: new URL(`/struttura/${s.slug}/`, Astro.site).toString(), immagine: s.copertina }))),
    ]}
  />
  <CopertinaSezione slide={slide} titolo={tipologia.nome} sottotitolo={`${strutture.length} strutture selezionate in questa categoria.`} compatta>
    <nav slot="alto" class="briciole" aria-label="Percorso">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/strutture/">Strutture</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{tipologia.nome}</span>
    </nav>
    <div slot="sezioni">
      <FiltroSezioni categorie={categorie} />
    </div>
  </CopertinaSezione>

  <main class="contenitore pagina-elenco" class:list={{ 'pagina-elenco--con-filtro': strutture.length > 0 }}>
    {strutture.length > 0 && (
      <aside class="filtro-laterale" aria-label="Filtra">
        <FiltriElenco colonna />
      </aside>
    )}
    <div class="pagina-elenco__risultati">
      <GrigliaStrutture strutture={strutture} />
    </div>
  </main>
</BaseLayout>

<style>
  .apertura {
    padding: 2rem 0 2.5rem;
  }

  .briciole {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--testo-tenue);
    margin-bottom: 1.25rem;
  }

  .briciole a {
    color: var(--testo-tenue);
    text-decoration: none;
  }

  .briciole a:hover {
    color: var(--colore-primario-scuro);
  }

  .apertura__interno h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .apertura__interno p {
    color: var(--testo);
    margin: 0 0 1.5rem;
  }

  .pagina-elenco {
    padding-block: 2rem 4rem;
  }

  .pagina-elenco--con-filtro {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .filtro-laterale {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    padding: 1.25rem;
  }

  .pagina-elenco__risultati {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .pagina-elenco--con-filtro {
      flex-direction: row;
      align-items: flex-start;
      gap: 2.5rem;
    }

    .pagina-elenco--con-filtro > .filtro-laterale {
      flex: 0 0 15rem;
      position: sticky;
      top: 1.5rem;
    }

    .pagina-elenco__risultati {
      flex: 1;
    }
  }
</style>
