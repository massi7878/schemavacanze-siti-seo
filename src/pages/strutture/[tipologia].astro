---
import BaseLayout from '../../layouts/BaseLayout.astro'
import GrigliaStrutture from '../../components/GrigliaStrutture.astro'
import FiltroSezioni from '../../components/FiltroSezioni.astro'
import FiltroStelle from '../../components/FiltroStelle.astro'
import { getTipologieStruttura, getStruttureTipologia, getDestinazioniPerCategoria } from '../../lib/queries'

export async function getStaticPaths() {
  const tipologie = await getTipologieStruttura()
  return tipologie.map(t => ({ params: { tipologia: t.slug } }))
}

const { tipologia: tipologiaSlug } = Astro.params
const { tipologia, strutture } = await getStruttureTipologia(tipologiaSlug as string)
if (!tipologia) return Astro.redirect('/404')

const categorie = await getDestinazioniPerCategoria()

const urlCanonica = new URL(`/strutture/${tipologia.slug}/`, Astro.site).toString()
const titolo = `${tipologia.nome} | Hotellando`
const descrizione = `${strutture.length} strutture selezionate nella categoria ${tipologia.nome}, con schede su camere, formula e prezzi.`
---

<BaseLayout titolo={titolo} descrizione={descrizione} urlCanonica={urlCanonica}>
  <section class="apertura">
    <div class="contenitore apertura__interno">
      <nav class="briciole" aria-label="Percorso">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{tipologia.nome}</span>
      </nav>
      <h1>{tipologia.nome}</h1>
      <p>{strutture.length} strutture selezionate in questa categoria.</p>
      <FiltroSezioni categorie={categorie} />
    </div>
  </section>

  <main class="contenitore pagina-elenco" class:list={{ 'pagina-elenco--con-filtro': strutture.length > 0 }}>
    {strutture.length > 0 && (
      <aside class="filtro-laterale" aria-label="Filtra">
        <FiltroStelle />
      </aside>
    )}
    <div class="pagina-elenco__risultati">
      <GrigliaStrutture strutture={strutture} />
    </div>
  </main>
</BaseLayout>

<style>
  .apertura {
    padding: 2rem 0 2.5rem;
  }

  .briciole {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--testo-tenue);
    margin-bottom: 1.25rem;
  }

  .briciole a {
    color: var(--testo-tenue);
    text-decoration: none;
  }

  .briciole a:hover {
    color: var(--colore-primario-scuro);
  }

  .apertura__interno h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .apertura__interno p {
    color: var(--testo);
    margin: 0 0 1.5rem;
  }

  .pagina-elenco {
    padding: 1rem 0 4rem;
  }

  .pagina-elenco--con-filtro {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .filtro-laterale {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    padding: 1.25rem;
  }

  .pagina-elenco__risultati {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .pagina-elenco--con-filtro {
      flex-direction: row;
      align-items: flex-start;
      gap: 2.5rem;
    }

    .pagina-elenco--con-filtro > .filtro-laterale {
      flex: 0 0 15rem;
      position: sticky;
      top: 1.5rem;
    }

    .pagina-elenco__risultati {
      flex: 1;
    }
  }
</style>
