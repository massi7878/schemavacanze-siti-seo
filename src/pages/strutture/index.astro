---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CopertinaSezione from '../../components/CopertinaSezione.astro'
import FiltriElenco from '../../components/FiltriElenco.astro'
import GrigliaStrutture from '../../components/GrigliaStrutture.astro'
import { getSlideshow, getStruttureConFiltri, getTipologieStruttura, getDestinazioniPerCategoria } from '../../lib/queries'

// Tutte le strutture: copertina con i filtri al centro in basso. Sezione, tipologia, stelle e testo filtrano sul posto,
// a cascata: le strutture scelte compaiono subito sotto, senza cambiare pagina.
const [strutture, tipologie, categorie, slide] = await Promise.all([
  getStruttureConFiltri(),
  getTipologieStruttura(),
  getDestinazioniPerCategoria(),
  getSlideshow('strutture'),
])

const urlCanonica = new URL('/strutture/', Astro.site).toString()
const titolo = 'Strutture selezionate: hotel, villaggi e resort | Hotellando'
const descrizione = `${strutture.length} strutture selezionate da Hotellando, con schede su spiaggia, camere, formula e prezzi.`
---

<BaseLayout titolo={titolo} descrizione={descrizione} urlCanonica={urlCanonica}>
  <CopertinaSezione slide={slide} titolo="Strutture" sottotitolo={`${strutture.length} strutture selezionate, con schede su camere, formula e prezzi.`}>
    <nav slot="alto" class="briciole" aria-label="Percorso">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Strutture</span>
    </nav>
    <FiltriElenco collegamento={{ href: '/destinazioni/', testo: 'Vedi tutte le destinazioni' }}>
      {categorie.length > 0 && (
        <label class="filtri-elenco__campo">
          <span>Sezione</span>
          <select name="sezione" data-filtra="sezione">
            <option value="">Tutte</option>
            {categorie.map(c => <option value={c.slug}>{c.nome}</option>)}
          </select>
        </label>
      )}
      {tipologie.length > 0 && (
        <label class="filtri-elenco__campo">
          <span>Tipologia</span>
          <select name="tipologia" data-filtra="tipologia">
            <option value="">Tutte</option>
            {tipologie.map(t => <option value={t.slug}>{t.nome}</option>)}
          </select>
        </label>
      )}
    </FiltriElenco>
  </CopertinaSezione>

  <main class="contenitore pagina-elenco-semplice">
    <GrigliaStrutture strutture={strutture} />
  </main>
</BaseLayout>


<style>
  .pagina-elenco-semplice {
    padding-block: 2rem 4rem;
  }
</style>
