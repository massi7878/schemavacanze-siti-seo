---
import BaseLayout from '../../layouts/BaseLayout.astro'
import GrigliaStrutture from '../../components/GrigliaStrutture.astro'
import FiltroDestinazioni from '../../components/FiltroDestinazioni.astro'
import { getGerarchiaRegioniDestinazioni, getSlugDestinazioni, getStruttureDestinazione } from '../../lib/queries'

export async function getStaticPaths() {
  const slug = await getSlugDestinazioni()
  return slug.map(s => ({ params: { slug: s } }))
}

const { slug } = Astro.params
const { destinazione, strutture } = await getStruttureDestinazione(slug as string)
if (!destinazione) return Astro.redirect('/404')

// Il filtro laterale (regione -> destinazione) esiste solo per "Mare
// Italia", l'unica categoria con questa gerarchia a due livelli.
const regioni = destinazione.categoria_nome === 'Mare Italia' ? await getGerarchiaRegioniDestinazioni() : []
const regioneSlugAttuale = destinazione.parent_id
  ? regioni.find(r => r.figlie.some(f => f.slug === destinazione.slug))?.slug ?? destinazione.slug
  : destinazione.slug
const destinazioneSlugAttuale = destinazione.parent_id ? destinazione.slug : null

const urlCanonica = new URL(`/destinazioni/${destinazione.slug}/`, Astro.site).toString()
const titolo = `Villaggi a ${destinazione.nome} | Hotellando`
const descrizione = strutture.length > 0
  ? `${strutture.length} strutture selezionate per ${destinazione.nome}: villaggi e resort con schede su spiaggia, camere, formula e prezzi.`
  : `Le strutture selezionate da Hotellando per ${destinazione.nome} sono in arrivo.`
---

<BaseLayout titolo={titolo} descrizione={descrizione} urlCanonica={urlCanonica}>
  <section class="apertura">
    <div class="contenitore apertura__interno">
      <nav class="briciole" aria-label="Percorso">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{destinazione.nome}</span>
      </nav>
      <h1>Villaggi a {destinazione.nome}</h1>
      {strutture.length > 0 && <p>{strutture.length} strutture selezionate, con schede su spiaggia, camere, formula e prezzi.</p>}
    </div>
  </section>

  <main class="contenitore pagina-elenco" class:list={{ 'pagina-elenco--con-filtro': regioni.length > 0 }}>
    {regioni.length > 0 && (
      <FiltroDestinazioni regioni={regioni} regioneSlugAttuale={regioneSlugAttuale} destinazioneSlugAttuale={destinazioneSlugAttuale} />
    )}
    <div class="pagina-elenco__risultati">
      {strutture.length > 0
        ? <GrigliaStrutture strutture={strutture} />
        : <p class="vuoto">Non ci sono ancora strutture pubblicate per questa destinazione. <a href="/">Vedi tutti i villaggi</a>.</p>}
    </div>
  </main>
</BaseLayout>

<style>
  .apertura {
    padding: 2rem 0 2.5rem;
  }

  .briciole {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--testo-tenue);
    margin-bottom: 1.25rem;
  }

  .briciole a {
    color: var(--testo-tenue);
    text-decoration: none;
  }

  .briciole a:hover {
    color: var(--colore-primario-scuro);
  }

  .apertura__interno h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .apertura__interno p {
    color: var(--testo);
    margin: 0;
  }

  .pagina-elenco {
    padding: 1rem 0 4rem;
  }

  .pagina-elenco--con-filtro {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .pagina-elenco__risultati {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .pagina-elenco--con-filtro {
      flex-direction: row;
      align-items: flex-start;
      gap: 2.5rem;
    }

    .pagina-elenco--con-filtro > :global(.filtro-destinazioni) {
      flex: 0 0 15rem;
      position: sticky;
      top: 1.5rem;
    }

    .pagina-elenco__risultati {
      flex: 1;
    }
  }

  .vuoto {
    color: var(--testo-tenue);
  }

  .vuoto a {
    color: var(--colore-primario-scuro);
  }
</style>
