---
import BaseLayout from '../../layouts/BaseLayout.astro'
import CopertinaSezione from '../../components/CopertinaSezione.astro'
import GrigliaStrutture from '../../components/GrigliaStrutture.astro'
import { getSlideshow, getDestinazioniPerCategoria, getCopertineDestinazioni, getStruttureConFiltri } from '../../lib/queries'
import DatiStrutturati from '../../components/DatiStrutturati.astro'
import { grafoBriciole, grafoElenco } from '../../lib/seo'

// Tutte le destinazioni, per sezione (Mare Italia, Estero...): copertina con i filtri al centro in basso.
// Scegliendo una destinazione si passa alla sua pagina, dove i filtri stanno nella colonna a sinistra.
const [categorie, slide, dettagli, strutture] = await Promise.all([getDestinazioniPerCategoria(), getSlideshow('destinazioni'), getCopertineDestinazioni(), getStruttureConFiltri()])
const totale = categorie.reduce((n, c) => n + c.destinazioni.length, 0)

const urlCanonica = new URL('/destinazioni/', Astro.site).toString()
const titolo = 'Destinazioni: mare Italia, estero, montagna e crociere | Hotellando'
const descrizione = `${totale} destinazioni con strutture selezionate da Hotellando: scegli la meta e confronta villaggi, hotel e resort.`
---

<BaseLayout titolo={titolo} descrizione={descrizione} urlCanonica={urlCanonica}>
  <DatiStrutturati
    nodi={[
      grafoBriciole([{ nome: 'Home', href: '/' }, { nome: 'Destinazioni', href: '/destinazioni/' }], Astro.site),
      grafoElenco('Destinazioni', urlCanonica, categorie.flatMap(c => c.destinazioni.map(d => ({ nome: d.nome.trim(), url: new URL(`/destinazioni/${d.slug}/`, Astro.site).toString() }))).slice(0, 60)),
    ]}
  />
  <CopertinaSezione slide={slide} titolo="Destinazioni" sottotitolo={`${totale} mete con strutture selezionate: scegli dove andare.`}>
    <nav slot="alto" class="briciole" aria-label="Percorso">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Destinazioni</span>
    </nav>
    <form class="filtri-dest" data-filtri-dest role="search" aria-label="Cerca tra le destinazioni">
      <label class="filtri-dest__campo">
        <span>Sezione</span>
        <select name="sezione">
          <option value="">Tutte</option>
          {categorie.map(c => <option value={c.slug}>{c.nome}</option>)}
        </select>
      </label>
      <label class="filtri-dest__campo">
        <span>Regione o destinazione</span>
        <select name="regione" data-regioni={JSON.stringify(categorie.flatMap(c => c.destinazioni.map(d => ({ slug: d.slug, nome: d.nome.trim(), sezione: c.slug }))))}>
          <option value="">Tutte</option>
          {categorie.flatMap(c => c.destinazioni.map(d => <option value={d.slug}>{d.nome.trim()}</option>))}
        </select>
      </label>
      <label class="filtri-dest__campo filtri-dest__ricerca">
        <span>Cerca per testo</span>
        <span class="filtri-dest__riga">
          <input type="search" name="testo" placeholder="Nome della destinazione..." autocomplete="off" />
          <button type="submit" class="filtri-dest__cerca">Cerca</button>
        </span>
      </label>
      <div class="riga-azioni">
        <button type="reset">Azzera i filtri</button>
        <span class="esito" data-esito-dest role="status" aria-live="polite"></span>
        <a href="/strutture/">Vedi tutte le strutture</a>
      </div>
    </form>
  </CopertinaSezione>

  <main class="contenitore pagina-destinazioni">
    {categorie.map(c => (
      <section class="gruppo" data-gruppo={c.slug}>
        <h2><a href={`/categoria/${c.slug}/`}>{c.nome}</a></h2>
        <ul class="gruppo__elenco">
          {c.destinazioni.map(d => {
            const info = dettagli.get(d.id)
            return (
              <li data-testo={d.nome} data-slug={d.slug}>
                <a class="card-dest" href={`/destinazioni/${d.slug}/`}>
                  <div class="card-dest__immagine">
                    {info?.copertina
                      ? <img src={info.copertina} alt={d.nome.trim()} loading="lazy" />
                      : <span class="card-dest__segnaposto" aria-hidden="true">{d.nome.trim().charAt(0)}</span>}
                    <div class="card-dest__sopra">
                      <span class="card-dest__sezione">{c.nome}</span>
                      <span class="card-dest__titolo">{d.nome.trim()}</span>
                    </div>
                  </div>
                  <div class="card-dest__corpo">
                    <span>{info?.strutture ?? 0} {(info?.strutture ?? 0) === 1 ? 'struttura' : 'strutture'}</span>
                    <span class="card-dest__vai">Scopri →</span>
                  </div>
                </a>
              </li>
            )
          })}
        </ul>
      </section>
    ))}
    <p class="vuoto" data-dest-vuoto hidden>Nessuna destinazione corrisponde ai filtri scelti.</p>

    <section class="strutture-scelte" data-box-strutture hidden>
      <h2 data-titolo-strutture>Strutture</h2>
      <GrigliaStrutture strutture={strutture} />
    </section>
  </main>
</BaseLayout>

<script>
  const modulo = document.querySelector<HTMLFormElement>('[data-filtri-dest]')
  const gruppi = [...document.querySelectorAll<HTMLElement>('[data-gruppo]')]
  const vuoto = document.querySelector<HTMLElement>('[data-dest-vuoto]')
  const esito = document.querySelector<HTMLElement>('[data-esito-dest]')
  const normalizza = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')

  const boxStrutture = document.querySelector<HTMLElement>('[data-box-strutture]')
  const titoloStrutture = document.querySelector<HTMLElement>('[data-titolo-strutture]')
  const righeStrutture = [...document.querySelectorAll<HTMLLIElement>('[data-box-strutture] [data-griglia-strutture] > li')]
  const vuotoStrutture = document.querySelector<HTMLElement>('[data-box-strutture] [data-griglia-vuoto]')

  function applica() {
    if (!modulo) return
    const testo = normalizza(String((modulo.elements.namedItem('testo') as HTMLInputElement).value)).trim()
    const selSezione = modulo.elements.namedItem('sezione') as HTMLSelectElement
    const selRegione = modulo.elements.namedItem('regione') as HTMLSelectElement
    const sezione = String(selSezione.value)
    const regione = String(selRegione.value)
    const sceltaFatta = Boolean(sezione || regione || testo)

    // 1) con una scelta: subito sotto le strutture (della destinazione, della sezione o che contengono il testo)
    let nStrutture = 0
    for (const riga of righeStrutture) {
      const ok =
        (!sezione || riga.dataset.sezione === sezione) &&
        (!regione || (riga.dataset.dest ?? '').split(' ').includes(regione)) &&
        (!testo || normalizza(riga.dataset.testo ?? '').includes(testo))
      riga.hidden = !ok
      if (ok) nStrutture++
    }
    if (boxStrutture) boxStrutture.hidden = !sceltaFatta
    if (vuotoStrutture) vuotoStrutture.hidden = nStrutture > 0
    if (titoloStrutture) {
      const nomeRegione = regione ? (selRegione.selectedOptions[0]?.textContent ?? '').trim() : ''
      const nomeSezione = sezione ? (selSezione.selectedOptions[0]?.textContent ?? '').trim() : ''
      const dove = nomeRegione || nomeSezione
      titoloStrutture.textContent = `${nStrutture} ${nStrutture === 1 ? 'struttura' : 'strutture'}${dove ? ` · ${dove}` : ''}`
    }

    // 2) senza scelte: le schede delle destinazioni
    let totale = 0
    for (const gruppo of gruppi) {
      let visibili = 0
      gruppo.querySelectorAll<HTMLLIElement>('li').forEach(li => {
        const ok = !sceltaFatta
        li.hidden = !ok
        if (ok) visibili++
      })
      gruppo.hidden = visibili === 0
      totale += visibili
    }
    if (vuoto) vuoto.hidden = true
    if (esito) esito.textContent = sceltaFatta ? `${nStrutture} ${nStrutture === 1 ? 'struttura trovata' : 'strutture trovate'}` : ''
    void totale
  }

  // la scelta della regione segue la sezione: restano solo le regioni di quella sezione
  type Regione = { slug: string; nome: string; sezione: string }
  const selRegioneCampo = modulo?.elements.namedItem('regione') as HTMLSelectElement | null
  const regioni: Regione[] = JSON.parse(selRegioneCampo?.dataset.regioni ?? '[]')
  function aggiornaRegioni() {
    if (!modulo || !selRegioneCampo) return
    const sezione = String((modulo.elements.namedItem('sezione') as HTMLSelectElement).value)
    const scelta = selRegioneCampo.value
    selRegioneCampo.innerHTML = '<option value="">Tutte</option>'
    for (const r of regioni.filter(x => !sezione || x.sezione === sezione)) {
      const o = document.createElement('option')
      o.value = r.slug
      o.textContent = r.nome
      selRegioneCampo.appendChild(o)
    }
    selRegioneCampo.value = [...selRegioneCampo.options].some(o => o.value === scelta) ? scelta : ''
  }
  modulo?.addEventListener('change', e => {
    if ((e.target as HTMLElement).getAttribute('name') === 'sezione') aggiornaRegioni()
  })

  modulo?.addEventListener('submit', e => {
    e.preventDefault()
    applica()
    document.querySelector('.pagina-destinazioni')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  })
  modulo?.addEventListener('reset', () => setTimeout(() => { aggiornaRegioni(); applica() }, 0))
  modulo?.addEventListener('input', applica)
  modulo?.addEventListener('change', applica)
</script>

<style is:global>
  .filtri-dest {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: center;
    gap: 0.75rem 1rem;
  }

  .filtri-dest__campo {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--testo);
    min-width: 0;
  }

  .filtri-dest__ricerca {
    flex: 1 1 18rem;
    max-width: 28rem;
  }

  .filtri-dest__riga {
    display: flex;
    gap: 0.5rem;
  }

  .filtri-dest input[type='search'],
  .filtri-dest select {
    font: inherit;
    font-size: 0.92rem;
    padding: 0.55em 0.75em;
    border: 1px solid var(--bordo);
    border-radius: var(--raggio-piccolo);
    background: var(--superficie);
    color: var(--inchiostro);
    min-width: 0;
  }

  .filtri-dest input[type='search'] {
    flex: 1;
  }

  .filtri-dest__cerca {
    font: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    padding: 0.55em 1.3em;
    border: none;
    border-radius: var(--raggio-piccolo);
    background: var(--accento);
    color: #fff;
    cursor: pointer;
  }

  .filtri-dest__cerca:hover {
    background: var(--accento-scuro);
  }

  .filtri-dest__esito {
    flex-basis: 100%;
    text-align: center;
    margin: 0;
    font-size: 0.85rem;
    color: var(--testo-tenue);
  }

  .filtri-dest__esito:empty {
    display: none;
  }

  .copertina__pannello .filtri-dest {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 0.75rem;
    align-items: end;
  }

  .copertina__pannello .filtri-dest .filtri-dest__ricerca {
    grid-column: 1 / -1;
    max-width: none;
  }

  .copertina__pannello .filtri-dest .riga-azioni {
    grid-column: 1 / -1;
  }

  .copertina__pannello .filtri-dest .filtri-dest__esito {
    grid-column: 1 / -1;
  }

  .pagina-destinazioni {
    padding-block: 2rem 4rem;
  }

  .pagina-destinazioni .gruppo {
    margin-bottom: 2rem;
  }

  .pagina-destinazioni .gruppo h2 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }

  .pagina-destinazioni .gruppo h2 a {
    color: var(--inchiostro);
    text-decoration: none;
  }

  .pagina-destinazioni .gruppo h2 a:hover {
    color: var(--colore-primario-scuro);
  }

  .pagina-destinazioni .gruppo__elenco {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.5rem;
  }

  .pagina-destinazioni .card-dest {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    overflow: hidden;
    box-shadow: var(--ombra);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pagina-destinazioni .card-dest:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 8px rgba(52, 54, 58, 0.08), 0 16px 32px -16px rgba(52, 54, 58, 0.28);
  }

  .pagina-destinazioni .card-dest__immagine {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(135deg, var(--colore-primario-scuro), var(--colore-primario-scuro-hover));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pagina-destinazioni .card-dest__immagine img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pagina-destinazioni .card-dest__immagine::after {
    content: '';
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(to top, rgba(10, 18, 28, 0.82), rgba(10, 18, 28, 0));
    pointer-events: none;
  }

  .pagina-destinazioni .card-dest__segnaposto {
    font-family: var(--font-display);
    font-size: 3.5rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .pagina-destinazioni .card-dest__sopra {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0 1.1rem 0.9rem;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
  }

  .pagina-destinazioni .card-dest__sezione {
    font-size: 0.82rem;
    font-weight: 600;
    opacity: 0.95;
  }

  .pagina-destinazioni .card-dest__titolo {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.2;
    color: #fff;
  }

  .pagina-destinazioni .card-dest__corpo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem 1rem;
    font-size: 0.9rem;
    color: var(--testo-tenue);
  }

  .pagina-destinazioni .card-dest__vai {
    font-weight: 600;
    color: var(--colore-primario-scuro);
  }

  .pagina-destinazioni .vuoto {
    color: var(--testo-tenue);
  }
</style>
