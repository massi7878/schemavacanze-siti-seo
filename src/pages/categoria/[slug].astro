---
import BaseLayout from '../../layouts/BaseLayout.astro'
import GrigliaStrutture from '../../components/GrigliaStrutture.astro'
import FiltroSezioni from '../../components/FiltroSezioni.astro'
import FiltroStelle from '../../components/FiltroStelle.astro'
import SelettoreDestinazioneCategoria from '../../components/SelettoreDestinazioneCategoria.astro'
import { getSlugCategorie, getStruttureCategoria, getDestinazioniPerCategoria } from '../../lib/queries'

export async function getStaticPaths() {
  const slug = await getSlugCategorie()
  return slug.map(s => ({ params: { slug: s } }))
}

const { slug } = Astro.params
const { categoria, destinazioni, strutture } = await getStruttureCategoria(slug as string)
if (!categoria) return Astro.redirect('/404')

const categorie = await getDestinazioniPerCategoria()

const urlCanonica = new URL(`/categoria/${categoria.slug}/`, Astro.site).toString()
const titolo = `${categoria.nome} | Hotellando`
const descrizione = strutture.length > 0
  ? `${strutture.length} strutture selezionate per ${categoria.nome}: villaggi e resort con schede su spiaggia, camere, formula e prezzi.`
  : `Le strutture selezionate da Hotellando per ${categoria.nome} sono in arrivo.`
---

<BaseLayout titolo={titolo} descrizione={descrizione} urlCanonica={urlCanonica}>
  <section class="apertura">
    <div class="contenitore apertura__interno">
      <nav class="briciole" aria-label="Percorso">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{categoria.nome}</span>
      </nav>
      <h1>{categoria.nome}</h1>
      {strutture.length > 0 && <p>{strutture.length} strutture selezionate, con schede su spiaggia, camere, formula e prezzi.</p>}
      <FiltroSezioni categorie={categorie} categoriaSlugAttuale={categoria.slug} />
    </div>
  </section>

  <main class="contenitore pagina-elenco" class:list={{ 'pagina-elenco--con-filtro': strutture.length > 0 }}>
    {strutture.length > 0 && (
      <aside class="filtro-laterale" aria-label="Filtra">
        {destinazioni.length > 0 && <SelettoreDestinazioneCategoria destinazioni={destinazioni} />}
        <FiltroStelle />
      </aside>
    )}
    <div class="pagina-elenco__risultati">
      {strutture.length > 0
        ? <GrigliaStrutture strutture={strutture} />
        : <p class="vuoto">Non ci sono ancora strutture pubblicate per questa sezione. <a href="/">Vedi tutti i villaggi</a>.</p>}
    </div>
  </main>
</BaseLayout>

<style>
  .apertura {
    padding: 2rem 0 2.5rem;
  }

  .briciole {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--testo-tenue);
    margin-bottom: 1.25rem;
  }

  .briciole a {
    color: var(--testo-tenue);
    text-decoration: none;
  }

  .briciole a:hover {
    color: var(--colore-primario-scuro);
  }

  .apertura__interno h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .apertura__interno p {
    color: var(--testo);
    margin: 0 0 1.5rem;
  }

  .pagina-elenco {
    padding: 1rem 0 4rem;
  }

  .pagina-elenco--con-filtro {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .filtro-laterale {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: var(--superficie);
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    padding: 1.25rem;
  }

  .pagina-elenco__risultati {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .pagina-elenco--con-filtro {
      flex-direction: row;
      align-items: flex-start;
      gap: 2.5rem;
    }

    .pagina-elenco--con-filtro > .filtro-laterale {
      flex: 0 0 15rem;
      position: sticky;
      top: 1.5rem;
    }

    .pagina-elenco__risultati {
      flex: 1;
    }
  }

  .vuoto {
    color: var(--testo-tenue);
  }

  .vuoto a {
    color: var(--colore-primario-scuro);
  }
</style>
