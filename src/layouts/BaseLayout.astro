---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { getAzienda } from '../lib/queries'
import { scurisci } from '../lib/formato'
import { grafoAzienda } from '../lib/seo'

interface Props {
  titolo: string
  descrizione: string
  urlCanonica: string
  immagine?: string | null
}

const { titolo, descrizione, urlCanonica, immagine } = Astro.props

// I due colori dominanti del sito vengono da azienda.colore_primario/
// colore_secondario nel gestionale (stessa tabella, stessa fonte usata li'
// per applicaColoriAzienda): cambiandoli nel gestionale cambia qui, senza
// toccare il codice. Se assenti, restano i valori di default in global.css.
const azienda = await getAzienda()
const coloriPersonalizzati = azienda?.colore_primario || azienda?.colore_secondario
// identita' dell'azienda (agenzia di viaggi, telefono, indirizzo) e sito: in tutte le pagine
const grafoIdentita = { '@context': 'https://schema.org', '@graph': grafoAzienda(azienda, Astro.site) }
// immagine di anteprima per i social: quella della pagina, altrimenti il logo
const immagineSocial = immagine || new URL('/brand/hotellando-logo.jpg', Astro.site).toString()
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/brand/hotellando-logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Mulish:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={urlCanonica} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titolo} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={immagineSocial} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={azienda?.nome_commerciale || 'Hotellando'} />
    <meta name="twitter:card" content={immagine ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={titolo} />
    <meta name="twitter:description" content={descrizione} />
    <meta name="twitter:image" content={immagineSocial} />
    <script type="application/ld+json" set:html={JSON.stringify(grafoIdentita)} />
    {coloriPersonalizzati && (
      <style set:html={`:root:root {
        ${azienda?.colore_primario ? `
        --colore-primario: ${azienda.colore_primario};
        --colore-primario-scuro: ${scurisci(azienda.colore_primario, 12)};
        --colore-primario-scuro-hover: ${scurisci(azienda.colore_primario, 28)};` : ''}
        ${azienda?.colore_secondario ? `
        --accento: ${azienda.colore_secondario};
        --accento-scuro: ${scurisci(azienda.colore_secondario, 15)};
        --accento-scuro-hover: ${scurisci(azienda.colore_secondario, 30)};` : ''}
      }`} />
    )}
    <slot name="head-extra" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script>
      // regola primaria dei datari: la data di fine parte dalla data di inizio, non da oggi
      import { installaCollegamentoDatari } from '../scripts/collegaDatari'
      installaCollegamentoDatari()
    </script>
  </body>
</html>
